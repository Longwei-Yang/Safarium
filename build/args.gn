# Safarium release build: standalone (non-component) app for packaging.
target_cpu = "arm64"
is_debug = false
is_component_build = false
is_official_build = false
dcheck_always_on = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0

is_safarium_branded = true

# H.264/AAC (and platform HEVC) playback, like Chrome.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
