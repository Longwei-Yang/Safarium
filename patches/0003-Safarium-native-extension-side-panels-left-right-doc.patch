 void WebUIBrowserWindow::ShowSidePanel(SidePanelEntryKey side_panel_entry_key) {
+  if (safarium_root_) {
+    // Safarium: the side panel's contents go in the native window's own
+    // dock (left/right of the page) instead of the WebUI shell.
+    WebUIBrowserSidePanelUI* side_panel_ui = GetWebUIBrowserSidePanelUI();
+    content::WebContents* contents =
+        side_panel_ui
+            ? side_panel_ui->GetWebContentsForId(side_panel_entry_key.id())
+            : nullptr;
+    if (!contents) {
+      return;
+    }
+    contents->SetColorProviderSource(this);
+    std::u16string title;
+    gfx::ImageSkia icon;
+    if (std::optional<extensions::ExtensionId> extension_id =
+            side_panel_entry_key.extension_id()) {
+      if (const extensions::Extension* extension =
+              extensions::ExtensionRegistry::Get(browser_->GetProfile())
+                  ->enabled_extensions()
+                  .GetByID(*extension_id)) {
+        title = base::UTF8ToUTF16(extension->name());
+      }
+      icon = extensions_container_->GetNativeToolbarActionIcon(*extension_id);
+    }
+    if (title.empty()) {
+      title = contents->GetTitle();
+    }
+    safarium_root_->ShowSidePanel(
+        side_panel_ui->LendCurrentView(base::BindRepeating(
+            [](base::WeakPtr<safarium::SafariumRootView> root)
+                -> std::unique_ptr<views::View> {
+              return root ? root->TakeSidePanelContent() : nullptr;
+            },
+            safarium_root_->GetWeakPtr())),
+        title, icon);
+    return;
+  }
   if (GetWebUIBrowserUI()) {
     GetWebUIBrowserUI()->ShowSidePanel(side_panel_entry_key);
   }
 }
 
 void WebUIBrowserWindow::CloseSidePanel() {
+  if (safarium_root_) {
+    safarium_root_->HideSidePanel();
+    if (WebUIBrowserSidePanelUI* side_panel_ui = GetWebUIBrowserSidePanelUI()) {
+      side_panel_ui->OnSidePanelClosed();  // The WebUI shell's async ack.
+    }
+    return;
+  }
   if (GetWebUIBrowserUI()) {
     GetWebUIBrowserUI()->CloseSidePanel();
   }
