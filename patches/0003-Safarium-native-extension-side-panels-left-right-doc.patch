diff --git a/chrome/browser/ui/webui_browser/safarium_side_panel_header_mac.mm b/chrome/browser/ui/webui_browser/safarium_side_panel_header_mac.mm
new file mode 100644
index 0000000000..bec92bd3f1
--- /dev/null
+++ b/chrome/browser/ui/webui_browser/safarium_side_panel_header_mac.mm
@@ -0,0 +1,174 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Safarium: native header of the docked side panel (extension icon + name,
+// "move to the other side" and close buttons).
+
+#import <AppKit/AppKit.h>
+
+#include "base/strings/sys_string_conversions.h"
+#include "chrome/browser/ui/webui_browser/safarium_root_view.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/gfx/image/image_skia_util_mac.h"
+#include "ui/views/controls/native/native_view_host.h"
+
+@interface SafariumSidePanelHeader : NSView
+@property(nonatomic, copy) void (^onClose)(void);
+@property(nonatomic, copy) void (^onMove)(void);
+- (void)setTitle:(NSString*)title icon:(NSImage*)icon;
+- (void)setDockedRight:(BOOL)dockedRight;
+@end
+
+@implementation SafariumSidePanelHeader {
+  NSImageView* _icon;
+  NSTextField* _title;
+  NSButton* _move;
+  NSButton* _close;
+}
+
+@synthesize onClose = _onClose;
+@synthesize onMove = _onMove;
+
+static NSButton* HeaderButton(NSString* symbol,
+                              NSString* tip,
+                              id target,
+                              SEL action) {
+  NSImage* image = [NSImage imageWithSystemSymbolName:symbol
+                             accessibilityDescription:tip];
+  NSButton* button = [NSButton buttonWithImage:image
+                                        target:target
+                                        action:action];
+  button.bordered = NO;
+  button.imagePosition = NSImageOnly;
+  button.contentTintColor = NSColor.secondaryLabelColor;
+  button.toolTip = tip;
+  button.translatesAutoresizingMaskIntoConstraints = NO;
+  [button.widthAnchor constraintEqualToConstant:24].active = YES;
+  [button.heightAnchor constraintEqualToConstant:24].active = YES;
+  return button;
+}
+
+- (instancetype)initWithFrame:(NSRect)frame {
+  if ((self = [super initWithFrame:frame])) {
+    _icon = [NSImageView imageViewWithImage:[[NSImage alloc] init]];
+    _icon.imageScaling = NSImageScaleProportionallyUpOrDown;
+    _icon.translatesAutoresizingMaskIntoConstraints = NO;
+    [_icon.widthAnchor constraintEqualToConstant:16].active = YES;
+    [_icon.heightAnchor constraintEqualToConstant:16].active = YES;
+
+    _title = [NSTextField labelWithString:@""];
+    _title.font = [NSFont systemFontOfSize:NSFont.systemFontSize
+                                    weight:NSFontWeightSemibold];
+    _title.lineBreakMode = NSLineBreakByTruncatingTail;
+    [_title setContentCompressionResistancePriority:NSLayoutPriorityDefaultLow
+                                     forOrientation:
+                                         NSLayoutConstraintOrientationHorizontal];
+
+    _move = HeaderButton(@"sidebar.right", @"Move to Right", self,
+                         @selector(moveClicked:));
+    _close = HeaderButton(@"xmark", @"Close", self, @selector(closeClicked:));
+
+    NSStackView* stack =
+        [NSStackView stackViewWithViews:@[ _icon, _title, _move, _close ]];
+    stack.orientation = NSUserInterfaceLayoutOrientationHorizontal;
+    stack.alignment = NSLayoutAttributeCenterY;
+    stack.spacing = 6;
+    [stack setCustomSpacing:8 afterView:_icon];
+    [stack setHuggingPriority:NSLayoutPriorityDefaultLow
+               forOrientation:NSLayoutConstraintOrientationHorizontal];
+    stack.translatesAutoresizingMaskIntoConstraints = NO;
+    [self addSubview:stack];
+    [NSLayoutConstraint activateConstraints:@[
+      [stack.leadingAnchor constraintEqualToAnchor:self.leadingAnchor
+                                          constant:12],
+      [stack.trailingAnchor constraintEqualToAnchor:self.trailingAnchor
+                                           constant:-8],
+      [stack.centerYAnchor constraintEqualToAnchor:self.centerYAnchor],
+    ]];
+  }
+  return self;
+}
+
+// The header is part of the panel, not the window's drag area.
+- (BOOL)mouseDownCanMoveWindow {
+  return NO;
+}
+
+- (void)setTitle:(NSString*)title icon:(NSImage*)icon {
+  _title.stringValue = title ?: @"";
+  _icon.image = icon;
+  _icon.hidden = icon == nil;
+}
+
+- (void)setDockedRight:(BOOL)dockedRight {
+  // The button moves the panel to the other side.
+  NSString* symbol = dockedRight ? @"sidebar.left" : @"sidebar.right";
+  NSString* tip = dockedRight ? @"Move to Left" : @"Move to Right";
+  _move.image = [NSImage imageWithSystemSymbolName:symbol
+                          accessibilityDescription:tip];
+  _move.toolTip = tip;
+}
+
+- (void)moveClicked:(id)sender {
+  if (_onMove) {
+    _onMove();
+  }
+}
+
+- (void)closeClicked:(id)sender {
+  if (_onClose) {
+    _onClose();
+  }
+}
+@end
+
+namespace safarium {
+
+struct SidePanelHeaderView::ObjCStorage {
+  SafariumSidePanelHeader* __strong header;
+};
+
+SidePanelHeaderView::SidePanelHeaderView(base::RepeatingClosure on_close,
+                                         base::RepeatingClosure on_move)
+    : objc_(std::make_unique<ObjCStorage>()) {
+  objc_->header = [[SafariumSidePanelHeader alloc] initWithFrame:NSZeroRect];
+  objc_->header.onClose = ^{
+    on_close.Run();
+  };
+  objc_->header.onMove = ^{
+    on_move.Run();
+  };
+  host_ = AddChildView(std::make_unique<views::NativeViewHost>());
+}
+
+SidePanelHeaderView::~SidePanelHeaderView() {
+  objc_->header.onClose = nil;
+  objc_->header.onMove = nil;
+}
+
+void SidePanelHeaderView::SetContent(const std::u16string& title,
+                                     const gfx::ImageSkia& icon) {
+  [objc_->header setTitle:base::SysUTF16ToNSString(title)
+                     icon:icon.isNull() ? nil : gfx::NSImageFromImageSkia(icon)];
+}
+
+void SidePanelHeaderView::SetDockedRight(bool docked_right) {
+  [objc_->header setDockedRight:docked_right];
+}
+
+void SidePanelHeaderView::AddedToWidget() {
+  auto* host = static_cast<views::NativeViewHost*>(host_.get());
+  if (!host->native_view()) {
+    host->Attach(gfx::NativeView(objc_->header));
+  }
+}
