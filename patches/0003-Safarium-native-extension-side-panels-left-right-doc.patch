+bool SafariumRootView::SidePanelDockedRight() const {
+  return Profile::FromBrowserContext(browser_context_)
+      ->GetPrefs()
+      ->GetBoolean(prefs::kSidePanelHorizontalAlignment);
+}
+
+void SafariumRootView::OnDockPrefChanged() {
+  side_panel_header_->SetDockedRight(SidePanelDockedRight());
+  InvalidateLayout();
+}
+
+void SafariumRootView::ShowSidePanel(std::unique_ptr<views::View> content,
+                                     const std::u16string& title,
+                                     const gfx::ImageSkia& icon) {
+  if (side_panel_content_) {
+    // Not reclaimed (shouldn't happen): drop the stale view.
+    RemoveChildViewT(side_panel_content_.get());
+  }
+  if (content) {
+    // Webium gives never-attached side panel views a detached focus
+    // manager; a view in a widget must not have one (View CHECKs).
+    content->ClearProperty(views::kDetachedViewFocusManagerKey);
+  }
+  side_panel_content_ =
+      content ? AddChildView(std::move(content)) : nullptr;
+  side_panel_header_->SetContent(title, icon);
+  side_panel_header_->SetDockedRight(SidePanelDockedRight());
+  for (views::View* view :
+       {side_panel_separator_.get(), static_cast<views::View*>(
+                                         side_panel_header_.get()),
+        static_cast<views::View*>(side_panel_resize_.get())}) {
+    view->SetVisible(true);
+  }
+  InvalidateLayout();
+}
+
+void SafariumRootView::HideSidePanel() {
+  for (views::View* view :
+       {side_panel_separator_.get(), static_cast<views::View*>(
+                                         side_panel_header_.get()),
+        static_cast<views::View*>(side_panel_resize_.get())}) {
+    view->SetVisible(false);
+  }
+  if (side_panel_content_) {
+    side_panel_content_->SetVisible(false);
+  }
+  InvalidateLayout();
+}
+
+std::unique_ptr<views::View> SafariumRootView::TakeSidePanelContent() {
+  if (!side_panel_content_) {
+    return nullptr;
+  }
+  views::View* content = side_panel_content_.get();
+  side_panel_content_ = nullptr;
+  content->SetVisible(true);
+  views::FocusManager* focus_manager = GetFocusManager();
+  InvalidateLayout();
+  std::unique_ptr<views::View> view = RemoveChildViewT(content);
+  if (focus_manager) {
+    // Detached again (cached by the side panel): restore what Webium set.
+    view->SetProperty(views::kDetachedViewFocusManagerKey, focus_manager);
+  }
+  return view;
+}
+
+bool SafariumRootView::IsSidePanelShowing() const {
+  return side_panel_header_->GetVisible();
+}
+
+void SafariumRootView::SetSidePanelCloseCallback(
+    base::RepeatingClosure callback) {
+  side_panel_close_callback_ = std::move(callback);
+}
+
+void SafariumRootView::OnResize(int resize_amount, bool done_resizing) {
+  if (resize_start_width_ < 0) {
+    resize_start_width_ = side_panel_width_;
+  }
+  // The handle sits on the panel's inner edge: dragging toward the page
+  // widens it.
+  side_panel_width_ = resize_start_width_ +
+                      (SidePanelDockedRight() ? -resize_amount : resize_amount);
+  if (done_resizing) {
+    resize_start_width_ = -1;
+  }
+  InvalidateLayout();
+}
+
 void SafariumRootView::Layout(PassKey) {
-  contents_web_view_->SetBoundsRect(GetContentsBounds());
+  const gfx::Rect bounds = GetContentsBounds();
+  if (!IsSidePanelShowing()) {
+    contents_web_view_->SetBoundsRect(bounds);
+    LayoutSuperclass<views::View>(this);
+    return;
+  }
+  const int max_width = std::max(kMinSidePanelWidth, bounds.width() / 2);
+  side_panel_width_ =
+      std::clamp(side_panel_width_, kMinSidePanelWidth, max_width);
+  const int w = side_panel_width_;
+  const bool right = SidePanelDockedRight();
+  gfx::Rect panel(right ? bounds.right() - w : bounds.x(), bounds.y(), w,
+                  bounds.height());
+  gfx::Rect separator(right ? panel.x() - 1 : panel.right(), bounds.y(), 1,
+                      bounds.height());
+  gfx::Rect page = bounds;
+  page.set_width(bounds.width() - w - 1);
+  if (!right) {
+    page.set_x(separator.right());
+  }
+  contents_web_view_->SetBoundsRect(page);
+  side_panel_separator_->SetBoundsRect(separator);
+  side_panel_header_->SetBounds(panel.x(), panel.y(), panel.width(),
+                                SidePanelHeaderView::kHeight);
+  if (side_panel_content_) {
+    side_panel_content_->SetBounds(
+        panel.x(), panel.y() + SidePanelHeaderView::kHeight, panel.width(),
+        panel.height() - SidePanelHeaderView::kHeight);
+  }
+  side_panel_resize_->SetBounds(separator.x() - kResizeAreaWidth / 2,
+                                bounds.y(), kResizeAreaWidth, bounds.height());
   LayoutSuperclass<views::View>(this);
 }
 
