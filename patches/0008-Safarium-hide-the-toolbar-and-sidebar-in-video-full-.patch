+  virtual void SetContentFullscreen(bool fullscreen) {}
   // Tab overview thumbnails (only while SetWantsThumbnails(true)).
   virtual void ThumbnailChanged(int64_t tab_id, const gfx::ImageSkia& image) {}
   // Hover card for `tab_id` (see TabBarController::SetHoverCardTab).
diff --git a/chrome/browser/ui/webui_browser/safarium_tab_bar_host_mac.mm b/chrome/browser/ui/webui_browser/safarium_tab_bar_host_mac.mm
index f0df24c8a1..e39cfeab67 100644
--- a/chrome/browser/ui/webui_browser/safarium_tab_bar_host_mac.mm
+++ b/chrome/browser/ui/webui_browser/safarium_tab_bar_host_mac.mm
@@ -4807,6 +4807,7 @@ - (void)setController:(safarium::TabBarController*)controller;
 - (void)installInWindow:(NSWindow*)window;
 - (void)uninstall;
 - (void)setVerticalSidebar:(SafariumSidebarView*)sidebar;
+- (void)setContentFullscreen:(BOOL)fullscreen;
 - (void)updateViewport;
 - (void)updateState:(const safarium::BarState&)state;
 @end
@@ -4839,6 +4840,7 @@ @implementation SafariumToolbarController {
   id _escMonitor;  // Local key monitor: Esc leaves the overview.
   BOOL _closingOverview;  // Freeze the grid while zooming out of it.
   BOOL _verticalTabs;
+  BOOL _contentFullscreen;  // A page element (video) is full screen.
   BOOL _showHome;
   BOOL _homeItemSynced;   // Initial toolbar/pref reconciliation done.
   BOOL _syncingHomeItem;  // We are adding/removing the Home item ourselves.
@@ -4907,6 +4909,27 @@ - (void)setVerticalSidebar:(SafariumSidebarView*)sidebar {
   [self applyWindowChrome];
 }
 
+// A page element (e.g. a video) is full screen: the page takes the whole
+// screen, as in Safari. The horizontal toolbar hides until it leaves; the
+// vertical sidebar is hidden by SafariumRootView.
+- (void)setContentFullscreen:(BOOL)fullscreen {
+  if (_contentFullscreen == fullscreen) {
+    return;
+  }
+  _contentFullscreen = fullscreen;
+  if (fullscreen) {
+    [_downloadsPopover close];
+    if (_overview) {
+      [self setOverview:NO];
+    }
+    [self endSidebarEditing];
+    [_tabView hideHoverCard];
+  }
+  if (!_verticalTabs && _window.toolbar == _toolbar) {
+    _toolbar.visible = !fullscreen;
+  }
+}
+
 // --- Vertical sidebar toolbar ----------------------------------------------
 // The sidebar has its own layout, independent of the horizontal NSToolbar:
 // a list of toolbar item identifiers saved in its own defaults key, using
@@ -5320,6 +5343,7 @@ - (void)applyWindowChrome {
     window.styleMask &= ~NSWindowStyleMaskFullSizeContentView;
     window.titlebarAppearsTransparent = NO;
     window.toolbar = _toolbar;
+    _toolbar.visible = !_contentFullscreen;
   }
   [self refreshItems];
 }
@@ -6253,6 +6277,10 @@ void SetVerticalSidebar(gfx::NativeView sidebar) override {
 
   void UpdateViewport() override { [toolbar_ updateViewport]; }
 
+  void SetContentFullscreen(bool fullscreen) override {
+    [toolbar_ setContentFullscreen:fullscreen];
+  }
+
   void ThumbnailChanged(int64_t tab_id, const gfx::ImageSkia& image) override {
     [toolbar_ thumbnailChanged:gfx::NSImageFromImageSkia(image) forTab:tab_id];
   }
diff --git a/chrome/browser/ui/webui_browser/webui_browser_window.cc b/chrome/browser/ui/webui_browser/webui_browser_window.cc
index 980b604857..3e7a9c4091 100644
--- a/chrome/browser/ui/webui_browser/webui_browser_window.cc
+++ b/chrome/browser/ui/webui_browser/webui_browser_window.cc
@@ -341,6 +341,18 @@ void WebUIBrowserWindow::Show() {
 
   widget_->Show();
 
+  // Safarium: follow page (video) full screen. The exclusive access manager
+  // is created after this window, so subscribe on first show.
+  if (safarium_root_ && !fullscreen_state_subscription_) {
+    if (auto* manager = ExclusiveAccessManager::From(browser_)) {
+      fullscreen_state_subscription_ =
+          manager->fullscreen_controller()->RegisterOnFullscreenStateChanged(
+              base::BindRepeating(
+                  &WebUIBrowserWindow::UpdateSafariumContentFullscreen,
+                  base::Unretained(this)));
+    }
+  }
+
   // Give our main web contents the focus so that accelerators work.
   // This must happen after Show() since focusing triggers widget activation,
   // which calls PaintAsActiveChanged() -> Browser::DidBecomeActive(). The
@@ -719,6 +731,18 @@ void WebUIBrowserWindow::ProcessFullscreen(bool fullscreen) {
       ->WindowFullscreenStateChanged();
 }
 
+void WebUIBrowserWindow::UpdateSafariumContentFullscreen() {
+  if (!safarium_root_ || !browser_) {
+    return;
+  }
+  auto* manager = ExclusiveAccessManager::From(browser_);
+  // Only when the window is (going) full screen for the page: not the
+  // window's own full screen, nor a page "full screen" inside its tab.
+  safarium_root_->SetContentFullscreen(
+      manager && IsFullscreen() &&
+      manager->fullscreen_controller()->IsWindowFullscreenForTabOrPending());
+}
+
 void WebUIBrowserWindow::DeleteBrowserWindow() {
   delete this;
 }
diff --git a/chrome/browser/ui/webui_browser/webui_browser_window.h b/chrome/browser/ui/webui_browser/webui_browser_window.h
index 9eaddf0a17..9298a8a90e 100644
--- a/chrome/browser/ui/webui_browser/webui_browser_window.h
+++ b/chrome/browser/ui/webui_browser/webui_browser_window.h
@@ -331,6 +331,9 @@ class WebUIBrowserWindow : public BrowserWindow,
   // DidBecomeActive/DidBecomeInactive at the right time, accounting for child
   // widget focus (e.g., modal dialogs keeping the parent "active").
   base::CallbackListSubscription paint_as_active_subscription_;
+  // Safarium: page (video) full screen hides the native toolbar / sidebar.
+  base::CallbackListSubscription fullscreen_state_subscription_;
+  void UpdateSafariumContentFullscreen();
 
   base::CallbackListSubscription theme_changed_subscription_;
 
