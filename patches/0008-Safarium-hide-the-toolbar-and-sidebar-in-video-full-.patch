From 6ad4e192771856a5ff1bf7177a158ed1a63ebc7a Mon Sep 17 00:00:00 2001
From: Longwei Yang <19267252+Longwei-Yang@users.noreply.github.com>
Date: Thu, 19 Nov 2026 12:44:55 -0500
Subject: [PATCH 8/8] Safarium: hide the toolbar and sidebar in video full
 screen

When a page element such as a video goes full screen, hide the horizontal
toolbar or the vertical sidebar, and move an open extension side panel out
of sight, so only the page shows. They come back when the page leaves full
screen. The window's own full screen (green button) keeps its toolbar.

Follows FullscreenController's state-change callbacks, so entering page
full screen from browser full screen and returning to it are covered.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../ui/webui_browser/safarium_root_view.cc    | 29 ++++++++++++++++---
 .../ui/webui_browser/safarium_root_view.h     |  4 +++
 .../safarium_tab_bar_controller.h             |  3 ++
 .../safarium_tab_bar_host_mac.mm              | 28 ++++++++++++++++++
 .../ui/webui_browser/webui_browser_window.cc  | 24 +++++++++++++++
 .../ui/webui_browser/webui_browser_window.h   |  3 ++
 6 files changed, 87 insertions(+), 4 deletions(-)

diff --git a/chrome/browser/ui/webui_browser/safarium_root_view.cc b/chrome/browser/ui/webui_browser/safarium_root_view.cc
index c8652ede57..47ab9d550b 100644
--- a/chrome/browser/ui/webui_browser/safarium_root_view.cc
+++ b/chrome/browser/ui/webui_browser/safarium_root_view.cc
@@ -100,7 +100,7 @@ bool SafariumRootView::VerticalTabs() const {
 
 void SafariumRootView::OnVerticalTabsPrefChanged() {
   const bool vertical = VerticalTabs();
-  sidebar_->SetVisible(vertical);
+  sidebar_->SetVisible(vertical && !content_fullscreen_);
   bar_view_->SetVerticalSidebar(vertical ? sidebar_->GetSidebarNativeView()
                                         : gfx::NativeView());
   InvalidateLayout();
@@ -245,17 +245,38 @@ void SafariumRootView::OnResize(int resize_amount, bool done_resizing) {
   InvalidateLayout();
 }
 
+void SafariumRootView::SetContentFullscreen(bool fullscreen) {
+  if (content_fullscreen_ == fullscreen) {
+    return;
+  }
+  content_fullscreen_ = fullscreen;
+  sidebar_->SetVisible(VerticalTabs() && !fullscreen);
+  bar_view_->SetContentFullscreen(fullscreen);
+  InvalidateLayout();
+}
+
 void SafariumRootView::Layout(PassKey) {
   gfx::Rect area = GetContentsBounds();
-  if (VerticalTabs()) {
+  if (VerticalTabs() && !content_fullscreen_) {
     // The sidebar width belongs to the window and is shared by its tabs.
     // The sidebar draws its own edge line (like the toolbar's bottom line).
     sidebar_->SetBounds(area.x(), area.y(), sidebar_width_, area.height());
     area.Inset(gfx::Insets::TLBR(0, sidebar_width_, 0, 0));
   }
 
-  // Extension side panels dock on the right of the page, full height.
-  if (IsSidePanelShowing()) {
+  // Extension side panels dock on the right of the page, full height. While
+  // the page is full screen an open panel stays open, out of sight.
+  if (IsSidePanelShowing() && content_fullscreen_) {
+    for (views::View* view :
+         {side_panel_separator_.get(),
+          static_cast<views::View*>(side_panel_header_.get()),
+          static_cast<views::View*>(side_panel_resize_.get()),
+          side_panel_content_.get()}) {
+      if (view) {
+        view->SetBoundsRect(gfx::Rect());
+      }
+    }
+  } else if (IsSidePanelShowing()) {
     const int max_width = std::max(kMinSidePanelWidth, area.width() / 2);
     side_panel_width_ =
         std::clamp(side_panel_width_, kMinSidePanelWidth, max_width);
diff --git a/chrome/browser/ui/webui_browser/safarium_root_view.h b/chrome/browser/ui/webui_browser/safarium_root_view.h
index 48b316be60..43f424fa0e 100644
