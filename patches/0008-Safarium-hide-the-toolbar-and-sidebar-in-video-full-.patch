@@ -110,6 +110,9 @@ class SafariumRootView : public views::View,
 
   void SetActiveContents(content::WebContents* contents);
   void FocusAddressField();
+  // A page element (e.g. a video) is full screen: only the page shows (no
+  // toolbar, sidebar or side panel) until it leaves.
+  void SetContentFullscreen(bool fullscreen);
 
   // Extension (or other) side panel, docked left or right of the page
   // (pref side_panel.is_right_aligned).
@@ -152,6 +155,7 @@ class SafariumRootView : public views::View,
   raw_ptr<views::View> side_panel_separator_ = nullptr;
   raw_ptr<VerticalSidebarView> sidebar_ = nullptr;
   int sidebar_width_ = 250;
+  bool content_fullscreen_ = false;
   raw_ptr<SidePanelHeaderView> side_panel_header_ = nullptr;
   raw_ptr<views::View> side_panel_content_ = nullptr;
   raw_ptr<views::ResizeArea> side_panel_resize_ = nullptr;
diff --git a/chrome/browser/ui/webui_browser/safarium_tab_bar_controller.h b/chrome/browser/ui/webui_browser/safarium_tab_bar_controller.h
