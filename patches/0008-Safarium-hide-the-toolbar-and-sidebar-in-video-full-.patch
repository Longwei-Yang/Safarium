@@ -75,6 +75,9 @@ class TabBarView {
   // window and the page runs to the top edge.
   virtual void SetVerticalSidebar(gfx::NativeView sidebar) {}
   virtual void UpdateViewport() {}
+  // A page element (e.g. a video) is full screen: the page takes the whole
