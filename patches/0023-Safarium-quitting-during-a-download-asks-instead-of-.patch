From e46f459c09c627650cb0dad7241c263ceff8b10e Mon Sep 17 00:00:00 2001
From: Longwei Yang <19267252+Longwei-Yang@users.noreply.github.com>
Date: Fri, 20 Nov 2026 16:07:18 -0500
Subject: [PATCH 23/26] Safarium: quitting during a download asks instead of
 hanging

WebUIBrowserWindow::ConfirmBrowserCloseWithPendingDownloads was a stub
that never ran its callback, so with a download running Quit did
nothing and the window couldn't close. It now shows Chrome's
"Download is in progress" dialog (Continue Downloading / Quit), as
BrowserView does.

Also filled in, as BrowserView does: FlashFrame (Dock bounce),
Get/SetZOrderLevel (keep on top), ShowInactive/Hide (windows opened in
the background), ShowCaretBrowsingDialog (F7).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../ui/webui_browser/webui_browser_window.cc  | 34 ++++++++++++++-----
 1 file changed, 26 insertions(+), 8 deletions(-)

diff --git a/chrome/browser/ui/webui_browser/webui_browser_window.cc b/chrome/browser/ui/webui_browser/webui_browser_window.cc
index 0a62640839..f9339ab86a 100644
--- a/chrome/browser/ui/webui_browser/webui_browser_window.cc
+++ b/chrome/browser/ui/webui_browser/webui_browser_window.cc
@@ -42,8 +42,10 @@
 #include "chrome/browser/translate/chrome_translate_client.h"
 #include "chrome/browser/ui/actions/chrome_action_id.h"
 #include "chrome/browser/ui/translate/translate_controller.h"
+#include "chrome/browser/ui/views/accessibility/caret_browsing_dialog_delegate.h"
 #include "chrome/browser/ui/views/autofill/autofill_bubble_handler_impl.h"
 #include "chrome/browser/ui/views/bookmarks/bookmark_bubble_view.h"
+#include "chrome/browser/ui/views/download/download_in_progress_dialog_view.h"
 #include "chrome/browser/ui/views/eye_dropper/eye_dropper.h"
 #include "chrome/browser/ui/webui_browser/safarium_bubble_anchors.h"
 #include "components/translate/core/browser/language_state.h"
@@ -489,11 +491,18 @@ void WebUIBrowserWindow::EnsureActiveTabHasNonZeroSize() {
 }
 
 void WebUIBrowserWindow::ShowInactive() {
-  NOTIMPLEMENTED_LOG_ONCE();
+  // As BrowserView: show without activating (e.g. a window an extension
+  // opens unfocused); no-op for closed or already visible windows.
+  if (!widget_ || widget_->IsClosed() || widget_->IsVisible()) {
+    return;
+  }
+  widget_->ShowInactive();
 }
 
 void WebUIBrowserWindow::Hide() {
-  NOTIMPLEMENTED_LOG_ONCE();
+  if (widget_) {
+    widget_->Hide();
+  }
 }
 
 bool WebUIBrowserWindow::IsVisible() const {
@@ -529,16 +538,20 @@ bool WebUIBrowserWindow::IsActive() const {
 }
 
 void WebUIBrowserWindow::FlashFrame(bool flash) {
-  NOTIMPLEMENTED_LOG_ONCE();
+  // Bounces the Dock icon when a background tab needs attention.
+  if (widget_) {
+    widget_->FlashFrame(flash);
+  }
 }
 
 ui::ZOrderLevel WebUIBrowserWindow::GetZOrderLevel() const {
-  NOTIMPLEMENTED_LOG_ONCE();
-  return ui::ZOrderLevel::kNormal;
+  return widget_ ? widget_->GetZOrderLevel() : ui::ZOrderLevel::kNormal;
 }
 
 void WebUIBrowserWindow::SetZOrderLevel(ui::ZOrderLevel order) {
-  NOTIMPLEMENTED_LOG_ONCE();
+  if (widget_) {
+    widget_->SetZOrderLevel(order);
+  }
 }
 
 gfx::NativeWindow WebUIBrowserWindow::GetNativeWindow() const {
@@ -1239,7 +1252,10 @@ void WebUIBrowserWindow::ConfirmBrowserCloseWithPendingDownloads(
     int download_count,
     UnloadController::DownloadCloseType dialog_type,
     base::OnceCallback<void(bool)> callback) {
-  NOTIMPLEMENTED_LOG_ONCE();
+  // "Cancel downloads?" sheet, as BrowserView. Without it the close (and
+  // Quit) waited forever for an answer while a download was running.
+  DownloadInProgressDialogView::Show(GetNativeWindow(), download_count,
+                                     dialog_type, std::move(callback));
 }
 
 void WebUIBrowserWindow::UpdateSafariumWindowColorMode() {
@@ -1429,7 +1445,9 @@ std::unique_ptr<content::EyeDropper> WebUIBrowserWindow::OpenEyeDropper(
 }
 
 void WebUIBrowserWindow::ShowCaretBrowsingDialog() {
-  NOTIMPLEMENTED_LOG_ONCE();
+  // F7: "Turn on caret browsing?", as BrowserView.
+  CaretBrowsingDialogDelegate::Show(GetNativeWindow(),
+                                    browser_->GetProfile()->GetPrefs());
 }
 
 void WebUIBrowserWindow::CreateTabSearchBubble() {
