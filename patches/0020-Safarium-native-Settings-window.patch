+// --- Lifetime ---------------------------------------------------------------
+
+- (void)profileWillBeDestroyed {
+  [self.window close];
+}
+
+- (void)windowWillClose:(NSNotification*)notification {
+  _bindings = nil;
+  _bridge.reset();
+  if (_profile) {
+    [OpenWindows() removeObjectForKey:[NSValue valueWithPointer:_profile]];
+  }
+  _profile = nullptr;
+}
