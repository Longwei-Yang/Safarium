+// --- Tabs -------------------------------------------------------------------
+
+- (NSViewController*)tabsPane {
+  PrefService* prefs = [self prefs];
+  PrefService* local = g_browser_process->local_state();
+
+  NSButton* compact = [NSButton radioButtonWithTitle:@"Compact"
+                                              target:nil
+                                              action:nil];
+  NSButton* vertical = [NSButton radioButtonWithTitle:@"Vertical"
+                                               target:nil
+                                               action:nil];
+  __weak NSButton* weakCompact = compact;
+  __weak NSButton* weakVertical = vertical;
+  void (^refresh)(void) = ^{
+    const bool on = prefs->GetBoolean(prefs::kVerticalTabsEnabled);
+    weakCompact.state = on ? NSControlStateValueOff : NSControlStateValueOn;
+    weakVertical.state = on ? NSControlStateValueOn : NSControlStateValueOff;
+    const bool editable =
+        prefs->IsUserModifiablePreference(prefs::kVerticalTabsEnabled);
+    weakCompact.enabled = editable;
+    weakVertical.enabled = editable;
+  };
+  [self bindPref:prefs::kVerticalTabsEnabled
+         service:prefs
+         control:compact
+         refresh:refresh
+          action:^(id sender) {
+            prefs->SetBoolean(prefs::kVerticalTabsEnabled, false);
+          }];
+  [self bindPref:prefs::kVerticalTabsEnabled
+         service:prefs
+         control:vertical
+         refresh:refresh
+          action:^(id sender) {
+            prefs->SetBoolean(prefs::kVerticalTabsEnabled, true);
+          }];
+
+  NSButton* preview =
+      [self checkbox:@"Show a preview of the page when hovering over a tab"
+                pref:prefs::kHoverCardImagesEnabled
+             service:local];
+  NSButton* memory = [self checkbox:@"Show memory usage in tab previews"
+                               pref:prefs::kHoverCardMemoryUsageEnabled
+                            service:local];
+  NSButton* toolbar = [self checkbox:@"Always show the toolbar in full screen"
+                                pref:prefs::kShowFullscreenToolbar
+                             service:prefs];
+
+  return Pane(@"Tabs", @[
+    @[ Label(@"Tab layout:"),
+       Column(@[
+         compact, Indented(Note(@"Tabs share the toolbar with the address field.")),
+         vertical, Indented(Note(@"Tabs and toolbar buttons in a sidebar."))
+       ]) ],
+    @[ Label(@"Tab previews:"), Column(@[ preview, memory ]) ],
+    @[ Label(@"Full screen:"), toolbar ],
+  ]);
+}
