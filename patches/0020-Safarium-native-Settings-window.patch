+// One control bound to one pref: `refresh` loads the pref into the control,
+// `action` stores the control's value.
+@interface SafariumPrefBinding : NSObject
+@property(nonatomic, copy) NSString* pref;
+@property(nonatomic, copy) void (^refresh)(void);
+@property(nonatomic, copy) void (^action)(id sender);
+- (void)fire:(id)sender;
+@end
+
+@implementation SafariumPrefBinding
+@synthesize pref = _pref;
+@synthesize refresh = _refresh;
+@synthesize action = _action;
+- (void)fire:(id)sender {
+  if (_action) {
+    _action(sender);
+  }
+}
+@end
+
+// Titles the window after the selected pane, like Safari's Settings.
+@interface SafariumSettingsTabViewController : NSTabViewController
+@end
+
+@implementation SafariumSettingsTabViewController
+- (void)tabView:(NSTabView*)tabView didSelectTabViewItem:(NSTabViewItem*)item {
+  [super tabView:tabView didSelectTabViewItem:item];
+  self.view.window.title = item.label;
+  if (item.identifier) {
+    [NSUserDefaults.standardUserDefaults setObject:item.identifier
+                                            forKey:kSelectedPaneKey];
+  }
+}
+@end
+
+@interface SafariumSettingsController : NSWindowController <NSWindowDelegate>
+- (instancetype)initWithProfile:(Profile*)profile;
+- (void)prefChanged:(NSString*)name;
+- (void)defaultBrowserStateChanged:(shell_integration::DefaultWebClientState)
+                                       state;
+- (void)profileWillBeDestroyed;
+@end
