+// Watches the profile's prefs (and local state) for the window and closes it
+// when the profile goes away.
+class SettingsWindowBridge : public ProfileObserver {
+ public:
+  SettingsWindowBridge(Profile* profile, SafariumSettingsController* controller);
+  SettingsWindowBridge(const SettingsWindowBridge&) = delete;
+  SettingsWindowBridge& operator=(const SettingsWindowBridge&) = delete;
+  ~SettingsWindowBridge() override;
+
+  // Calls the controller's -prefChanged: when `name` changes in `service`.
+  void Watch(PrefService* service, const std::string& name);
+
+  // Checks (or makes) Safarium the default browser, then reports to the
+  // controller's -defaultBrowserStateChanged:.
+  void CheckDefaultBrowser(bool set);
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+
+ private:
+  void OnPrefChanged(const std::string& name);
+  void OnDefaultBrowserState(shell_integration::DefaultWebClientState state);
+
+  __weak SafariumSettingsController* controller_;
+  PrefChangeRegistrar profile_prefs_;
+  PrefChangeRegistrar local_state_;
+  scoped_refptr<shell_integration::DefaultBrowserWorker> default_worker_;
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  base::WeakPtrFactory<SettingsWindowBridge> weak_factory_{this};
+};
+
