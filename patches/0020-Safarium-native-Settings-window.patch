+@implementation SafariumSettingsController {
+  raw_ptr<Profile> _profile;
+  std::unique_ptr<SettingsWindowBridge> _bridge;
+  NSMutableArray<SafariumPrefBinding*>* _bindings;
+  NSTextField* _defaultBrowserStatus;
+  NSButton* _defaultBrowserButton;
+}
+
+- (instancetype)initWithProfile:(Profile*)profile {
+  NSWindow* window = [[NSWindow alloc]
+      initWithContentRect:NSMakeRect(0, 0, kPaneMinWidth, 300)
+                styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable
+                  backing:NSBackingStoreBuffered
+                    defer:YES];
+  if ((self = [super initWithWindow:window])) {
+    _profile = profile;
+    _bindings = [NSMutableArray array];
+    _bridge = std::make_unique<SettingsWindowBridge>(profile, self);
+    window.delegate = self;
+    window.releasedWhenClosed = NO;
+    window.toolbarStyle = NSWindowToolbarStylePreference;
+    window.identifier = @"SafariumSettingsWindow";
+
+    SafariumSettingsTabViewController* tabs =
+        [[SafariumSettingsTabViewController alloc] init];
+    tabs.tabStyle = NSTabViewControllerTabStyleToolbar;
+    tabs.transitionOptions = NSViewControllerTransitionCrossfade |
+                             NSViewControllerTransitionAllowUserInteraction;
+    struct PaneSpec {
+      NSString* identifier;
+      NSString* symbol;
+      NSViewController* pane;
+    };
+    const PaneSpec panes[] = {
+        {@"general", @"gearshape", [self generalPane]},
+        {@"tabs", @"square.on.square", [self tabsPane]},
+        {@"autofill", @"pencil.and.list.clipboard", [self autofillPane]},
+        {@"advanced", @"gearshape.2", [self advancedPane]},
+    };
+    NSString* selected = [NSUserDefaults.standardUserDefaults
+        stringForKey:kSelectedPaneKey];
+    NSInteger selectedIndex = 0;
+    for (const PaneSpec& spec : panes) {
+      NSTabViewItem* item =
+          [NSTabViewItem tabViewItemWithViewController:spec.pane];
+      item.identifier = spec.identifier;
+      item.label = spec.pane.title;
+      item.image = [NSImage imageWithSystemSymbolName:spec.symbol
+                             accessibilityDescription:spec.pane.title];
+      if ([selected isEqualToString:spec.identifier]) {
+        selectedIndex = tabs.tabViewItems.count;
+      }
+      [tabs addTabViewItem:item];
+    }
+    window.contentViewController = tabs;
+    tabs.selectedTabViewItemIndex = selectedIndex;
+    window.title = tabs.tabViewItems[selectedIndex].label;
+    [window center];
+    _bridge->CheckDefaultBrowser(/*set=*/false);
+  }
+  return self;
+}
+
+// --- Bindings ---------------------------------------------------------------
+
+- (PrefService*)prefs {
+  return _profile ? _profile->GetPrefs() : nullptr;
+}
+
+- (void)bindPref:(const char*)pref
+         service:(PrefService*)service
+         control:(NSControl*)control
+         refresh:(void (^)(void))refresh
+          action:(void (^)(id sender))action {
+  SafariumPrefBinding* binding = [[SafariumPrefBinding alloc] init];
+  binding.pref = @(pref);
+  binding.refresh = refresh;
+  binding.action = action;
+  if (control) {
+    control.target = binding;
+    control.action = @selector(fire:);
+  }
+  [_bindings addObject:binding];
+  _bridge->Watch(service, pref);
+  refresh();
+}
+
+// A checkbox for a boolean pref (disabled when a policy sets it).
+- (NSButton*)checkbox:(NSString*)title
+                 pref:(const char*)pref
+              service:(PrefService*)service {
+  NSButton* box = [NSButton checkboxWithTitle:title target:nil action:nil];
+  std::string name = pref;
+  __weak NSButton* weakBox = box;
+  [self bindPref:pref
+         service:service
+         control:box
+         refresh:^{
+           weakBox.state = service->GetBoolean(name)
+                               ? NSControlStateValueOn
+                               : NSControlStateValueOff;
+           weakBox.enabled = service->IsUserModifiablePreference(name);
+         }
+          action:^(id sender) {
+            service->SetBoolean(name, [sender state] == NSControlStateValueOn);
+          }];
+  return box;
+}
+
+- (void)prefChanged:(NSString*)name {
+  for (SafariumPrefBinding* binding in _bindings) {
+    if ([binding.pref isEqualToString:name] && binding.refresh) {
+      binding.refresh();
+    }
+  }
+}
+
+- (NSButton*)linkButton:(NSString*)title url:(const char*)url {
+  NSButton* button = [NSButton buttonWithTitle:title
+                                        target:self
+                                        action:@selector(openLink:)];
+  button.identifier = @(url);
+  return button;
+}
+
+- (void)openLink:(NSButton*)sender {
+  if (!_profile) {
+    return;
+  }
+  ShowSingletonTab(_profile, GURL(base::SysNSStringToUTF8(sender.identifier)));
+}
+
+// --- General ----------------------------------------------------------------
+
+- (NSViewController*)generalPane {
+  PrefService* prefs = [self prefs];
+
+  // Startup: the two choices Safari offers; URLs stay in All Settings.
+  NSPopUpButton* startup = [[NSPopUpButton alloc] initWithFrame:NSZeroRect
+                                                      pullsDown:NO];
+  [startup addItemsWithTitles:@[
+    @"A new tab", @"All tabs from the last session", @"Specific pages"
+  ]];
+  [startup itemAtIndex:2].enabled = NO;
+  startup.autoenablesItems = NO;
+  __weak NSPopUpButton* weakStartup = startup;
+  [self bindPref:prefs::kRestoreOnStartup
+         service:prefs
+         control:startup
+         refresh:^{
+           const SessionStartupPref pref =
+               SessionStartupPref::GetStartupPref(prefs);
+           NSInteger index = 0;
+           if (pref.type == SessionStartupPref::LAST) {
+             index = 1;
+           } else if (pref.type == SessionStartupPref::URLS ||
+                      pref.type == SessionStartupPref::LAST_AND_URLS) {
+             index = 2;
+           }
+           [weakStartup selectItemAtIndex:index];
+           [weakStartup itemAtIndex:2].hidden = index != 2;
+           weakStartup.enabled = !SessionStartupPref::TypeIsManaged(prefs);
+         }
+          action:^(id sender) {
+            SessionStartupPref pref = SessionStartupPref::GetStartupPref(prefs);
+            pref.type = [sender indexOfSelectedItem] == 1
+                            ? SessionStartupPref::LAST
+                            : SessionStartupPref::DEFAULT;
+            SessionStartupPref::SetStartupPref(prefs, pref);
+          }];
+
+  // Home button and the page it opens.
+  NSButton* showHome = [self checkbox:@"Show Home button in the toolbar"
+                                 pref:prefs::kShowHomeButton
+                              service:prefs];
+  NSPopUpButton* homeKind = [[NSPopUpButton alloc] initWithFrame:NSZeroRect
+                                                       pullsDown:NO];
+  [homeKind addItemsWithTitles:@[ @"New Tab page", @"Homepage:" ]];
+  NSTextField* homePage = [NSTextField textFieldWithString:@""];
+  homePage.placeholderString = @"https://www.example.com";
+  [homePage.widthAnchor constraintEqualToConstant:220].active = YES;
+  __weak NSPopUpButton* weakKind = homeKind;
+  __weak NSTextField* weakHome = homePage;
+  [self bindPref:prefs::kHomePageIsNewTabPage
+         service:prefs
+         control:homeKind
+         refresh:^{
+           const bool ntp = prefs->GetBoolean(prefs::kHomePageIsNewTabPage);
+           [weakKind selectItemAtIndex:ntp ? 0 : 1];
+           weakKind.enabled =
+               prefs->IsUserModifiablePreference(prefs::kHomePageIsNewTabPage);
+           weakHome.enabled =
+               !ntp && prefs->IsUserModifiablePreference(prefs::kHomePage);
+         }
+          action:^(id sender) {
+            prefs->SetBoolean(prefs::kHomePageIsNewTabPage,
+                              [sender indexOfSelectedItem] == 0);
+          }];
+  [self bindPref:prefs::kHomePage
+         service:prefs
+         control:homePage
+         refresh:^{
+           weakHome.stringValue =
+               base::SysUTF8ToNSString(prefs->GetString(prefs::kHomePage));
+         }
+          action:^(id sender) {
+            const std::string text = base::SysNSStringToUTF8([sender stringValue]);
+            if (text.empty()) {
+              return;
+            }
+            const GURL url = url_formatter::FixupURL(text, std::string());
+            if (url.is_valid()) {
+              prefs->SetString(prefs::kHomePage, url.spec());
+            }
+          }];
+
+  // Downloads.
+  NSPopUpButton* folder = [[NSPopUpButton alloc] initWithFrame:NSZeroRect
+                                                     pullsDown:NO];
+  __weak NSPopUpButton* weakFolder = folder;
+  Profile* profile = _profile;
+  [self bindPref:prefs::kDownloadDefaultDirectory
+         service:prefs
+         control:folder
+         refresh:^{
+           DownloadPrefs* downloads = DownloadPrefs::FromBrowserContext(profile);
+           const base::FilePath path = downloads->DownloadPath();
+           NSString* posix = base::SysUTF8ToNSString(path.value());
+           [weakFolder removeAllItems];
+           [weakFolder addItemWithTitle:[NSFileManager.defaultManager
+                                            displayNameAtPath:posix]];
+           NSImage* icon = [NSWorkspace.sharedWorkspace iconForFile:posix];
+           icon.size = NSMakeSize(16, 16);
+           weakFolder.lastItem.image = icon;
+           weakFolder.lastItem.toolTip = posix;
+           [weakFolder.menu addItem:NSMenuItem.separatorItem];
+           [weakFolder addItemWithTitle:@"Other…"];
+           [weakFolder selectItemAtIndex:0];
+           weakFolder.enabled = !downloads->IsDownloadPathManaged();
+         }
+          action:^(id sender) {
+            if ([sender indexOfSelectedItem] == 0) {
+              return;
+            }
+            [sender selectItemAtIndex:0];
+            NSOpenPanel* panel = [NSOpenPanel openPanel];
+            panel.canChooseFiles = NO;
+            panel.canChooseDirectories = YES;
+            panel.canCreateDirectories = YES;
+            panel.prompt = @"Select";
+            [panel beginSheetModalForWindow:[sender window]
+                          completionHandler:^(NSModalResponse result) {
+                            if (result != NSModalResponseOK || !panel.URL) {
+                              return;
+                            }
+                            DownloadPrefs::FromBrowserContext(profile)
+                                ->SetDownloadPath(base::FilePath(
+                                    base::SysNSStringToUTF8(panel.URL.path)));
+                          }];
+          }];
+  NSButton* ask = [self checkbox:@"Ask where to save each file"
+                            pref:prefs::kPromptForDownload
+                         service:prefs];
+
+  // Default browser.
+  _defaultBrowserStatus = [NSTextField labelWithString:@""];
+  _defaultBrowserButton = [NSButton buttonWithTitle:@"Set Default…"
+                                             target:self
+                                             action:@selector(setDefault:)];
+  _defaultBrowserButton.hidden = YES;
+
+  return Pane(@"General", @[
+    @[ Label(@"Safarium opens with:"), startup ],
+    @[ Label(@"Home button:"), Column(@[ showHome, Row(@[ homeKind, homePage ]) ]) ],
+    @[ Label(@"File download location:"), Column(@[ folder, ask ]) ],
+    @[ Label(@"Default web browser:"),
+       Row(@[ _defaultBrowserStatus, _defaultBrowserButton ]) ],
+  ]);
+}
+
+- (void)setDefault:(id)sender {
+  _bridge->CheckDefaultBrowser(/*set=*/true);
+}
+
+- (void)defaultBrowserStateChanged:
+    (shell_integration::DefaultWebClientState)state {
+  const bool isDefault = state == shell_integration::IS_DEFAULT;
+  _defaultBrowserStatus.stringValue =
+      isDefault ? @"Safarium is your default web browser."
+                : @"Safarium is not your default web browser.";
+  _defaultBrowserButton.hidden = isDefault;
+}
