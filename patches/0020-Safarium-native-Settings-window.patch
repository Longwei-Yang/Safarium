+namespace {
+
+// Open settings windows, one per profile.
+NSMutableDictionary<NSValue*, SafariumSettingsController*>* OpenWindows() {
+  static NSMutableDictionary* windows = [NSMutableDictionary dictionary];
+  return windows;
+}
+
+SettingsWindowBridge::SettingsWindowBridge(
+    Profile* profile,
+    SafariumSettingsController* controller)
+    : controller_(controller) {
+  profile_prefs_.Init(profile->GetPrefs());
+  local_state_.Init(g_browser_process->local_state());
+  profile_observation_.Observe(profile);
+}
+
+SettingsWindowBridge::~SettingsWindowBridge() = default;
+
+void SettingsWindowBridge::Watch(PrefService* service,
+                                 const std::string& name) {
+  PrefChangeRegistrar& registrar =
+      service == g_browser_process->local_state() ? local_state_
+                                                  : profile_prefs_;
+  if (registrar.IsObserved(name)) {
+    return;
+  }
+  registrar.Add(name, base::BindRepeating(&SettingsWindowBridge::OnPrefChanged,
+                                          base::Unretained(this)));
+}
+
+void SettingsWindowBridge::CheckDefaultBrowser(bool set) {
+  default_worker_ = base::MakeRefCounted<shell_integration::DefaultBrowserWorker>();
+  auto callback = base::BindOnce(&SettingsWindowBridge::OnDefaultBrowserState,
+                                 weak_factory_.GetWeakPtr());
+  if (set) {
+    default_worker_->StartSetAsDefault(std::move(callback));
+  } else {
+    default_worker_->StartCheckIsDefault(std::move(callback));
+  }
+}
+
+void SettingsWindowBridge::OnProfileWillBeDestroyed(Profile* profile) {
+  profile_observation_.Reset();
+  profile_prefs_.RemoveAll();
+  [controller_ profileWillBeDestroyed];
+}
+
+void SettingsWindowBridge::OnPrefChanged(const std::string& name) {
+  [controller_ prefChanged:base::SysUTF8ToNSString(name)];
+}
+
+void SettingsWindowBridge::OnDefaultBrowserState(
+    shell_integration::DefaultWebClientState state) {
+  [controller_ defaultBrowserStateChanged:state];
+}
+
+NSTextField* Label(NSString* text) {
+  NSTextField* label = [NSTextField labelWithString:text];
+  label.alignment = NSTextAlignmentRight;
+  return label;
+}
+
+NSTextField* Note(NSString* text) {
+  NSTextField* note = [NSTextField wrappingLabelWithString:text];
+  note.font = [NSFont systemFontOfSize:NSFont.smallSystemFontSize];
+  note.textColor = NSColor.secondaryLabelColor;
+  note.preferredMaxLayoutWidth = 360;
+  return note;
+}
+
+// Lines a description up with the text of the checkbox or radio above it.
+NSView* Indented(NSView* view) {
+  NSStackView* stack = [NSStackView stackViewWithViews:@[ view ]];
+  stack.edgeInsets = NSEdgeInsetsMake(0, 20, 0, 0);
+  return stack;
+}
+
+NSStackView* Column(NSArray<NSView*>* views) {
+  NSStackView* stack = [NSStackView stackViewWithViews:views];
+  stack.orientation = NSUserInterfaceLayoutOrientationVertical;
+  stack.alignment = NSLayoutAttributeLeading;
+  stack.spacing = 6;
+  return stack;
+}
+
+NSStackView* Row(NSArray<NSView*>* views) {
+  NSStackView* stack = [NSStackView stackViewWithViews:views];
+  stack.orientation = NSUserInterfaceLayoutOrientationHorizontal;
+  stack.alignment = NSLayoutAttributeFirstBaseline;
+  stack.spacing = 8;
+  return stack;
+}
+
+// A pane: label/control rows in a grid, labels right-aligned (Safari's
+// layout), sized to fit.
+NSViewController* Pane(NSString* title, NSArray<NSArray<NSView*>*>* rows) {
+  // Pad rows to the same number of columns.
+  NSUInteger columns = 0;
+  for (NSArray<NSView*>* row in rows) {
+    columns = std::max(columns, row.count);
+  }
+  NSMutableArray<NSArray<NSView*>*>* padded = [NSMutableArray array];
+  for (NSArray<NSView*>* row in rows) {
+    NSMutableArray<NSView*>* cells = [row mutableCopy];
+    while (cells.count < columns) {
+      [cells addObject:[NSGridCell emptyContentView]];
+    }
+    [padded addObject:cells];
+  }
+  NSGridView* grid = [NSGridView gridViewWithViews:padded];
+  grid.rowSpacing = 14;
+  grid.columnSpacing = 10;
+  grid.rowAlignment = NSGridRowAlignmentFirstBaseline;
+  [grid columnAtIndex:0].xPlacement = NSGridCellPlacementTrailing;
+  for (NSInteger i = 0; i < grid.numberOfRows; ++i) {
+    NSView* left = [grid cellAtColumnIndex:0 rowIndex:i].contentView;
+    if (!left) {
+      [grid cellAtColumnIndex:0 rowIndex:i].xPlacement =
+          NSGridCellPlacementNone;
+    }
+  }
+  grid.translatesAutoresizingMaskIntoConstraints = NO;
+
+  NSView* container = [[NSView alloc] initWithFrame:NSZeroRect];
+  [container addSubview:grid];
+  [NSLayoutConstraint activateConstraints:@[
+    [grid.topAnchor constraintEqualToAnchor:container.topAnchor
+                                   constant:kPaneInset],
+    [grid.bottomAnchor constraintEqualToAnchor:container.bottomAnchor
+                                      constant:-kPaneInset],
+    [grid.centerXAnchor constraintEqualToAnchor:container.centerXAnchor],
+    [grid.leadingAnchor
+        constraintGreaterThanOrEqualToAnchor:container.leadingAnchor
+                                    constant:kPaneInset],
+    [container.widthAnchor constraintGreaterThanOrEqualToConstant:kPaneMinWidth],
+  ]];
+  NSViewController* pane = [[NSViewController alloc] init];
+  pane.view = container;
+  pane.title = title;
+  NSSize size = container.fittingSize;
+  size.width = std::max(size.width, kPaneMinWidth);
+  pane.preferredContentSize = size;
+  return pane;
+}
+
+}  // namespace
