+@end
+
+namespace safarium {
+
+void ShowSettingsWindow(Profile* profile) {
+  if (!profile) {
+    return;
+  }
+  profile = profile->GetOriginalProfile();
+  NSValue* key = [NSValue valueWithPointer:profile];
+  SafariumSettingsController* controller = OpenWindows()[key];
+  if (!controller) {
+    controller = [[SafariumSettingsController alloc] initWithProfile:profile];
+    OpenWindows()[key] = controller;
+  }
+  [controller showWindow:nil];
+  [controller.window makeKeyAndOrderFront:nil];
+}
+
+}  // namespace safarium
