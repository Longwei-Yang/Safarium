 }
 
+// View > Always Show Toolbar in Full Screen, as in Safari: when it is off the
+// toolbar slides down with the menu bar at the top of the screen instead of
+// staying on screen. AppKit reads this as the window enters full screen
+// (ViewsNSWindowDelegate -window:willUseFullScreenPresentationOptions:), so
+// a change made while in full screen applies the next time.
+- (void)applyFullScreenToolbarMode {
+  NSWindow* window = _window;
+  if ([window isKindOfClass:[BrowserNativeWidgetWindow class]]) {
+    static_cast<BrowserNativeWidgetWindow*>(window)
+        .autoHidesToolbarInFullScreen = !_alwaysShowToolbarInFullScreen;
+  }
+}
+
+
+
 // Horizontal tabs: the NSToolbar (tabs, address, buttons) on top. Vertical
 // tabs: no toolbar; the content view runs to the window's top edge (the
 // sidebar sits under the traffic lights, the page uses the full height).
@@ -6178,6 +6195,11 @@ - (void)updateState:(const safarium::BarState&)state {
   _isLoading = state.is_loading;
   _showHome = state.show_home_button;
   [self syncHomeItem:_showHome];
+  if (_alwaysShowToolbarInFullScreen !=
+      state.always_show_toolbar_in_full_screen) {
+    _alwaysShowToolbarInFullScreen = state.always_show_toolbar_in_full_screen;
+    [self applyFullScreenToolbarMode];
+  }
   NSMutableArray<SafariumOverviewTab*>* tabs = [NSMutableArray array];
   for (size_t i = 0; i < state.tabs.size(); ++i) {
     const safarium::TabItem& t = state.tabs[i];
