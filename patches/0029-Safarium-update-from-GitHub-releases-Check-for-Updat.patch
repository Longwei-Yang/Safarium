+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Safarium: updates the app from its GitHub releases. A release is tagged
+// v<Chromium version>-fix<N>; the packaging script stamps the app's
+// Info.plist with SafariumBuild (N), SafariumTag and SafariumCommit. The
+// updater downloads the newer release's DMG, checks its SHA-256, stages the
+// app, quits Safarium and lets a small script swap the app in place and
+// relaunch it with the previous session restored.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_UPDATER_H_
+#define CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_UPDATER_H_
+
+namespace safarium {
+
+// Safarium > Check for Updates…: reports the result either way.
+void CheckForUpdates();
+
+// Background checks: shortly after launch, then once a day. Only for
+// packaged builds (stamped with SafariumTag); silent unless a newer release
+// that the user hasn't skipped is out.
+void StartAutomaticUpdateChecks();
+
+// Safarium > Install Local Build… (Option key): installs the newest
+// *-local-*.dmg from ~/chromium/dist (defaults key
+// SafariumLocalUpdateDirectory), for builds that aren't released.
+void InstallLocalBuild();
+
+}  // namespace safarium
+
+#endif  // CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_UPDATER_H_
