@@ -0,0 +1,122 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Safarium: Safari-style page (video) full screen. The page leaves the
+// browser window for a window of its own, placed exactly over the element
+// that asked for full screen; macOS then grows that window into a full screen
+// Space and shrinks it back on exit. The browser window keeps a still image
+// of the page, with a fill where the element was.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_VIDEO_FULLSCREEN_H_
+#define CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_VIDEO_FULLSCREEN_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "ui/gfx/native_ui_types.h"
+
+#ifdef __OBJC__
+@class NSImage;
+#else
+class NSImage;
+#endif
+
+namespace views {
+class WebView;
+class Widget;
+class WidgetDelegate;
+}  // namespace views
+
+namespace safarium {
+
+class VideoFullscreen : public content::WebContentsObserver {
+ public:
+  struct Callbacks {
+    // Shows `contents` in the browser window's page area (null: none).
+    base::RepeatingCallback<void(content::WebContents*)> set_page;
+    // The browser window's active tab.
+    base::RepeatingCallback<content::WebContents*()> active_page;
+    // The video window finished entering or leaving full screen.
+    base::RepeatingClosure state_changed;
+    // The user left full screen from the video window itself (its window
+    // controls, the keyboard shortcut, Mission Control).
+    base::RepeatingCallback<void(content::WebContents*)> exited_by_user;
+  };
+
+  VideoFullscreen(gfx::NativeWindow browser_window, Callbacks callbacks);
+  VideoFullscreen(const VideoFullscreen&) = delete;
+  VideoFullscreen& operator=(const VideoFullscreen&) = delete;
+  ~VideoFullscreen() override;
+
+  // Starts full screen for the active page `contents`. Returns false when it
+  // can't (the caller then uses the window's own full screen).
+  bool Begin(content::WebContents* contents);
+  // The page no longer wants full screen: shrink back and return the page.
+  void End();
+  // Entering, in or leaving video full screen.
+  bool IsActive() const { return state_ != State::kNone; }
+  // What `contents` should see while this runs (see
+  // ExclusiveAccessContext::GetTabFullscreenOverride()).
+  std::optional<bool> GetOverride(const content::WebContents* contents) const;
+  // Called before the browser window shows another active tab.
+  void ActivePageChanging(content::WebContents* contents);
+
+  // From the video window's full screen animator (AppKit's custom full
+  // screen transition, as in WebKit's WKFullScreenWindowController).
+  void StartEnterAnimation(double duration);
+  void StartExitAnimation(double duration);
+  gfx::NativeWindow browser_window() const { return browser_window_; }
+
+ private:
+  enum class State {
+    kNone,
+    kPreparing,  // Taking the page's picture; the page still sees no change.
+    kWindowed,   // The video window is shown over the element.
+    kEntering,   // Growing into full screen.
+    kFullscreen,
+    kExiting,    // Shrinking back over the element.
+    kReturning,  // Keeping its last frame, then returning the page.
+  };
+  struct ObjCStorage;
+
+  void OnSnapshot(NSImage* image);
+  void OnVideoDrawn();
+  void GoFullscreen();
+  void OnDidEnterFullScreen();
+  void OnWillExitFullScreen();
+  void OnDidExitFullScreen();
+  void ReturnPage();
+  void CaptureElementFrame(base::OnceClosure done);
+  // The video window is closing (e.g. Cmd+W): return the page now.
+  void OnWindowClosing();
+  // Puts the page back (`reattach`: into the browser window) and closes the
+  // video window. `fade` fades the still image out once the page has drawn.
+  void Finish(bool reattach, bool fade);
+  // Sends the page its (possibly overridden) full screen state.
+  void SyncPage(content::WebContents* contents = nullptr);
+
+  // content::WebContentsObserver:
+  void WebContentsDestroyed() override;
+
+  const gfx::NativeWindow browser_window_;
+  const Callbacks callbacks_;
+  State state_ = State::kNone;
+  bool end_requested_ = false;
+  bool finishing_ = false;
+  // The page's video rects before full screen (JSON; see Begin()).
+  std::string video_rects_;
+  bool window_closing_ = false;
+  std::unique_ptr<ObjCStorage> objc_;
+  std::unique_ptr<views::WidgetDelegate> widget_delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  base::WeakPtrFactory<VideoFullscreen> weak_factory_{this};
+};
+
+}  // namespace safarium
+
+#endif  // CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_VIDEO_FULLSCREEN_H_
