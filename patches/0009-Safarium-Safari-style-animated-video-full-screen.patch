+struct VideoFullscreen::ObjCStorage {
+  NSRect video_frame = NSZeroRect;  // The element on screen.
+  NSRect page_frame = NSZeroRect;   // Browser window's content view.
+  NSRect full_frame = NSZeroRect;   // The video window's (full screen).
+  NSRect hole = NSZeroRect;         // In the page, top-left based.
+  SafariumVideoPlaceholderView* placeholder;
+  SafariumVideoFullScreenAnimator* animator;
+  NSView* backdrop;  // Black, behind the page; fades in.
+  NSMutableArray<id>* observers = [NSMutableArray array];
+};
+
+VideoFullscreen::VideoFullscreen(gfx::NativeWindow browser_window,
+                                 Callbacks callbacks)
+    : browser_window_(browser_window),
+      callbacks_(std::move(callbacks)),
+      objc_(std::make_unique<ObjCStorage>()) {}
+
+VideoFullscreen::~VideoFullscreen() {
+  if (IsActive()) {
+    Finish(/*reattach=*/false, /*fade=*/false);
+  }
+  [objc_->placeholder removeFromSuperview];
+}
+
+bool VideoFullscreen::Begin(content::WebContents* contents) {
+  NSWindow* window = browser_window_.GetNativeNSWindow();
+  NSView* page = contents ? contents->GetNativeView().GetNativeNSView() : nil;
+  if (IsActive() || !window || !page || page.window != window ||
+      NSIsEmptyRect(page.bounds) || !window.visible || window.miniaturized) {
+    return false;
+  }
+
+  // The element's spot (the whole page if the page didn't say).
+  const NSRect page_bounds = page.bounds;
+  NSRect hole = NSMakeRect(0, 0, NSWidth(page_bounds), NSHeight(page_bounds));
+  if (std::optional<gfx::Rect> bounds =
+          TakeFullscreenElementBounds(contents)) {
+    const NSRect element = NSIntersectionRect(
+        NSMakeRect(bounds->x(), bounds->y(), bounds->width(),
+                   bounds->height()),
+        hole);
+    if (NSWidth(element) >= 40 && NSHeight(element) >= 30) {
+      hole = element;
+    }
+  }
+  NSRect in_page = hole;
+  if (!page.isFlipped) {
+    in_page.origin.y = NSHeight(page_bounds) - NSMaxY(hole);
+  }
+  objc_->hole = hole;
+  objc_->video_frame =
+      [window convertRectToScreen:[page convertRect:in_page toView:nil]];
+  objc_->page_frame = [window.contentView
+      convertRect:[page convertRect:page_bounds toView:nil]
+         fromView:nil];
+
+  state_ = State::kPreparing;
+  end_requested_ = false;
+  Observe(contents);
+
+  // Where the page's videos are now, to know when they are back after full
+  // screen.
+  video_rects_.clear();
+  contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      kVideoRectsScript,
+      base::BindOnce(
+          [](base::WeakPtr<VideoFullscreen> self, base::Value rects) {
+            if (self && rects.is_string()) {
+              self->video_rects_ = rects.GetString();
+            }
+          },
+          weak_factory_.GetWeakPtr()),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+
+  // The page as it is now, for the browser window while the page is away.
+  content::RenderWidgetHostView* view = contents->GetRenderWidgetHostView();
+  if (!view || !view->IsSurfaceAvailableForCopy()) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&VideoFullscreen::OnSnapshot,
+                                  weak_factory_.GetWeakPtr(),
+                                  static_cast<NSImage*>(nil)));
+    return true;
+  }
+  view->CopyFromSurface(
+      gfx::Rect(), gfx::Size(), base::Milliseconds(300),
+      base::BindOnce(
+          [](base::WeakPtr<VideoFullscreen> self, NSSize size,
+             const content::CopyFromSurfaceResult& result) {
+            if (self) {
+              self->OnSnapshot(ImageFromCopy(result, size));
+            }
+          },
+          weak_factory_.GetWeakPtr(), page_bounds.size));
+  return true;
+}
+
+void VideoFullscreen::OnSnapshot(NSImage* image) {
+  content::WebContents* contents = web_contents();
+  NSWindow* browser_window = browser_window_.GetNativeNSWindow();
+  if (state_ != State::kPreparing || !contents || !browser_window) {
+    return;
+  }
+
+  // The browser window keeps the page's picture (the element too, until its
+  // own window shows it).
+  SafariumVideoPlaceholderView* placeholder =
+      [[SafariumVideoPlaceholderView alloc] initWithFrame:objc_->page_frame];
+  placeholder.image = image;
+  placeholder.hole = objc_->hole;
+  [objc_->placeholder removeFromSuperview];
+  objc_->placeholder = placeholder;
+  [browser_window.contentView addSubview:placeholder
+                              positioned:NSWindowAbove
+                              relativeTo:nil];
+
+  // The page moves into a window of its own, exactly over the element.
+  callbacks_.set_page.Run(nullptr);
+  widget_delegate_ = std::make_unique<views::WidgetDelegate>();
+  widget_delegate_->SetCanFullscreen(true);
+  widget_delegate_->SetCanResize(true);
+  window_closing_ = false;
+  widget_delegate_->RegisterWindowClosingCallback(base::BindOnce(
+      &VideoFullscreen::OnWindowClosing, weak_factory_.GetWeakPtr()));
+  auto web_view =
+      std::make_unique<views::WebView>(contents->GetBrowserContext());
+  views::WebView* view =
+      widget_delegate_->SetContentsView(std::move(web_view));
+  widget_ = std::make_unique<views::Widget>();
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW);
+  params.delegate = widget_delegate_.get();
+  // The size of the full screen from the start, as WebKit does: the page
+  // lays out full screen once, and the transitions only zoom it.
+  NSScreen* screen = browser_window.screen ?: NSScreen.mainScreen;
+  const NSRect full_frame = FullScreenFrame(screen);
+  objc_->full_frame = full_frame;
+  params.bounds = gfx::ScreenRectFromNSRect(full_frame);
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.name = "SafariumVideoFullscreen";
+  widget_->Init(std::move(params));
+
+  NSWindow* window = widget_->GetNativeWindow().GetNativeNSWindow();
+  window.titleVisibility = NSWindowTitleHidden;
+  window.titlebarAppearsTransparent = YES;
+  window.styleMask |= NSWindowStyleMaskFullSizeContentView;
+  window.opaque = NO;
+  window.backgroundColor = NSColor.clearColor;
+  window.hasShadow = NO;
+  window.animationBehavior = NSWindowAnimationBehaviorNone;
+  window.ignoresMouseEvents = YES;  // Until it is full screen.
+  SetWindowButtonsHidden(window, YES);
+  [window setFrame:full_frame display:NO];
+  window.alphaValue = 0;  // Until the page has drawn in it.
+
+  // A black backdrop behind the page (outside the zoomed content view).
+  NSView* content = window.contentView;
+  NSView* backdrop = [[NSView alloc] initWithFrame:content.frame];
+  backdrop.wantsLayer = YES;
+  backdrop.layer.backgroundColor = NSColor.blackColor.CGColor;
+  backdrop.layer.opacity = 0;
+  backdrop.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  [content.superview addSubview:backdrop
+                     positioned:NSWindowBelow
+                     relativeTo:content];
+  objc_->backdrop = backdrop;
+
+  // The page, zoomed out to the element's spot and cropped to it.
+  ApplyInitialZoom(window, ZoomView(window), objc_->video_frame);
+  objc_->animator = [[SafariumVideoFullScreenAnimator alloc]
+      initWithOwner:weak_factory_.GetWeakPtr()];
+  ViewsNSWindowSetFullScreenAnimator(window, objc_->animator);
+
+  // The page now sees full screen, at the element's size: the element fills
+  // the window, where it was.
+  state_ = State::kWindowed;
+  view->SetWebContents(contents);
+  SyncPage();
+  contents->UpdateWebContentsVisibility(content::Visibility::VISIBLE);
+
+  // (Blocks copy the weak pointer and member function by value.)
+  const std::pair<NSNotificationName, void (VideoFullscreen::*)()> kEvents[] = {
+      {NSWindowDidEnterFullScreenNotification,
+       &VideoFullscreen::OnDidEnterFullScreen},
+      {NSWindowWillExitFullScreenNotification,
+       &VideoFullscreen::OnWillExitFullScreen},
+      {NSWindowDidExitFullScreenNotification,
+       &VideoFullscreen::OnDidExitFullScreen},
+  };
+  for (const auto& event : kEvents) {
+    base::WeakPtr<VideoFullscreen> weak = weak_factory_.GetWeakPtr();
+    void (VideoFullscreen::*fn)() = event.second;
+    [objc_->observers
+        addObject:[NSNotificationCenter.defaultCenter
+                      addObserverForName:event.first
+                                  object:window
+                                   queue:nil
+                              usingBlock:^(NSNotification*) {
+                                if (VideoFullscreen* self = weak.get()) {
+                                  (self->*fn)();
+                                }
+                              }]];
+  }
+
+  // Ordered in on whatever Space is showing (a full screen browser window's
+  // too), as WebKit does.
+  const NSWindowCollectionBehavior behavior = window.collectionBehavior;
+  window.collectionBehavior =
+      behavior | NSWindowCollectionBehaviorCanJoinAllSpaces;
+  widget_->Show();
+  window.collectionBehavior = behavior;
+  // Showing a window keeps it clear of the menu bar and the Dock; this one
+  // is the full screen's size from the start (as WebKit's is), so the page
+  // lays out once, at its final size.
+  [window setFrame:full_frame display:NO];
+  view->RequestFocus();
+  contents->Focus();
+  WhenDrawn(contents, base::BindOnce(&VideoFullscreen::OnVideoDrawn,
+                                     weak_factory_.GetWeakPtr()));
+}
+
+void VideoFullscreen::OnVideoDrawn() {
+  if (state_ != State::kWindowed || !widget_) {
+    return;
+  }
+  if (end_requested_) {
+    ReturnPage();
+    return;
+  }
+  // The element now shows in its own window, over its spot in the page.
+  NSWindow* window = widget_->GetNativeWindow().GetNativeNSWindow();
+  if (!NSEqualRects(window.frame, objc_->full_frame)) {
+    [window setFrame:objc_->full_frame display:NO];
+  }
+
+  ApplyInitialZoom(window, ZoomView(window), objc_->video_frame);
+  window.alphaValue = 1;
+  // Let that reach the screen before the transition starts.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&VideoFullscreen::GoFullscreen,
+                     weak_factory_.GetWeakPtr()),
+      base::Milliseconds(30));
+}
+
+void VideoFullscreen::GoFullscreen() {
+  if (state_ != State::kWindowed || !widget_) {
+    return;
+  }
+  if (end_requested_) {
+    ReturnPage();
+    return;
+  }
+  state_ = State::kEntering;
+  // The element lifts out of the page: its spot shows a fill.
+  objc_->placeholder.showsHole = YES;
+  objc_->placeholder.needsDisplay = YES;
+  widget_->SetFullscreen(true);
+}
+
+void VideoFullscreen::StartEnterAnimation(double duration) {
+  if (state_ != State::kEntering || !widget_) {
+    return;
+  }
+  // The live page zooms from the element's spot to the screen.
+  NSView* content = ZoomView(widget_->GetNativeWindow().GetNativeNSWindow());
+  CALayer* layer = content.layer;
+  CALayer* mask = layer.mask;
+  const NSRect bounds = content.bounds;
+  const CATransform3D from = layer.transform;
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  layer.transform = CATransform3DIdentity;
+  [layer addAnimation:Animation(@"transform",
+                                [NSValue valueWithCATransform3D:from],
+                                [NSValue valueWithCATransform3D:
+                                             CATransform3DIdentity],
+                                duration)
+               forKey:@"zoom"];
+  if (mask) {
+    [mask addAnimation:Animation(@"bounds", [NSValue valueWithRect:mask.bounds],
+                                 [NSValue valueWithRect:NSMakeRect(
+                                              0, 0, NSWidth(bounds),
+                                              NSHeight(bounds))],
+                                 duration)
+                forKey:@"bounds"];
+    [mask addAnimation:Animation(@"position",
+                                 [NSValue valueWithPoint:mask.position],
+                                 [NSValue valueWithPoint:NSMakePoint(
+                                              NSMidX(bounds), NSMidY(bounds))],
+                                 duration)
+                forKey:@"position"];
+  }
+  objc_->backdrop.layer.opacity = 1;
+  [objc_->backdrop.layer addAnimation:Animation(@"opacity", @0, @1, duration)
+                               forKey:@"fade"];
+  [CATransaction commit];
+}
+
+void VideoFullscreen::OnDidEnterFullScreen() {
+  if (state_ != State::kEntering) {
+    return;
+  }
+  state_ = State::kFullscreen;
+  NSWindow* window = widget_->GetNativeWindow().GetNativeNSWindow();
+  CALayer* layer = ZoomView(window).layer;
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  [layer removeAllAnimations];
+  [layer.mask removeAllAnimations];
+  layer.transform = CATransform3DIdentity;
+  layer.mask = nil;
+  [CATransaction commit];
+  window.ignoresMouseEvents = NO;
+  // In full screen the window controls show with the menu bar, as usual.
+  SetWindowButtonsHidden(window, NO);
+  callbacks_.state_changed.Run();
+  if (end_requested_) {
+    End();
+  }
+}
+
+void VideoFullscreen::OnWillExitFullScreen() {
+  if (state_ != State::kFullscreen) {
+    return;  // Our own End() (already kExiting).
+  }
+  // Left from the window itself: the page still shows full screen while it
+  // shrinks back; tell the browser to drop full screen.
+  state_ = State::kExiting;
+  SetWindowButtonsHidden(widget_->GetNativeWindow().GetNativeNSWindow(), YES);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<VideoFullscreen> self) {
+            if (self && self->web_contents()) {
+              self->callbacks_.exited_by_user.Run(self->web_contents());
+            }
+          },
+          weak_factory_.GetWeakPtr()));
+}
+
+void VideoFullscreen::StartExitAnimation(double duration) {
+  if (state_ != State::kExiting || !widget_) {
+    return;
+  }
+  // Where the element's spot is now (the browser window may have moved).
+  if (SafariumVideoPlaceholderView* placeholder = objc_->placeholder;
+      placeholder.window) {
+    objc_->video_frame = [placeholder.window
+        convertRectToScreen:[placeholder convertRect:objc_->hole toView:nil]];
+  }
+  NSWindow* window = widget_->GetNativeWindow().GetNativeNSWindow();
+  NSView* content = ZoomView(window);
+  CALayer* layer = content.layer;
+  const NSRect bounds = content.bounds;
+  const NSRect initial = [window convertRectFromScreen:objc_->video_frame];
+  const CATransform3D to = ZoomTransform(initial, bounds, layer);
+  CALayer* mask = [CALayer layer];
+  mask.backgroundColor = NSColor.blackColor.CGColor;
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  mask.frame = InscribedRectWithAspect(bounds, initial.size);
+  layer.mask = mask;
+  layer.transform = to;
+  [layer addAnimation:Animation(@"transform",
+                                [NSValue valueWithCATransform3D:
+                                             CATransform3DIdentity],
+                                [NSValue valueWithCATransform3D:to], duration)
+               forKey:@"zoom"];
+  [mask addAnimation:Animation(@"bounds",
+                               [NSValue valueWithRect:NSMakeRect(
+                                            0, 0, NSWidth(bounds),
+                                            NSHeight(bounds))],
+                               [NSValue valueWithRect:mask.bounds], duration)
+              forKey:@"bounds"];
+  [mask addAnimation:Animation(@"position",
+                               [NSValue valueWithPoint:NSMakePoint(
+                                            NSMidX(bounds), NSMidY(bounds))],
+                               [NSValue valueWithPoint:mask.position],
+                               duration)
+              forKey:@"position"];
+  objc_->backdrop.layer.opacity = 0;
+  [objc_->backdrop.layer addAnimation:Animation(@"opacity", @1, @0, duration)
+                               forKey:@"fade"];
+  [CATransaction commit];
+}
+
+void VideoFullscreen::OnDidExitFullScreen() {
+  if (state_ == State::kExiting) {
+    ReturnPage();
+  }
+}
+
+void VideoFullscreen::End() {
+  switch (state_) {
+    case State::kNone:
+    case State::kExiting:
+    case State::kReturning:
+      return;
+    case State::kPreparing:
+      // Nothing moved yet.
+      state_ = State::kNone;
+      Observe(nullptr);
+      [objc_->placeholder removeFromSuperview];
+      objc_->placeholder = nil;
+      return;
+    case State::kWindowed:
+    case State::kEntering:
+      // Return it once drawn, or shrink back once full screen.
+      end_requested_ = true;
+      return;
+    case State::kFullscreen:
+      // The current frame first: the video shrinks back as that picture, and
+      // its spot keeps showing it, so nothing steps back in time. (Copies
+      // made during the transition only complete after it.)
+      state_ = State::kExiting;
+      SetWindowButtonsHidden(widget_->GetNativeWindow().GetNativeNSWindow(),
+                             YES);
+      CaptureElementFrame(base::BindOnce(
+          [](base::WeakPtr<VideoFullscreen> self) {
+            if (self && self->state_ == State::kExiting && self->widget_) {
+              self->widget_->SetFullscreen(false);
+            }
+          },
+          weak_factory_.GetWeakPtr()));
+      return;
+  }
+}
+
+// Puts the page's current element frame into the element's spot.
+void VideoFullscreen::CaptureElementFrame(base::OnceClosure done) {
+  content::WebContents* contents = web_contents();
+  content::RenderWidgetHostView* view =
+      contents ? contents->GetRenderWidgetHostView() : nullptr;
+  if (!view || !view->IsSurfaceAvailableForCopy() || !widget_) {
+    std::move(done).Run();
+    return;
+  }
+  const NSSize size =
+      widget_->GetNativeWindow().GetNativeNSWindow().contentView.bounds.size;
+  view->CopyFromSurface(
+      gfx::Rect(), gfx::Size(), kLastFrameTimeout,
+      base::BindOnce(
+          [](base::WeakPtr<VideoFullscreen> self, NSSize size,
+             base::OnceClosure done,
+             const content::CopyFromSurfaceResult& result) {
+            if (!self) {
+              return;
+            }
+            NSImage* image = ImageFromCopy(result, size);
+            if (image && self->widget_) {
+              // Over the page, inside the zoomed layer (zoomed and cropped
+              // with it).
+              CALayer* zoomed =
+                  ZoomView(self->widget_->GetNativeWindow().GetNativeNSWindow())
+                      .layer;
+              CALayer* cover = [CALayer layer];
+              [CATransaction begin];
+              [CATransaction setDisableActions:YES];
+              cover.frame = zoomed.bounds;
+              cover.contents = image;
+              cover.contentsGravity = kCAGravityResize;
+              [zoomed addSublayer:cover];
+              [CATransaction commit];
+              // The element's part of it, for the spot.
+              const NSRect part = InscribedRectWithAspect(
+                  NSMakeRect(0, 0, size.width, size.height),
+                  self->objc_->hole.size);
+              self->objc_->placeholder.holeImage = image;
+              self->objc_->placeholder.holeSourceRect = part;
+              self->objc_->placeholder.needsDisplay = YES;
+            }
+            std::move(done).Run();
+          },
+          weak_factory_.GetWeakPtr(), size, std::move(done)));
+}
+
+// The window is back over the element's spot: keep its last frame in the
+// spot, then return the page to the browser window.
+void VideoFullscreen::ReturnPage() {
+  state_ = State::kReturning;
+  // Without a frame of the element, the page's picture of it.
+  objc_->placeholder.showsHole = objc_->placeholder.holeImage != nil;
+  objc_->placeholder.needsDisplay = YES;
+  Finish(/*reattach=*/true, /*fade=*/true);
+}
+
+void VideoFullscreen::OnWindowClosing() {
+  if (finishing_ || !widget_) {
+    return;  // Our own Finish() closes it.
+  }
+  window_closing_ = true;
+  content::WebContents* contents = web_contents();
+  if (contents && state_ != State::kExiting && state_ != State::kReturning) {
+    // The browser drops full screen first, while this still counts as full
+    // screen (End() does nothing in kReturning).
+    state_ = State::kReturning;
+    callbacks_.exited_by_user.Run(contents);
+  }
+  if (IsActive()) {
+    Finish(/*reattach=*/true, /*fade=*/false);
+  }
+}
+
+void VideoFullscreen::Finish(bool reattach, bool fade) {
+  base::AutoReset<bool> finishing(&finishing_, true);
+  content::WebContents* contents = web_contents();
+  state_ = State::kNone;
+  end_requested_ = false;
+  Observe(nullptr);
+  for (id observer in objc_->observers) {
+    [NSNotificationCenter.defaultCenter removeObserver:observer];
+  }
+  [objc_->observers removeAllObjects];
+
+  if (widget_) {
+    NSWindow* window = widget_->GetNativeWindow().GetNativeNSWindow();
+    ViewsNSWindowSetFullScreenAnimator(window, nil);
+    // Out of sight before the page leaves it (it would show black).
+    window.alphaValue = 0;
+    if (auto* view = static_cast<views::WebView*>(
+            widget_delegate_ ? widget_delegate_->GetContentsView() : nullptr)) {
+      view->SetWebContents(nullptr);
+    }
+    if (window_closing_) {
+      // Already closing: let it finish before deleting.
+      base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+          FROM_HERE, std::move(widget_));
+      base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+          FROM_HERE, std::move(widget_delegate_));
+    } else {
+      widget_->CloseNow();
+      widget_.reset();
+    }
+  }
+  widget_delegate_.reset();
+  window_closing_ = false;
+  objc_->animator = nil;
+  objc_->backdrop = nil;
+
+  // The page sees the end of full screen and returns to the browser window
+  // (unless another tab took its place meanwhile).
+  // (Back in the browser window first, so the page relayouts once, at its
+  // size there.)
+  if (contents) {
+    if (reattach && callbacks_.active_page.Run() == contents) {
+      callbacks_.set_page.Run(contents);
+      contents->Focus();
+    } else {
+      fade = false;
+    }
+    SyncPage(contents);
+  }
+
+  SafariumVideoPlaceholderView* placeholder = objc_->placeholder;
+  objc_->placeholder = nil;
+  if (!fade) {
+    [placeholder removeFromSuperview];
+  } else if (placeholder) {
+    // Once the page's videos are back in place and the page has drawn that
+    // in the browser window.
+    WhenVideosBack(contents->GetWeakPtr(), video_rects_,
+                  base::TimeTicks::Now() + kVideosFitTimeout,
+                  base::BindOnce(^{
+                    [NSAnimationContext
+                        runAnimationGroup:^(NSAnimationContext* context) {
+                          context.duration = kFadeDuration;
+                          placeholder.animator.alphaValue = 0;
+                        }
+                        completionHandler:^{
+                          [placeholder removeFromSuperview];
+                        }];
+                  }));
+  }
+  callbacks_.state_changed.Run();
+}
+
+std::optional<bool> VideoFullscreen::GetOverride(
+    const content::WebContents* contents) const {
+  if (state_ == State::kNone || contents != web_contents()) {
+    return std::nullopt;
+  }
+  // Held back until the page has left the browser window; kept full screen
+  // until the window has shrunk back.
+  return state_ != State::kPreparing;
+}
+
+void VideoFullscreen::ActivePageChanging(content::WebContents* contents) {
+  if (!IsActive()) {
+    return;
+  }
+  if (contents == web_contents()) {
+    // Back to the full screen page: return it to the browser window now.
+    Finish(/*reattach=*/false, /*fade=*/false);
+    return;
+  }
+  // Another tab shows in the browser window: no still image over it.
+  [objc_->placeholder removeFromSuperview];
+  objc_->placeholder = nil;
+}
+
+void VideoFullscreen::SyncPage(content::WebContents* contents) {
+  if (!contents) {
+    contents = web_contents();
+  }
+  if (contents) {
+    if (auto* view = contents->GetRenderWidgetHostView()) {
+      view->GetRenderWidgetHost()->SynchronizeVisualProperties();
+    }
+  }
+}
+
+void VideoFullscreen::WebContentsDestroyed() {
+  // Nothing to return: close the window without touching the page.
+  Observe(nullptr);
+  Finish(/*reattach=*/false, /*fade=*/false);
+}
