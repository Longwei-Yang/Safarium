+// Called as a tab enters full screen (after it became the exclusive access
+// tab) and as it returns to browser full screen.
+void WebUIBrowserExclusiveAccessContext::UpdateUIForTabFullscreen() {
+  WebUIBrowserWindow* window = WebUIBrowserWindow::FromBrowser(browser_);
+  ExclusiveAccessManager* manager = ExclusiveAccessManager::From(browser_);
+  if (!window || !manager) {
+    return;
+  }
+  if (manager->fullscreen_controller()->IsWindowFullscreenForTabOrPending()) {
+    if (!window->IsSafariumVideoFullscreenActive()) {
+      window->BeginSafariumVideoFullscreen(GetWebContentsForExclusiveAccess());
+    }
+  } else if (window->IsSafariumVideoFullscreenActive()) {
+    EndSafariumVideoFullscreen();
+  }
+}
+
+void WebUIBrowserExclusiveAccessContext::EndSafariumVideoFullscreen() {
+  WebUIBrowserWindow::FromBrowser(browser_)->EndSafariumVideoFullscreen();
+  // An Esc that ended it starts Chrome's press-and-hold timer (hold Esc to
+  // leave browser full screen); its key-up can get lost while the window
+  // animates out, which would then also take the browser window out of full
+  // screen. Release the hold once this key press is done.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<WebUIBrowserExclusiveAccessContext> self) {
+            ExclusiveAccessManager* manager =
+                self ? ExclusiveAccessManager::From(self->browser_) : nullptr;
+            if (!manager ||
+                !manager->esc_key_hold_timer_for_test().IsRunning()) {
+              return;
+            }
+            input::NativeWebKeyboardEvent key_up(
+                blink::WebInputEvent::Type::kKeyUp,
+                blink::WebInputEvent::kNoModifiers, base::TimeTicks::Now());
+            key_up.windows_key_code = ui::VKEY_ESCAPE;
+            manager->HandleUserKeyEvent(key_up);
+          },
+          weak_ptr_factory_.GetWeakPtr()));
+}
