new file mode 100644
index 0000000000..5a5344873d
--- /dev/null
+++ b/chrome/browser/ui/webui_browser/safarium_fullscreen_host.cc
@@ -0,0 +1,103 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui_browser/safarium_fullscreen_host.h"
+
+#include <memory>
+
+#include "base/time/time.h"
+#include "content/public/browser/global_routing_id.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "mojo/public/cpp/bindings/self_owned_associated_receiver.h"
+#include "ui/gfx/geometry/point_conversions.h"
+#include "ui/gfx/geometry/point_f.h"
+
+namespace safarium {
+
+namespace {
+
+// How long a reported position stays valid for the full screen request that
+// follows it.
+constexpr base::TimeDelta kRequestLifetime = base::Seconds(3);
+
+class FullscreenRequest
+    : public content::WebContentsUserData<FullscreenRequest> {
+ public:
+  ~FullscreenRequest() override = default;
+
+  gfx::Rect bounds;
+  base::TimeTicks time;
+
+ private:
+  friend class content::WebContentsUserData<FullscreenRequest>;
+  explicit FullscreenRequest(content::WebContents* contents)
+      : content::WebContentsUserData<FullscreenRequest>(*contents) {}
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(FullscreenRequest);
+
+class FullscreenHost : public blink::mojom::SafariumFullscreenHost {
+ public:
+  explicit FullscreenHost(content::GlobalRenderFrameHostId frame_id)
+      : frame_id_(frame_id) {}
+
+  void WillRequestFullscreen(const gfx::Rect& bounds) override {
+    content::RenderFrameHost* frame =
+        content::RenderFrameHost::FromID(frame_id_);
+    if (!frame) {
+      return;
+    }
+    content::WebContents* contents =
+        content::WebContents::FromRenderFrameHost(frame);
+    content::RenderWidgetHostView* view = frame->GetView();
+    if (!contents || !view) {
+      return;
+    }
+    // From the frame's local root widget (an out-of-process iframe has its
+    // own) to the page's view.
+    const gfx::PointF origin =
+        view->TransformPointToRootCoordSpaceF(gfx::PointF(bounds.origin()));
+    FullscreenRequest* request =
+        FullscreenRequest::GetOrCreateForWebContents(contents);
+    request->bounds =
+        gfx::Rect(gfx::ToRoundedPoint(origin), bounds.size());
+    request->time = base::TimeTicks::Now();
+  }
+
+ private:
+  const content::GlobalRenderFrameHostId frame_id_;
+};
+
+}  // namespace
+
+void BindFullscreenHost(
+    content::RenderFrameHost* frame,
+    mojo::PendingAssociatedReceiver<blink::mojom::SafariumFullscreenHost>
+        receiver) {
+  mojo::MakeSelfOwnedAssociatedReceiver(
+      std::make_unique<FullscreenHost>(frame->GetGlobalId()),
+      std::move(receiver));
+}
+
+std::optional<gfx::Rect> TakeFullscreenElementBounds(
+    content::WebContents* contents) {
+  FullscreenRequest* request = FullscreenRequest::FromWebContents(contents);
+  if (!request) {
+    return std::nullopt;
+  }
+  const gfx::Rect bounds = request->bounds;
+  const bool recent =
+      base::TimeTicks::Now() - request->time < kRequestLifetime;
+  contents->RemoveUserData(FullscreenRequest::UserDataKey());
+  if (!recent || bounds.IsEmpty()) {
+    return std::nullopt;
+  }
+  return bounds;
+}
+
+}  // namespace safarium
