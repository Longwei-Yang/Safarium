+// The page as it was. While the element is away, its spot shows a fill (or
+// its last frame, as it comes back).
+@interface SafariumVideoPlaceholderView : NSView
+@property(nonatomic, strong) NSImage* image;
+@property(nonatomic) NSRect hole;  // Top-left based, like the page.
+@property(nonatomic) BOOL showsHole;
+@property(nonatomic, strong) NSImage* holeImage;
+@property(nonatomic) NSRect holeSourceRect;  // Part of holeImage (or all).
+@end
+
+// Layers rather than -drawRect:, so the page's picture shows in the same frame
+// as the page leaves (a full page image draws slowly).
+@implementation SafariumVideoPlaceholderView {
+  CALayer* _holeLayer;
+}
+@synthesize image = _image;
+@synthesize hole = _hole;
+@synthesize showsHole = _showsHole;
+@synthesize holeImage = _holeImage;
+@synthesize holeSourceRect = _holeSourceRect;
+
+- (instancetype)initWithFrame:(NSRect)frame {
+  if ((self = [super initWithFrame:frame])) {
+    CALayer* root = [CALayer layer];
+    root.geometryFlipped = YES;  // Top-left based, like the page.
+    root.contentsGravity = kCAGravityResize;
+    _holeLayer = [CALayer layer];
+    _holeLayer.backgroundColor = NSColor.blackColor.CGColor;
+    _holeLayer.contentsGravity = kCAGravityResize;
+    _holeLayer.hidden = YES;
+    [root addSublayer:_holeLayer];
+    self.layer = root;
+    self.wantsLayer = YES;
+  }
+  return self;
+}
+
+- (BOOL)isFlipped {
+  return YES;
+}
+
+- (void)update:(void (^)(void))block {
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  block();
+  [CATransaction commit];
+}
+
+- (void)setImage:(NSImage*)image {
+  _image = image;
+  [self update:^{
+    self.layer.contents = image;
+  }];
+}
+
+- (void)setHole:(NSRect)hole {
+  _hole = hole;
+  CALayer* layer = _holeLayer;
+  [self update:^{
+    layer.frame = NSRectToCGRect(hole);
+  }];
+}
+
+- (void)setShowsHole:(BOOL)showsHole {
+  _showsHole = showsHole;
+  CALayer* layer = _holeLayer;
+  [self update:^{
+    layer.hidden = !showsHole;
+  }];
+}
+
+- (void)setHoleImage:(NSImage*)holeImage {
+  _holeImage = holeImage;
+  [self updateHoleContents];
+}
+
+- (void)setHoleSourceRect:(NSRect)rect {
+  _holeSourceRect = rect;
+  [self updateHoleContents];
+}
+
+- (void)updateHoleContents {
+  NSImage* image = _holeImage;
+  CGRect unit = CGRectMake(0, 0, 1, 1);
+  if (image && !NSIsEmptyRect(_holeSourceRect)) {
+    const NSSize size = image.size;
+    unit = CGRectMake(NSMinX(_holeSourceRect) / size.width,
+                      NSMinY(_holeSourceRect) / size.height,
+                      NSWidth(_holeSourceRect) / size.width,
+                      NSHeight(_holeSourceRect) / size.height);
+  }
+  CALayer* layer = _holeLayer;
+  [self update:^{
+    layer.contents = image;
+    layer.contentsRect = unit;
+  }];
+}
+@end
