+// If the page can't be asked whether it has drawn.
+constexpr base::TimeDelta kDrawFallback = base::Milliseconds(150);
+constexpr base::TimeDelta kDrawTimeout = base::Milliseconds(500);
+constexpr base::TimeDelta kLastFrameTimeout = base::Milliseconds(150);
+constexpr NSTimeInterval kFadeDuration = 0.15;
+// Extra time for the page to draw a current frame back in the browser window
+// (the first one there can still be from before full screen).
+constexpr base::TimeDelta kReturnSettle = base::Milliseconds(150);
+// How long to wait for the page's videos to fit the element's spot again.
+constexpr base::TimeDelta kVideosFitTimeout = base::Milliseconds(1500);
+
+// Where the page's videos are (JSON [[x, y, width, height], ...]).
+constexpr char16_t kVideoRectsScript[] =
+    u"JSON.stringify([...document.querySelectorAll('video')].map(v => {"
+    u"  const r = v.getBoundingClientRect();"
+    u"  return [r.x, r.y, r.width, r.height].map(Math.round);"
+    u"}))";
+constexpr base::TimeDelta kVideosFitPoll = base::Milliseconds(50);
+
+void SetWindowButtonsHidden(NSWindow* window, BOOL hidden) {
+  for (NSWindowButton kind :
+       {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+    [window standardWindowButton:kind].hidden = hidden;
+  }
+}
+
+// Runs `done` once `contents` has drawn a frame at its current size (a copy
+// of its surface completes then), or after a short wait.
+void WhenDrawn(content::WebContents* contents,
+               base::OnceClosure done,
+               base::TimeDelta settle = base::TimeDelta()) {
+  if (settle.is_positive()) {
+    done = base::BindOnce(
+        [](base::OnceClosure done, base::TimeDelta settle) {
+          base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+              FROM_HERE, std::move(done), settle);
+        },
+        std::move(done), settle);
+  }
+  content::RenderWidgetHostView* view =
+      contents ? contents->GetRenderWidgetHostView() : nullptr;
+  if (!view || !view->IsSurfaceAvailableForCopy()) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, std::move(done), kDrawFallback);
+    return;
+  }
+  view->CopyFromSurface(
+      gfx::Rect(), gfx::Size(1, 1), kDrawTimeout,
+      base::BindOnce(
+          [](base::OnceClosure done, const content::CopyFromSurfaceResult&) {
+            std::move(done).Run();
+          },
+          std::move(done)));
+}
+
+// Runs `done` once the page's videos are back where they were before full
+// screen (`video_rects`, from kVideoRectsScript; sites such as YouTube resize
+// theirs with script, in steps, after full screen ends) and the page has
+// drawn that, or by `deadline`.
+void WhenVideosBack(base::WeakPtr<content::WebContents> contents,
+                    std::string video_rects,
+                    base::TimeTicks deadline,
+                    base::OnceClosure done) {
+  if (!contents) {
+    std::move(done).Run();
+    return;
+  }
+  if (video_rects.empty() || base::TimeTicks::Now() >= deadline) {
+    WhenDrawn(contents.get(), std::move(done), kReturnSettle);
+    return;
+  }
+  const std::u16string script =
+      u"(() => {"
+      u"  if (document.fullscreenElement) return false;"
+      u"  const before = " + base::UTF8ToUTF16(video_rects) + u";"
+      u"  const now = JSON.parse(" + std::u16string(kVideoRectsScript) + u");"
+      u"  const ok = now.length === before.length && now.every((r, i) =>"
+      u"      r.every((v, j) => Math.abs(v - before[i][j]) <= 4));"
+      u"  return ok;"
+      u"})()";
+  contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      script,
+      base::BindOnce(
+          [](base::WeakPtr<content::WebContents> contents,
+             std::string video_rects, base::TimeTicks deadline,
+             base::OnceClosure done, base::Value back) {
+            if (contents && back.is_bool() && back.GetBool()) {
+              WhenDrawn(contents.get(), std::move(done), kReturnSettle);
+              return;
+            }
+            base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+                FROM_HERE,
+                base::BindOnce(&WhenVideosBack, contents,
+                               std::move(video_rects), deadline,
+                               std::move(done)),
+                kVideosFitPoll);
+          },
+          contents, std::move(video_rects), deadline, std::move(done)),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+NSImage* ImageFromCopy(const content::CopyFromSurfaceResult& result,
+                       NSSize size) {
+  if (!result.has_value() || result->bitmap.drawsNothing()) {
+    return nil;
+  }
+  NSImage* image = skia::SkBitmapToNSImage(result->bitmap);
+  image.size = size;
+  return image;
+}
+
+// The window's frame in full screen (below a notch, if any).
+NSRect FullScreenFrame(NSScreen* screen) {
+  NSRect frame = screen.frame;
+  if (@available(macOS 12.0, *)) {
+    // With a notch, full screen windows sit just below the notch's band
+    // (measured on macOS 27: 1pt below the safe area's top inset).
+    if (screen.safeAreaInsets.top > 0) {
+      frame.size.height =
+          std::floor(frame.size.height - screen.safeAreaInsets.top - 1);
+    }
+  }
+  return frame;
+}
+
+// WebKit's timing for full screen zooms.
+CAMediaTimingFunction* TimingFunction(double duration) {
+  return duration >= 0.8
+             ? [CAMediaTimingFunction
+                   functionWithName:kCAMediaTimingFunctionEaseInEaseOut]
+             : [CAMediaTimingFunction functionWithControlPoints:0.25:0:0:1];
+}
+
+// The smallest rect with `aspect` around `rect` (centered).
+NSRect EnclosingRectWithAspect(NSRect rect, NSSize aspect) {
+  const CGFloat ratio = aspect.width / aspect.height;
+  NSSize size = rect.size;
+  if (size.width / size.height > ratio) {
+    size.height = size.width / ratio;
+  } else {
+    size.width = size.height * ratio;
+  }
+  return NSMakeRect(NSMidX(rect) - size.width / 2,
+                    NSMidY(rect) - size.height / 2, size.width, size.height);
+}
+
+// The largest rect with `aspect` inside `bounds` (centered).
+NSRect InscribedRectWithAspect(NSRect bounds, NSSize aspect) {
+  const CGFloat ratio = aspect.width / aspect.height;
+  NSSize size = bounds.size;
+  if (size.width / size.height > ratio) {
+    size.width = size.height * ratio;
+  } else {
+    size.height = size.width / ratio;
+  }
+  return NSMakeRect(NSMidX(bounds) - size.width / 2,
+                    NSMidY(bounds) - size.height / 2, size.width, size.height);
+}
+
+// Zooms `layer` (the full screen page, `bounds`, in its window's coordinates)
+// out so that its element part sits at `initial` (window coordinates), as
+// WebKit does: the page stays laid out full screen while it animates.
+CATransform3D ZoomTransform(NSRect initial, NSRect bounds, CALayer* layer) {
+  if (layer.geometryFlipped) {
+    initial.origin.y = NSHeight(bounds) - NSMaxY(initial);
+  }
+  const NSRect scaled = EnclosingRectWithAspect(initial, bounds.size);
+  const CGFloat scale = NSWidth(scaled) / NSWidth(bounds);
+  // Layer transforms apply around the anchor point.
+  const CGPoint anchor = CGPointMake(layer.anchorPoint.x * NSWidth(bounds),
+                                     layer.anchorPoint.y * NSHeight(bounds));
+  return CATransform3DScale(
+      CATransform3DMakeTranslation(NSMinX(scaled) - (1 - scale) * anchor.x,
+                                   NSMinY(scaled) - (1 - scale) * anchor.y, 0),
+      scale, scale, 1);
+}
+
+// The layer to zoom: views' compositor layer (it draws the page) rather than
+// the content view's own layer, which AppKit manages and resets.
+NSView* ZoomView(NSWindow* window) {
+  for (NSView* view in window.contentView.subviews) {
+    if ([NSStringFromClass(view.class) isEqualToString:
+                                           @"ViewsCompositorSuperview"]) {
+      return view;
+    }
+  }
+  return window.contentView;
+}
+
+// Zooms `view` out to `initial` (screen) and crops it to the element.
+void ApplyInitialZoom(NSWindow* window, NSView* view, NSRect initial_screen) {
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  const NSRect initial = [window convertRectFromScreen:initial_screen];
+  view.layer.transform = ZoomTransform(initial, view.bounds, view.layer);
+  CALayer* mask = [CALayer layer];
+  mask.backgroundColor = NSColor.blackColor.CGColor;
+  mask.frame = InscribedRectWithAspect(view.bounds, initial.size);
+  view.layer.mask = mask;
+  [CATransaction commit];
+}
+
+CABasicAnimation* Animation(NSString* key_path,
+                            id from,
+                            id to,
+                            double duration) {
+  CABasicAnimation* animation =
+      [CABasicAnimation animationWithKeyPath:key_path];
+  animation.fromValue = from;
+  animation.toValue = to;
+  animation.duration = duration;
+  animation.timingFunction = TimingFunction(duration);
+  animation.fillMode = kCAFillModeBoth;
+  animation.removedOnCompletion = NO;
+  return animation;
+}
