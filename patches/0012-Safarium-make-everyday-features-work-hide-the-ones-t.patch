+  AddressFieldAnchor(SafariumTabBarView* tab_view, views::View* page_view)
+      : tab_view_(tab_view), page_view_(page_view) {
+    SetProperty(views::kElementIdentifierKey, kLocationBarElementId);
+    SetCanProcessEventsWithinSubtree(false);
+  }
+  AddressFieldAnchor(const AddressFieldAnchor&) = delete;
+  AddressFieldAnchor& operator=(const AddressFieldAnchor&) = delete;
+  ~AddressFieldAnchor() override = default;
+
+  gfx::Rect GetAnchorBoundsInScreen() const override {
+    gfx::Rect bounds = [tab_view_ addressFieldScreenBounds];
+    if (bounds.IsEmpty()) {
+      // Toolbar hidden (e.g. full screen): the top center of the page.
+      if (const views::View* page = page_view_.view()) {
+        const gfx::Rect page_bounds = page->GetBoundsInScreen();
+        bounds = gfx::Rect(page_bounds.CenterPoint().x(), page_bounds.y(), 1,
+                           1);
+      }
+    }
+    return bounds;
+  }
+
+ private:
+  SafariumTabBarView* __weak tab_view_;
+  views::ViewTracker page_view_;
+};
