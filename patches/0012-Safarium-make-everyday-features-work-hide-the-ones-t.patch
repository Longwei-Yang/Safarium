+#ifndef CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_BUBBLE_ANCHORS_H_
+#define CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_BUBBLE_ANCHORS_H_
+
+#include "base/memory/raw_ref.h"
+#include "chrome/browser/ui/views/frame/toolbar_button_provider.h"
+
+class BrowserWindowInterface;
+
+namespace safarium {
+
+// Safarium has no Views toolbar. Chrome's page bubbles that would point at a
+// toolbar or omnibox icon (save address, save card, ...) point at the address
+// field instead (the kLocationBarElementId element), else at the page. It is
+// registered as the browser's ToolbarButtonProvider; only the anchor queries
+// are meaningful (callers handle the null buttons/containers).
+class BubbleAnchors final : public ToolbarButtonProvider {
+ public:
+  explicit BubbleAnchors(BrowserWindowInterface& browser);
+  BubbleAnchors(const BubbleAnchors&) = delete;
+  BubbleAnchors& operator=(const BubbleAnchors&) = delete;
+  ~BubbleAnchors() override;
+
+  // ToolbarButtonProvider:
+  ExtensionsContainerViews* GetExtensionsContainerViews() override;
+  PinnedToolbarActions* GetPinnedToolbarActions() override;
