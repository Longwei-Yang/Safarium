+namespace safarium {
+
+BubbleAnchors::BubbleAnchors(BrowserWindowInterface& browser)
+    : browser_(browser),
+      scoped_user_data_(browser.GetUnownedUserDataHost(), *this) {}
+
+BubbleAnchors::~BubbleAnchors() = default;
+
+views::BubbleAnchor BubbleAnchors::GetAnchor() {
+  BrowserElements* elements = BrowserElements::From(&browser_.get());
+  if (!elements) {
+    return views::BubbleAnchor();
+  }
+  for (ui::ElementIdentifier id :
+       {kLocationBarElementId, kContentsContainerViewElementId}) {
+    if (ui::TrackedElement* element = elements->GetElement(id)) {
+      return views::BubbleAnchor(element);
+    }
+  }
+  return views::BubbleAnchor();
+}
+
+ExtensionsContainerViews* BubbleAnchors::GetExtensionsContainerViews() {
