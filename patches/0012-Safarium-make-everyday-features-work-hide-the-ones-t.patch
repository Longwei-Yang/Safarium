+// The window's handler (registered as user data on the browser, which also
+// covers windows without a BrowserView such as the WebUI browser).
+AutofillBubbleHandler* GetBubbleHandler(content::WebContents* web_contents) {
+  if (tabs::TabInterface* tab =
+          tabs::TabInterface::MaybeGetFromContents(web_contents)) {
+    if (BrowserWindowInterface* browser = tab->GetBrowserWindowInterface()) {
+      if (AutofillBubbleHandler* handler =
+              AutofillBubbleHandler::Get(browser->GetUnownedUserDataHost())) {
+        return handler;
+      }
+    }
+  }
+  return BrowserWindow::FindBrowserWindowWithWebContents(web_contents)
+      ->GetAutofillBubbleHandler();
+}
