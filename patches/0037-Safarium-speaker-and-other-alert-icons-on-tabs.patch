+void TabBarController::UpdateAlertSubscriptions() {
+  TabStripModel* model = browser_->GetTabStripModel();
+  std::map<int64_t, base::CallbackListSubscription> kept;
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(i);
+    const int64_t id = tab->GetHandle().raw_value();
+    if (auto it = alert_subscriptions_.find(id);
+        it != alert_subscriptions_.end()) {
+      kept.emplace(id, std::move(it->second));
+      continue;
+    }
+    if (auto* alerts = tabs::TabAlertController::From(tab)) {
+      kept.emplace(id, alerts->AddAlertToShowChangedCallback(
+                           base::BindRepeating(
+                               [](TabBarController* self,
+                                  std::optional<tabs::TabAlert>) {
+                                 self->PushState();
+                               },
+                               base::Unretained(this))));
+    }
+  }
+  alert_subscriptions_ = std::move(kept);
+}
+
 void TabBarController::PushState() {
   if (wants_thumbnails_) {
     UpdateThumbnailSubscriptions();
   }
+  UpdateAlertSubscriptions();
   // Track the active tab for load progress.
   content::WebContents* active =
       browser_->GetTabStripModel()->GetActiveWebContents();
