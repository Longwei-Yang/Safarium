+// Chrome's tab alert (TabAlertController) drawn the Safari way: an SF Symbol
+// and tint. Returns nil for alerts Safarium has no use for (Gemini, AI
+// features, which are switched off).
+NSString* AlertSymbol(tabs::TabAlert alert) {
+  switch (alert) {
+    case tabs::TabAlert::kAudioPlaying:
+      return @"speaker.wave.2.fill";
+    case tabs::TabAlert::kAudioMuting:
+      return @"speaker.slash.fill";
+    case tabs::TabAlert::kMediaRecording:
+    case tabs::TabAlert::kVideoRecording:
+      return @"video.fill";
+    case tabs::TabAlert::kAudioRecording:
+      return @"mic.fill";
+    case tabs::TabAlert::kTabCapturing:
+    case tabs::TabAlert::kDesktopCapturing:
+      return @"rectangle.on.rectangle";
+    case tabs::TabAlert::kPipPlaying:
+      return @"pip";
+    case tabs::TabAlert::kBluetoothConnected:
+    case tabs::TabAlert::kBluetoothScanActive:
+      return @"antenna.radiowaves.left.and.right";
+    case tabs::TabAlert::kUsbConnected:
+    case tabs::TabAlert::kHidConnected:
+    case tabs::TabAlert::kSerialConnected:
+      return @"cable.connector";
+    case tabs::TabAlert::kVrPresentingInHeadset:
+      return @"eyeglasses";
+    default:
+      return nil;
+  }
+}
+
+// Capture (camera, microphone, screen) is red, as macOS marks it; the rest
+// match the other tab icons.
+NSColor* AlertTint(tabs::TabAlert alert) {
+  switch (alert) {
+    case tabs::TabAlert::kMediaRecording:
+    case tabs::TabAlert::kVideoRecording:
+    case tabs::TabAlert::kAudioRecording:
+    case tabs::TabAlert::kTabCapturing:
+    case tabs::TabAlert::kDesktopCapturing:
+      return NSColor.systemRedColor;
+    default:
+      return NSColor.secondaryLabelColor;
+  }
+}
+
+bool AlertTogglesMute(tabs::TabAlert alert) {
+  return alert == tabs::TabAlert::kAudioPlaying ||
+         alert == tabs::TabAlert::kAudioMuting;
+}
