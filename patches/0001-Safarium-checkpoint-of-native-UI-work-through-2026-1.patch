+
+namespace safarium {
+
+namespace {
+
+bool IsNewTabPage(const GURL& url) {
+  return url.SchemeIs(content::kChromeUIScheme) &&
+         (url.host() == chrome::kChromeUINewTabHost ||
+          url.host() == chrome::kChromeUINewTabPageHost);
+}
+
+// The picker runs in an isolated world and keeps its changes on this document.
+constexpr char16_t kStartPageItemPicker[] = uR"JS(
+(() => {
+  if (!globalThis.safariumPageItemPicker) {
+    const hidden = new Map();
+    let selection;
+
+    const restore = element => {
+      const [value, priority] = hidden.get(element);
+      if (value)
+        element.style.setProperty('display', value, priority);
+      else
+        element.style.removeProperty('display');
+      hidden.delete(element);
+    };
+
+    const stop = cancel => {
+      if (!selection)
+        return;
+      const {controller, host, changes} = selection;
+      selection = undefined;
+      controller.abort();
+      host.remove();
+      if (cancel)
+        changes.forEach(restore);
+    };
+
+    globalThis.safariumPageItemPicker = {
+      restore() {
+        stop(false);
+        for (const element of hidden.keys())
+          restore(element);
+      },
+      start() {
+        if (selection || !document.body)
+          return;
+
+        const host = document.createElement('div');
+        const shadow = host.attachShadow({mode: 'closed'});
+        const panel = document.createElement('div');
+        const outline = document.createElement('div');
+        Object.assign(panel.style, {
+          position: 'fixed', right: '16px', top: '16px',
+          zIndex: '2147483647', display: 'flex', gap: '8px',
+          alignItems: 'center', padding: '8px 12px',
+          borderRadius: '10px', boxShadow: '0 2px 12px #0004',
+          color: 'CanvasText', background: 'Canvas',
+          font: '13px system-ui', colorScheme: 'light dark',
+        });
+        Object.assign(outline.style, {
+          position: 'fixed', display: 'none', pointerEvents: 'none',
+          boxSizing: 'border-box', border: '2px solid #0A84FF',
+          borderRadius: '4px', background: '#0A84FF22',
+          zIndex: '2147483646',
+        });
+        panel.append('Click an item to hide it');
+        for (const [label, cancel] of [['Cancel', true], ['Done', false]]) {
+          const button = document.createElement('button');
+          button.textContent = label;
+          button.addEventListener('click', () => stop(cancel));
+          panel.append(button);
+        }
+        shadow.append(panel, outline);
+        document.documentElement.append(host);
+
+        const controller = new AbortController();
+        const changes = [];
+        selection = {controller, host, changes};
+        const options = {capture: true, signal: controller.signal};
+        const getItem = event => {
+          const path = event.composedPath();
+          if (path.includes(host))
+            return null;
+          const item = path.find(node => node instanceof HTMLElement);
+          return item && item !== document.body &&
+                 item !== document.documentElement ? item : null;
+        };
+        const block = event => {
+          event.preventDefault();
+          event.stopImmediatePropagation();
+        };
+        addEventListener('pointermove', event => {
+          const item = getItem(event);
+          if (!item) {
+            outline.style.display = 'none';
+            return;
+          }
+          const {x, y, width, height} = item.getBoundingClientRect();
+          Object.assign(outline.style, {
+            display: 'block', left: x + 'px', top: y + 'px',
+            width: width + 'px', height: height + 'px',
+          });
+        }, options);
+        addEventListener('scroll', () => {
+          outline.style.display = 'none';
+        }, options);
+        for (const type of ['pointerdown', 'pointerup', 'contextmenu']) {
+          addEventListener(type, event => {
+            if (getItem(event))
+              block(event);
+          }, options);
+        }
+        addEventListener('click', event => {
+          const item = getItem(event);
+          if (!item || event.button !== 0)
+            return;
+          block(event);
+          hidden.set(item, [item.style.getPropertyValue('display'),
+                            item.style.getPropertyPriority('display')]);
+          item.style.setProperty('display', 'none', 'important');
+          changes.push(item);
+          outline.style.display = 'none';
+        }, options);
+        addEventListener('keydown', event => {
+          if (event.key === 'Escape') {
+            block(event);
+            stop(true);
+          }
+        }, options);
+      },
+    };
+  }
+  globalThis.safariumPageItemPicker.start();
+})();
+)JS";
+
+}  // namespace
+
+TabBarController::TabBarController(
+    BrowserWindowInterface* browser,
+    base::WeakPtr<WebUIToolbarExtensionsContainer> extensions)
+    : browser_(browser), extensions_(std::move(extensions)) {
+  browser_->GetTabStripModel()->AddObserver(this);
+}
+
+TabBarController::~TabBarController() = default;
+
+void TabBarController::SetView(TabBarView* view) {
+  view_ = view;
+  PushState();
+}
+
+BarState TabBarController::BuildState() const {
+  BarState state;
+  TabStripModel* model = browser_->GetTabStripModel();
+  state.active_index = model->active_index();
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* contents = model->GetWebContentsAt(i);
+    TabItem item;
+    const GURL url = contents->GetVisibleURL();
+    item.title = contents->GetTitle();
+    item.active = (i == state.active_index);
+    item.loading = contents->IsLoading();
+    if (IsNewTabPage(url) || url.is_empty() || url.IsAboutBlank()) {
+      item.display_url = std::u16string();
+      item.edit_url = std::u16string();
+      if (item.title.empty() || IsNewTabPage(url)) {
+        item.title = u"New Tab";
+      }
+    } else {
+      item.display_url = url_formatter::FormatUrl(
+          url.has_host() ? url.GetWithEmptyPath() : url,
+          url_formatter::kFormatUrlOmitDefaults |
+              url_formatter::kFormatUrlOmitTrivialSubdomains |
+              url_formatter::kFormatUrlOmitHTTPS |
+              url_formatter::kFormatUrlOmitTrailingSlashOnBareHostname,
+          base::UnescapeRule::SPACES, nullptr, nullptr, nullptr);
+      // Like Safari: "https://www.google.com" keeps its scheme while editing,
+      // "http://" is dropped, and so is the trailing slash of a bare host.
+      item.edit_url = url_formatter::FormatUrl(url);
+      if (item.title.empty()) {
+        item.title = item.display_url;
+      }
+    }
+    item.pinned = model->IsTabPinned(i);
+    item.id = model->GetTabAtIndex(i)->GetHandle().raw_value();
+    if (auto* favicon_driver =
+            favicon::ContentFaviconDriver::FromWebContents(contents)) {
+      item.favicon = favicon_driver->GetFavicon();
+    }
+    // Search results page: show the query, like Safari.
+    if (TemplateURLService* template_urls =
+            TemplateURLServiceFactory::GetForProfile(browser_->GetProfile())) {
+      if (template_urls->IsSearchResultsPageFromDefaultSearchProvider(url)) {
+        if (auto metadata = template_urls->ExtractSearchMetadata(url);
+            metadata && !metadata->search_terms.empty()) {
+          item.display_url = metadata->search_terms;
+          item.is_search = true;
+        }
+      }
+    }
+    if (item.active) {
+      state.is_loading = item.loading;
+      state.load_progress = contents->GetLoadProgress();
+      state.can_go_back = contents->GetController().CanGoBack();
+      state.can_go_forward = contents->GetController().CanGoForward();
+    }
+    state.tabs.push_back(std::move(item));
+  }
+  return state;
+}
+
+void TabBarController::SetWantsThumbnails(bool wants) {
+  if (wants_thumbnails_ == wants) {
+    return;
+  }
+  wants_thumbnails_ = wants;
+  UpdateThumbnailSubscriptions();
+}
+
+void TabBarController::CaptureActiveTab(
+    base::OnceCallback<void(gfx::ImageSkia)> callback) {
+  content::WebContents* contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  content::RenderWidgetHostView* view =
+      contents ? contents->GetRenderWidgetHostView() : nullptr;
+  if (!view || !view->IsSurfaceAvailableForCopy()) {
+    std::move(callback).Run(gfx::ImageSkia());
+    return;
+  }
+  view->CopyFromSurface(
+      gfx::Rect(), gfx::Size(), base::Milliseconds(300),
+      base::BindOnce(
+          [](base::OnceCallback<void(gfx::ImageSkia)> callback,
+             const content::CopyFromSurfaceResult& result) {
+            if (!result.has_value() || result->bitmap.drawsNothing()) {
+              std::move(callback).Run(gfx::ImageSkia());
+              return;
+            }
+            std::move(callback).Run(
+                gfx::ImageSkia::CreateFrom1xBitmap(result->bitmap));
+          },
+          std::move(callback)));
+}
+
+void TabBarController::UpdateThumbnailSubscriptions() {
+  if (!wants_thumbnails_) {
+    thumbnail_subscriptions_.clear();
+    return;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  content::WebContents* active = model->GetActiveWebContents();
+  const gfx::Size viewport = active ? active->GetSize() : gfx::Size();
+  std::map<int64_t, std::unique_ptr<ThumbnailImage::Subscription>> kept;
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(i);
+    const int64_t id = tab->GetHandle().raw_value();
+    auto it = thumbnail_subscriptions_.find(id);
+    if (it != thumbnail_subscriptions_.end()) {
+      kept[id] = std::move(it->second);
+      continue;
+    }
+    ThumbnailTabHelper* helper = ThumbnailTabHelper::From(tab);
+    if (!helper || !helper->thumbnail()) {
+      continue;
+    }
+    // The native window only attaches the active tab to its WebView. Give
+    // never-attached tabs a viewport so Chromium's background thumbnail
+    // capturer can start without selecting the tab.
+    content::WebContents* contents = tab->GetContents();
+    if (contents != active && !contents->WasDiscarded() &&
+        contents->GetSize().IsEmpty() && !viewport.IsEmpty()) {
+      contents->Resize(gfx::Rect(viewport));
+    }
+    scoped_refptr<ThumbnailImage> thumbnail = helper->thumbnail();
+    std::unique_ptr<ThumbnailImage::Subscription> subscription =
+        thumbnail->Subscribe();
+    subscription->SetUncompressedImageCallback(
+        base::BindRepeating(&TabBarController::OnThumbnail,
+                            weak_factory_.GetWeakPtr(), id));
+    kept[id] = std::move(subscription);
+    thumbnail->RequestThumbnailImage();
+  }
+  thumbnail_subscriptions_ = std::move(kept);
+}
+
+void TabBarController::OnThumbnail(int64_t tab_id, gfx::ImageSkia image) {
+  if (view_) {
+    view_->ThumbnailChanged(tab_id, image);
+  }
+}
+
+void TabBarController::PushState() {
+  if (wants_thumbnails_) {
+    UpdateThumbnailSubscriptions();
+  }
+  // Track the active tab for load progress.
+  content::WebContents* active =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (web_contents() != active) {
+    Observe(active);
+  }
+  if (view_) {
+    view_->UpdateState(BuildState());
+  }
+}
+
+void TabBarController::ActivateTab(int index) {
+  TabStripModel* model = browser_->GetTabStripModel();
+  if (model->ContainsIndex(index)) {
+    model->ActivateTabAt(index,
+                         TabStripUserGestureDetails(
+                             TabStripUserGestureDetails::GestureType::kMouse));
+  }
+}
+
+void TabBarController::CloseTab(int index) {
+  TabStripModel* model = browser_->GetTabStripModel();
+  if (model->ContainsIndex(index)) {
+    model->CloseWebContentsAt(
+        index, TabCloseTypes::CLOSE_USER_GESTURE |
+                   TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  }
+}
+
+void TabBarController::MoveTab(int from, int to) {
+  TabStripModel* model = browser_->GetTabStripModel();
+  if (model->ContainsIndex(from) && model->ContainsIndex(to) && from != to) {
+    model->MoveWebContentsAt(from, to, /*select_after_move=*/false);
+  }
+}
+
+void TabBarController::ExecuteCommand(int command_id) {
+  chrome::ExecuteCommand(browser_, command_id);
+}
+
+WebUIToolbarExtensionsContainer* TabBarController::GetExtensionsContainer()
+    const {
+  return extensions_.get();
+}
+
+bool TabBarController::IsCommandEnabled(int command_id) const {
+  return chrome::IsCommandEnabled(browser_, command_id);
+}
+
+Profile* TabBarController::GetProfile() const {
+  return browser_->GetProfile();
+}
+
+int TabBarController::ActiveZoomPercent() const {
+  content::WebContents* contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  auto* controller =
+      contents ? zoom::ZoomController::FromWebContents(contents) : nullptr;
+  return controller ? controller->GetZoomPercent() : 100;
+}
+
+void TabBarController::ShowActiveSiteSettings() {
+  const GURL url = ActiveURL();
+  if (url.SchemeIsHTTPOrHTTPS()) {
+    chrome::ShowSiteSettings(browser_, url);
+  }
+}
+
+void TabBarController::HideDistractingItems() {
+  content::WebContents* contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (contents && contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS() &&
+      contents->GetPrimaryMainFrame()->IsRenderFrameLive()) {
+    contents->Focus();
+    contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+        kStartPageItemPicker, {}, ISOLATED_WORLD_ID_CHROME_INTERNAL);
+  }
+}
+
+void TabBarController::ShowHiddenItems() {
+  content::WebContents* contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (contents && contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS() &&
+      contents->GetPrimaryMainFrame()->IsRenderFrameLive()) {
+    contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+        u"globalThis.safariumPageItemPicker?.restore()", {},
+        ISOLATED_WORLD_ID_CHROME_INTERNAL);
+  }
+}
+
+GURL TabBarController::ActiveURL() const {
+  content::WebContents* contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  return contents ? contents->GetLastCommittedURL() : GURL();
+}
+
+std::u16string TabBarController::ActiveTitle() const {
+  content::WebContents* contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  return contents ? contents->GetTitle() : std::u16string();
+}
+
+void TabBarController::NewTab() {
+  chrome::ExecuteCommand(browser_, IDC_NEW_TAB);
+}
+
+void TabBarController::GoBack() {
+  chrome::ExecuteCommand(browser_, IDC_BACK);
+}
+
+void TabBarController::GoForward() {
+  chrome::ExecuteCommand(browser_, IDC_FORWARD);
+}
+
+void TabBarController::Reload() {
+  chrome::ExecuteCommand(browser_, IDC_RELOAD);
+}
+
+void TabBarController::Stop() {
+  chrome::ExecuteCommand(browser_, IDC_STOP);
+}
+
+void TabBarController::FocusActiveTab() {
+  if (content::WebContents* contents =
+          browser_->GetTabStripModel()->GetActiveWebContents()) {
+    contents->Focus();
+  }
+}
+
+void TabBarController::NavigateActiveTab(const std::u16string& text) {
+  content::WebContents* contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (!contents || text.empty()) {
+    return;
+  }
+  AutocompleteMatch match;
+  AutocompleteClassifierFactory::GetForProfile(browser_->GetProfile())
+      ->Classify(text, /*in_keyword_mode=*/false,
+                 /*allow_exact_keyword_match=*/true,
+                 metrics::OmniboxEventProto::OTHER, &match,
+                 /*alternate_nav_url=*/nullptr);
+  if (!match.destination_url.is_valid()) {
+    return;
+  }
+  content::OpenURLParams params(
+      match.destination_url, content::Referrer(),
+      WindowOpenDisposition::kCurrentTab,
+      ui::PageTransitionFromInt(match.transition |
+                                ui::PAGE_TRANSITION_FROM_ADDRESS_BAR),
+      /*is_renderer_initiated=*/false);
+  contents->OpenURL(params, /*navigation_handle_callback=*/{});
+  contents->Focus();
+}
+
+void TabBarController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  PushState();
+}
+
+void TabBarController::LoadProgressChanged(double progress) {
+  PushState();
+}
+
+void TabBarController::DidStopLoading() {
+  PushState();
+}
+
+void TabBarController::OnTabChangedAt(tabs::TabInterface* tab,
+                                      TabChangeType change_type) {
+  PushState();
+}
+
+}  // namespace safarium
