+// ---------------------------------------------------------------------------
+// Tab overview (Safari's "Show All Tabs"): a native NSCollectionView grid of
+// tab cards over the web contents, with a native NSSearchField.
+
+namespace {
+NSUserInterfaceItemIdentifier const kOverviewCardId = @"SafariumOverviewCard";
+constexpr CGFloat kCardWidth = 272;
+constexpr CGFloat kCardHeight = 196;
+constexpr CGFloat kCardHeader = 26;
+constexpr CGFloat kCardCornerRadius = 10;
+constexpr CFTimeInterval kExitZoomDuration = 0.25;
+constexpr CFTimeInterval kExitSnapshotDeadline = 0.12;
+constexpr CFTimeInterval kExitHandoffDuration = 0.08;
+
+void AnimateOverviewFrame(CALayer* layer, NSRect from, NSRect to) {
+  layer.frame = to;
+  CABasicAnimation* move = [CABasicAnimation animationWithKeyPath:@"position"];
+  move.fromValue =
+      [NSValue valueWithPoint:NSMakePoint(NSMidX(from), NSMidY(from))];
+  move.duration = kExitZoomDuration;
+  move.timingFunction = EditTiming();
+  [layer addAnimation:move forKey:@"safariumPosition"];
+
+  CABasicAnimation* resize = [CABasicAnimation animationWithKeyPath:@"bounds"];
+  resize.fromValue =
+      [NSValue valueWithRect:NSMakeRect(0, 0, NSWidth(from), NSHeight(from))];
+  resize.duration = kExitZoomDuration;
+  resize.timingFunction = EditTiming();
+  [layer addAnimation:resize forKey:@"safariumBounds"];
+
+  CABasicAnimation* corners =
+      [CABasicAnimation animationWithKeyPath:@"cornerRadius"];
+  corners.fromValue = @(kCardCornerRadius);
+  corners.duration = kExitZoomDuration;
+  [layer addAnimation:corners forKey:@"safariumCorners"];
+}
+
+void FadeOverviewLayer(CALayer* layer,
+                       CFTimeInterval delay,
+                       CFTimeInterval duration) {
+  CABasicAnimation* fade = [CABasicAnimation animationWithKeyPath:@"opacity"];
+  fade.fromValue = @1;
+  fade.toValue = @0;
+  fade.beginTime =
+      [layer convertTime:CACurrentMediaTime() fromLayer:nil] + delay;
+  fade.duration = duration;
+  fade.fillMode = kCAFillModeBoth;
+  fade.removedOnCompletion = NO;
+  [layer addAnimation:fade forKey:@"safariumHandoff"];
+}
+
+}  // namespace
