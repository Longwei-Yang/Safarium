+@implementation SafariumTabCell {
+  NSTrackingArea* _tracking;
+  BOOL _hovered;
+  CGFloat _contentX;
+  BOOL _hasContentX;
+  BOOL _animateContentOnce;
+}
+
+- (void)noteContentWasAtX:(CGFloat)x {
+  _contentX = x;
+  _hasContentX = YES;
+}
+
+- (void)animateContentOnNextLayout {
+  _animateContentOnce = YES;
+  self.needsLayout = YES;
+}
+@synthesize index = _index;
+@synthesize active = _active;
+@synthesize pinned = _pinned;
+@synthesize bar = _bar;
+@synthesize iconView = _iconView;
+@synthesize titleLabel = _titleLabel;
+@synthesize closeButton = _closeButton;
+@synthesize separator = _separator;
+
+- (BOOL)hovered {
+  return _hovered;
+}
+
+- (instancetype)initWithFrame:(NSRect)frame {
+  if ((self = [super initWithFrame:frame])) {
+    self.wantsLayer = YES;
+    self.layer.cornerRadius = kTabHeight / 2;
+    self.layer.masksToBounds = NO;
+    // Inactive tabs draw below the current tab's pill, so sliding titles
+    // come out from under it (as in Safari) instead of crossing over it.
+    self.layer.zPosition = -1;
+
+    _iconView = [[NSImageView alloc] initWithFrame:NSZeroRect];
+    _iconView.imageScaling = NSImageScaleProportionallyUpOrDown;
+    _iconView.wantsLayer = YES;
+    [self addSubview:_iconView];
+
+    _titleLabel = [NSTextField labelWithString:@""];
+    _titleLabel.font = [NSFont systemFontOfSize:13];
+    _titleLabel.textColor = NSColor.labelColor;
+    _titleLabel.lineBreakMode = NSLineBreakByTruncatingTail;
+    _titleLabel.wantsLayer = YES;
+    [self addSubview:_titleLabel];
+
+    _closeButton = MakeIconButton(@"xmark.circle.fill", 12, self,
+                                  @selector(closeClicked:));
+    _closeButton.contentTintColor = NSColor.secondaryLabelColor;
+    _closeButton.hidden = YES;
+    [self addSubview:_closeButton];
+
+    _separator = [[NSView alloc] initWithFrame:NSZeroRect];
+    _separator.wantsLayer = YES;
+    [self addSubview:_separator];
+    [self refreshColors];
+  }
+  return self;
+}
+
+- (BOOL)isFlipped {
+  return YES;
+}
+
+- (void)setIcon:(NSImage*)icon {
+  _iconView.image = icon;
+}
+
+- (void)layout {
+  [super layout];
+  NSRect b = self.bounds;
+  CGFloat iconY = floor((b.size.height - kIconSize) / 2);
+  _separator.frame = NSMakeRect(-kGap / 2 - 0.5, 8, 1, b.size.height - 16);
+  _closeButton.frame = NSMakeRect(8, iconY, kIconSize, kIconSize);
+  if (_pinned) {
+    _iconView.frame = NSMakeRect(floor((b.size.width - kIconSize) / 2), iconY,
+                                 kIconSize, kIconSize);
+    _titleLabel.hidden = YES;
+    _iconView.hidden = NO;
+    return;
+  }
+  // Center [icon + title] in the cell, truncating the title if needed.
+  // Measure the string directly; the label's intrinsic size can lag behind
+  // title changes.
+  // Keep the leading slot free for the hover close button (⊗ at x=8..24),
+  // like Safari: content is centered but never starts left of it.
+  // Always reserved, so hovering only fades the ⊗ in; the icon and title
+  // never move (Safari behaviour).
+  const CGFloat leadingReserve = 8 + kIconSize + 4;
+  const CGFloat trailingReserve = 10;
+  CGFloat maxTitle = MAX(0, b.size.width - leadingReserve - trailingReserve -
+                                kIconSize - 6);
+  CGFloat textW = ceil([_titleLabel.stringValue sizeWithAttributes:@{
+                    NSFontAttributeName : _titleLabel.font
+                  }].width) + 4;
+  CGFloat titleW = MIN(maxTitle, textW);
+  CGFloat groupW = kIconSize + 6 + titleW;
+  CGFloat x = MAX(leadingReserve, floor((b.size.width - groupW) / 2));
+  _iconView.frame = NSMakeRect(x, iconY, kIconSize, kIconSize);
+  _titleLabel.frame =
+      NSMakeRect(x + kIconSize + 6, floor((b.size.height - 17) / 2), titleW, 17);
+  // The active tab's content is drawn by the bar's address overlay.
+  _titleLabel.hidden = _active || titleW < 10;
+  _iconView.hidden = _active;
+
+  // Safari keeps each tab's icon and title visually continuous: they slide
+  // from where they were to where they are now (e.g. out from under the
+  // pill when the tab stops being the current one).
+  if (_animateContentOnce && _hasContentX && !_active &&
+      fabs(_contentX - x) > 0.5) {
+    CABasicAnimation* slide =
+        [CABasicAnimation animationWithKeyPath:@"transform.translation.x"];
+    slide.fromValue = @(_contentX - x);
+    slide.toValue = @0;
+    slide.duration = kAnimationDuration;
+    slide.timingFunction = SafariTiming();
+    [_iconView.layer addAnimation:slide forKey:@"safariumContent"];
+    [_titleLabel.layer addAnimation:slide forKey:@"safariumContent"];
+  }
+  _animateContentOnce = NO;
+  if (!_active) {
+    _contentX = x;
+    _hasContentX = YES;
+  }
+}
+
+- (void)updateTrackingAreas {
+  [super updateTrackingAreas];
+  if (_tracking) {
+    [self removeTrackingArea:_tracking];
+  }
+  _tracking = [[NSTrackingArea alloc]
+      initWithRect:NSZeroRect
+           options:NSTrackingMouseEnteredAndExited |
+                   NSTrackingActiveInKeyWindow | NSTrackingInVisibleRect
+             owner:self
+          userInfo:nil];
+  [self addTrackingArea:_tracking];
+}
+
+// The bar lives in the title-bar area. Without this AppKit treats a press
+// on a (non-opaque) tab as the start of a window drag.
+- (BOOL)mouseDownCanMoveWindow {
+  return NO;
+}
+
+- (void)refreshHoverFromPointer {
+  BOOL inside = NO;
+  if (self.window && !self.hidden) {
+    const NSPoint p = [self convertPoint:self.window.mouseLocationOutsideOfEventStream
+                                fromView:nil];
+    inside = NSPointInRect(p, self.bounds);
+  }
+  if (inside == _hovered) {
+    return;
+  }
+  [self setHoveredState:inside];
+}
+
+- (void)mouseEntered:(NSEvent*)event {
+  [self setHoveredState:YES];
+}
+
+- (void)mouseExited:(NSEvent*)event {
+  [self setHoveredState:NO];
+}
+
+- (void)setHoveredState:(BOOL)hovered {
+  _hovered = hovered;
+  const BOOL showClose = hovered && !_active && !_pinned;
+  if (showClose && _closeButton.hidden) {
+    _closeButton.alphaValue = 0;
+    _closeButton.hidden = NO;
+  }
+  // Faded-out ⊗ must not take clicks (it sits over the tab).
+  static_cast<SafariumOverlayButton*>(_closeButton).shown = showClose;
+  [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+    context.duration = 0.12;
+    self->_closeButton.animator.alphaValue = showClose ? 1 : 0;
+  }];
+  [self refreshColors];
+  [self.bar tabCellHoverChanged:self];
+}
+
+- (void)setActive:(BOOL)active {
+  if (_active == active) {
+    return;
+  }
+  _active = active;
+  self.layer.zPosition = active ? 0 : -1;
+  if (active) {
+    _closeButton.hidden = YES;
+  }
+  [self refreshColors];
+  self.needsLayout = YES;
+}
+
+- (void)refreshColors {
+  [self.effectiveAppearance performAsCurrentDrawingAppearance:^{
+    NSColor* fill = NSColor.clearColor;
+    if (self->_active) {
+      fill = NSColor.controlBackgroundColor;
+    } else if (self->_hovered) {
+      fill = [NSColor.labelColor colorWithAlphaComponent:0.07];
+    }
+    self.layer.backgroundColor = fill.CGColor;
+    self.layer.shadowColor = NSColor.blackColor.CGColor;
+    self.layer.shadowOpacity = self->_active ? 0.10 : 0;
+    self.layer.shadowRadius = 2;
+    self.layer.shadowOffset = CGSizeMake(0, -0.5);
+    self->_separator.layer.backgroundColor =
+        [NSColor.labelColor colorWithAlphaComponent:0.12].CGColor;
+  }];
+}
+
+- (void)viewDidChangeEffectiveAppearance {
+  [super viewDidChangeEffectiveAppearance];
+  [self refreshColors];
+}
+
+- (void)mouseDown:(NSEvent*)event {
+  [self.bar tabMouseDown:event cell:self];
+}
+
+- (void)mouseDragged:(NSEvent*)event {
+  [self.bar tabMouseDragged:event];
+}
+
+- (void)mouseUp:(NSEvent*)event {
+  [self.bar tabMouseUp:event];
+}
+
+- (void)closeClicked:(id)sender {
+  [self.bar tabCellCloseClicked:self];
+}
+
+@end
+
+// ---------------------------------------------------------------------------
+// Horizontally scrolling tab strip. Trackpads get native rubber-banding from
+// NSScrollView; plain mouse wheels scroll sideways too.
+
+@interface SafariumTabScrollView : NSScrollView
+@end
+
+@implementation SafariumTabScrollView
+- (void)scrollWheel:(NSEvent*)event {
+  if (!event.hasPreciseScrollingDeltas &&
+      fabs(event.scrollingDeltaY) > fabs(event.scrollingDeltaX)) {
+    NSClipView* clip = self.contentView;
+    NSPoint origin = clip.bounds.origin;
+    const CGFloat maxX =
+        MAX(0, NSWidth(self.documentView.frame) - NSWidth(clip.bounds));
+    origin.x = MAX(0, MIN(maxX, origin.x - event.scrollingDeltaY * 12));
+    [clip scrollToPoint:origin];
+    [self reflectScrolledClipView:clip];
+    return;
+  }
+  [super scrollWheel:event];
+}
+@end
