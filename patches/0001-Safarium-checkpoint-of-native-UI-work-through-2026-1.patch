+// ---------------------------------------------------------------------------
+// Native window toolbar (NSToolbar). Like Safari: back/forward, reload, the
+// tab strip (which is also the address field) and new tab, all user
+// customizable via the system "Customize Toolbar…" palette. Full-screen
+// behaviour (traffic lights sliding in) comes from AppKit.
+
+namespace {
+NSToolbarIdentifier const kSafariumToolbarId = @"SafariumToolbar";
+NSToolbarItemIdentifier const kNavItem = @"safarium.navigation";
+NSToolbarItemIdentifier const kReloadItem = @"safarium.reload";
+NSToolbarItemIdentifier const kTabsItem = @"safarium.tabs";
+NSToolbarItemIdentifier const kNewTabItem = @"safarium.newtab";
+NSToolbarItemIdentifier const kHomeItem = @"safarium.home";
+NSToolbarItemIdentifier const kDownloadsItem = @"safarium.downloads";
+NSString* const kExtensionItemPrefix = @"safarium.extension.";
+NSString* const kSavedExtensionToolbarItems = @"SafariumExtensionToolbarItems";
+NSToolbarItemIdentifier const kHistoryItem = @"safarium.history";
+NSToolbarItemIdentifier const kBookmarksItem = @"safarium.bookmarks";
+NSToolbarItemIdentifier const kShareItem = @"safarium.share";
+NSToolbarItemIdentifier const kPrintItem = @"safarium.print";
+NSToolbarItemIdentifier const kOverviewItem = @"safarium.overview";
+
+// Plain C strings: a static array of ObjC pointers would need an exit-time
+// destructor under ARC.
+struct CommandItemSpec {
+  const char* identifier;
+  const char* label;
+  const char* symbol;
+  int command;
+};
+
+constexpr CommandItemSpec kCommandItems[] = {
+    {"safarium.home", "Home", "house", IDC_HOME},
+    {"safarium.history", "History", "clock", IDC_SHOW_HISTORY},
+    {"safarium.bookmarks", "Bookmarks", "book", IDC_SHOW_BOOKMARK_MANAGER},
+    {"safarium.print", "Print", "printer", IDC_PRINT},
+};
+}  // namespace
