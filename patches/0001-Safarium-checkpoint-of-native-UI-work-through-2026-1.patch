+// Safarium: model/controller for the native Compact tab bar.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_TAB_BAR_CONTROLLER_H_
+#define CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_TAB_BAR_CONTROLLER_H_
+
+#include <stdint.h>
+
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/thumbnails/thumbnail_image.h"
+#include "ui/gfx/image/image_skia.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "url/gurl.h"
+#include "ui/gfx/image/image.h"
+
+class BrowserWindowInterface;
+class Profile;
+class WebUIToolbarExtensionsContainer;
+
+namespace safarium {
+
+struct TabItem {
+  // Stable identity of the tab (survives reordering).
+  int64_t id = 0;
+  std::u16string title;
+  // Short form shown when the tab is not being edited (host).
+  std::u16string display_url;
+  // Full URL text placed in the field when the user starts editing.
+  std::u16string edit_url;
+  // Favicon; empty when the page has none yet.
+  gfx::Image favicon;
+  bool active = false;
+  bool loading = false;
+  bool pinned = false;
+  // True when `display_url` holds search terms (search results page).
+  bool is_search = false;
+};
+
+struct BarState {
+  std::vector<TabItem> tabs;
+  int active_index = -1;
+  bool can_go_back = false;
+  bool can_go_forward = false;
+  // Active tab is loading: show Stop instead of Reload.
+  bool is_loading = false;
+  // Active tab load progress in [0, 1] (Safari's blue line in the pill).
+  double load_progress = 0;
+};
+
+// Implemented by the platform view (AppKit on Mac).
+class TabBarView {
+ public:
+  virtual ~TabBarView() = default;
+  virtual void UpdateState(const BarState& state) = 0;
+  virtual void FocusAddressField() = 0;
+  // Tab overview thumbnails (only while SetWantsThumbnails(true)).
+  virtual void ThumbnailChanged(int64_t tab_id, const gfx::ImageSkia& image) {}
+};
+
+class TabBarController : public TabStripModelObserver,
+                         public content::WebContentsObserver {
+ public:
+  TabBarController(BrowserWindowInterface* browser,
+                   base::WeakPtr<WebUIToolbarExtensionsContainer> extensions);
+  TabBarController(const TabBarController&) = delete;
+  TabBarController& operator=(const TabBarController&) = delete;
+  ~TabBarController() override;
+
+  void SetView(TabBarView* view);
+  void PushState();
+
+  // Actions from the view.
+  void ActivateTab(int index);
+  void CloseTab(int index);
+  void MoveTab(int from, int to);
+  // Subscribes to Chromium's tab thumbnails (the hover-card capture
+  // service) for every tab while the tab overview is shown.
+  void SetWantsThumbnails(bool wants);
+  // Snapshot of the active tab's page (for the overview zoom animation).
+  // Calls back with an empty image if none is available.
+  void CaptureActiveTab(base::OnceCallback<void(gfx::ImageSkia)> callback);
+  // Runs a Chrome command (IDC_*) for toolbar items such as Home/Downloads.
+  void ExecuteCommand(int command_id);
+  bool IsCommandEnabled(int command_id) const;
+  WebUIToolbarExtensionsContainer* GetExtensionsContainer() const;
+  Profile* GetProfile() const;
+  int ActiveZoomPercent() const;
+  void ShowActiveSiteSettings();
+  void HideDistractingItems();
+  void ShowHiddenItems();
+  // URL of the active tab (for Share), empty if none.
+  GURL ActiveURL() const;
+  std::u16string ActiveTitle() const;
+  void NewTab();
+  void NavigateActiveTab(const std::u16string& text);
+  void GoBack();
+  void GoForward();
+  void Reload();
+  void Stop();
+  // Gives keyboard focus back to the active tab's page.
+  void FocusActiveTab();
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel* tab_strip_model,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+
+  // content::WebContentsObserver (observes the active tab):
+  void LoadProgressChanged(double progress) override;
+  void DidStopLoading() override;
+
+ private:
+  BarState BuildState() const;
+  void UpdateThumbnailSubscriptions();
+  void OnThumbnail(int64_t tab_id, gfx::ImageSkia image);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const base::WeakPtr<WebUIToolbarExtensionsContainer> extensions_;
+  raw_ptr<TabBarView> view_ = nullptr;
+  bool wants_thumbnails_ = false;
+  std::map<int64_t, std::unique_ptr<ThumbnailImage::Subscription>>
+      thumbnail_subscriptions_;
+  base::WeakPtrFactory<TabBarController> weak_factory_{this};
+};
+
+}  // namespace safarium
+
+#endif  // CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_TAB_BAR_CONTROLLER_H_
diff --git a/chrome/browser/ui/webui_browser/safarium_tab_bar_host_mac.mm b/chrome/browser/ui/webui_browser/safarium_tab_bar_host_mac.mm
