+// ---------------------------------------------------------------------------
+// views bridge: a zero-height view that installs the NSToolbar on the
+// widget's NSWindow and forwards tab-strip state to it.
+
+namespace safarium {
+
+class ToolbarInstaller : public views::View, public TabBarView {
+  METADATA_HEADER(ToolbarInstaller, views::View)
+
+ public:
+  ToolbarInstaller(TabBarController* controller, views::View* page_view)
+      : controller_(controller) {
+    tab_view_ = [[SafariumTabBarView alloc]
+        initWithFrame:NSMakeRect(0, 0, 600, kControlHeight)];
+    [tab_view_ setController:controller];
+    [tab_view_ updatePreferredWidthAnimated:NO];
+
+    // views::FocusManager must know the page no longer has focus, or
+    // views::WebView re-focuses the renderer on the next navigation commit
+    // and silently ends the edit session.
+    ToolbarInstaller* installer = this;
+    tab_view_.willFocusAddressField = ^{
+      if (views::Widget* widget = installer->GetWidget()) {
+        if (views::FocusManager* focus_manager = widget->GetFocusManager()) {
+          focus_manager->SetFocusedView(nullptr);
+        }
+      }
+    };
+    toolbar_ = [[SafariumToolbarController alloc] initWithTabView:tab_view_
+                                                       pageView:page_view
+                                           extensionsAnchorView:this];
+    [toolbar_ setController:controller];
+    if (auto* extensions = controller->GetExtensionsContainer()) {
+      extension_updates_ = extensions->RegisterNativeToolbarUpdate(
+          base::BindRepeating(
+              [](ToolbarInstaller* installer) {
+                [installer->toolbar_ scheduleExtensionItemRefresh];
+              },
+              base::Unretained(this)));
+    }
+  }
+  ToolbarInstaller(const ToolbarInstaller&) = delete;
+  ToolbarInstaller& operator=(const ToolbarInstaller&) = delete;
+  ~ToolbarInstaller() override {
+    extension_updates_ = {};
+    controller_->SetView(nullptr);
+    [tab_view_ setController:nullptr];
+    tab_view_.willFocusAddressField = nil;
+    [toolbar_ uninstall];
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size();
+  }
+
+  gfx::Rect GetAnchorBoundsInScreen() const override {
+    return [toolbar_ extensionActionBounds];
+  }
+
+  void AddedToWidget() override {
+    views::View::AddedToWidget();
+    if (installed_) {
+      return;
+    }
+    NSWindow* window = GetWidget()->GetNativeWindow().GetNativeNSWindow();
+    if (!window) {
+      return;
+    }
+    installed_ = true;
+    [toolbar_ installInWindow:window];
+    controller_->SetView(this);
+  }
+
+  // TabBarView:
+  void UpdateState(const BarState& state) override {
+    [tab_view_ updateState:state];
+    [toolbar_ updateState:state];
+  }
+
+  void FocusAddressField() override { [tab_view_ focusAddressField]; }
+
+  void ThumbnailChanged(int64_t tab_id, const gfx::ImageSkia& image) override {
+    [toolbar_ thumbnailChanged:gfx::NSImageFromImageSkia(image) forTab:tab_id];
+  }
+
+ private:
+  const raw_ptr<TabBarController> controller_;
+  SafariumTabBarView* __strong tab_view_;
+  SafariumToolbarController* __strong toolbar_;
+  base::CallbackListSubscription extension_updates_;
+  bool installed_ = false;
+};
