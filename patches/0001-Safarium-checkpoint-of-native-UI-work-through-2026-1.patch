+// One card: header (close button, favicon, title) over the thumbnail. A nil
+// tab makes it the "+" card.
+@interface SafariumOverviewCard : NSCollectionViewItem
+@property(nonatomic, weak) id<SafariumOverviewDelegate> delegate;
+@property(nonatomic, strong) SafariumOverviewTab* tab;
+@property(nonatomic, readonly) NSImage* thumbnailImage;
+- (void)setThumbnail:(NSImage*)thumbnail;
+- (NSRect)thumbnailRectInView:(NSView*)view;
+- (NSRect)headerRectInView:(NSView*)view;
+- (NSBitmapImageRep*)headerSnapshot;
+// Fades the header (close/icon/title) and card corners for the zoom.
