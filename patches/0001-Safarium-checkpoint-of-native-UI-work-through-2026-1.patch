+    _table.rowHeight = kRowHeight;
+    _table.gridStyleMask = NSTableViewSolidHorizontalGridLineMask;
+    _table.dataSource = self;
+    _table.delegate = self;
+    [_table setAccessibilityLabel:@"Downloads"];
+    NSTableColumn* column = [[NSTableColumn alloc] initWithIdentifier:@"file"];
+    column.width = kWidth - 24;
+    [_table addTableColumn:column];
+    _scroll.documentView = _table;
+
+    _emptyLabel = [NSTextField labelWithString:@"No downloads"];
+    _emptyLabel.alignment = NSTextAlignmentCenter;
+    _emptyLabel.textColor = NSColor.secondaryLabelColor;
+    [_content addSubview:_emptyLabel];
+  }
+  return self;
+}
+
+- (void)toggleForProfile:(Profile*)profile
+               toolbarItem:(NSToolbarItem*)item
+                    showAll:(void (^)(void))showAll {
+  if (_popover.isShown) {
+    [self close];
+    return;
+  }
+  if (@available(macOS 14.0, *)) {
+    content::DownloadManager* manager = profile->GetDownloadManager();
+    DownloadCoreServiceFactory::GetForBrowserContext(profile)->InitializeHistory(
+        DownloadCoreService::DownloadHistoryLoadTrigger::kDownloadBubble);
+    manager->CheckForHistoryFilesRemoval();
+    _showAll = [showAll copy];
+    __weak SafariumDownloadsPopover* weakSelf = self;
+    _observer = std::make_unique<DownloadObserver>(^{
+      [weakSelf scheduleRefresh];
+    });
+    _notifier =
+        std::make_unique<download::AllDownloadItemNotifier>(manager, _observer.get());
+    [self refresh];
+    [_popover showRelativeToToolbarItem:item];
+  } else {
+    showAll();
+  }
+}
+
+- (void)close {
+  [_popover close];
+  [self stopObserving];
+}
+
+- (void)popoverDidClose:(NSNotification*)notification {
+  [self stopObserving];
+}
+
+- (void)stopObserving {
+  _notifier.reset();
+  _observer.reset();
+  _showAll = nil;
+}
+
+- (content::DownloadManager*)manager {
+  return _notifier ? _notifier->GetManager() : nullptr;
+}
+
+- (DownloadItem*)downloadForGuid:(const std::string&)guid {
+  content::DownloadManager* manager = [self manager];
+  return manager ? manager->GetDownloadByGuid(guid) : nullptr;
+}
+
+- (BOOL)canClearHistory {
+  content::DownloadManager* manager = [self manager];
+  return manager && Profile::FromBrowserContext(manager->GetBrowserContext())
+                        ->GetPrefs()
+                        ->GetBoolean(prefs::kAllowDeletingBrowserHistory);
+}
+
+- (void)scheduleRefresh {
+  if (_refreshPending) {
+    return;
+  }
+  _refreshPending = YES;
+  __weak SafariumDownloadsPopover* weakSelf = self;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    SafariumDownloadsPopover* strongSelf = weakSelf;
+    if (strongSelf) {
+      strongSelf->_refreshPending = NO;
+      if (strongSelf->_popover.isShown) {
+        [strongSelf refresh];
+      }
+    }
+  });
+}
+
+- (void)refresh {
+  content::DownloadManager* manager = [self manager];
+  content::DownloadManager::DownloadVector items;
+  if (manager) {
+    manager->GetAllDownloads(&items);
+  }
+  std::erase_if(items, [](DownloadItem* item) { return !IsVisible(item); });
+  std::ranges::sort(items, std::greater<>(), &DownloadItem::GetStartTime);
+
+  _guids.clear();
+  for (DownloadItem* item : items) {
+    _guids.push_back(item->GetGuid());
+  }
+
+  _clearButton.enabled =
+      [self canClearHistory] && std::ranges::any_of(
+          items, [](DownloadItem* item) { return CanClear(*item); });
+  const size_t visibleRows = std::clamp(items.size(), size_t{1}, kMaxVisibleRows);
+  const CGFloat rowArea = visibleRows * kRowHeight;
+  _popover.contentSize =
+      NSMakeSize(kWidth, kHeaderHeight + rowArea + kFooterHeight);
+  _scroll.frame = NSMakeRect(12, kFooterHeight, kWidth - 24, rowArea);
+  _scroll.hidden = items.empty();
+  _emptyLabel.frame = NSMakeRect(12, kFooterHeight + 17, kWidth - 24, 20);
+  _emptyLabel.hidden = !items.empty();
+  _emptyLabel.stringValue = manager && !manager->IsManagerInitialized()
+                                 ? @"Loading downloads…"
+                                 : @"No downloads";
+  [_table reloadData];
+}
+
+- (NSInteger)numberOfRowsInTableView:(NSTableView*)tableView {
+  return static_cast<NSInteger>(_guids.size());
+}
+
+- (NSView*)tableView:(NSTableView*)tableView
+    viewForTableColumn:(NSTableColumn*)column
+                   row:(NSInteger)row {
+  if (row < 0 || static_cast<size_t>(row) >= _guids.size()) {
+    return nil;
+  }
+  DownloadItem* item = [self downloadForGuid:_guids[row]];
+  if (!item) {
+    return nil;
+  }
+
+  const CGFloat width = kWidth - 24;
+  NSView* view = [[NSView alloc] initWithFrame:NSMakeRect(0, 0, width, kRowHeight)];
+  NSImageView* icon = [[NSImageView alloc] initWithFrame:NSMakeRect(8, 12, 26, 28)];
+  icon.image = [NSImage imageWithSystemSymbolName:@"doc"
+                       accessibilityDescription:nil];
+  icon.contentTintColor = NSColor.secondaryLabelColor;
+  [view addSubview:icon];
+
+  NSString* name = base::apple::FilePathToNSString(item->GetFileNameToReportUser());
+  const BOOL canOpen = CanAccessFile(*item) && item->CanOpenDownload();
+  NSRect titleFrame = NSMakeRect(45, 27, width - 92, 20);
+  if (canOpen) {
+    SafariumDownloadButton* open =
+        [SafariumDownloadButton buttonWithTitle:name ?: @"Download"
+                                         target:self
+                                         action:@selector(openFile:)];
+    open.downloadGuid = base::SysUTF8ToNSString(item->GetGuid());
+    open.bordered = NO;
+    open.alignment = NSTextAlignmentLeft;
+    open.lineBreakMode = NSLineBreakByTruncatingMiddle;
+    open.frame = titleFrame;
+    open.toolTip = name;
+    [view addSubview:open];
+  } else {
+    NSTextField* title = [NSTextField labelWithString:name ?: @"Download"];
+    title.lineBreakMode = NSLineBreakByTruncatingMiddle;
+    title.frame = titleFrame;
+    title.toolTip = name;
+    [view addSubview:title];
+  }
+
+  NSTextField* status = [NSTextField labelWithString:StatusText(item)];
+  status.font = [NSFont systemFontOfSize:11];
+  status.textColor = NSColor.secondaryLabelColor;
+  status.lineBreakMode = NSLineBreakByTruncatingTail;
+  status.frame = NSMakeRect(45, 10, width - 92, 16);
+  [view addSubview:status];
+
+  if (CanAccessFile(*item) && item->CanShowInFolder()) {
+    NSImage* glass =
+        [NSImage imageWithSystemSymbolName:@"magnifyingglass"
+                  accessibilityDescription:@"Show in Finder"];
+    SafariumDownloadButton* reveal =
+        [SafariumDownloadButton buttonWithImage:glass
+                                         target:self
+                                         action:@selector(revealFile:)];
+    reveal.downloadGuid = base::SysUTF8ToNSString(item->GetGuid());
+    reveal.bordered = NO;
+    reveal.frame = NSMakeRect(width - 36, 14, 28, 28);
+    [reveal setAccessibilityLabel:@"Show in Finder"];
+    reveal.toolTip = @"Show in Finder";
+    [view addSubview:reveal];
+  }
+  return view;
+}
+
+- (void)openFile:(SafariumDownloadButton*)sender {
+  DownloadItem* item = [self downloadForGuid:base::SysNSStringToUTF8(sender.downloadGuid)];
+  if (item && CanAccessFile(*item) && item->CanOpenDownload()) {
+    item->OpenDownload();
+  }
+}
+
+- (void)revealFile:(SafariumDownloadButton*)sender {
+  DownloadItem* item = [self downloadForGuid:base::SysNSStringToUTF8(sender.downloadGuid)];
+  if (item && CanAccessFile(*item) && item->CanShowInFolder()) {
+    item->ShowDownloadInShell();
+  }
+}
+
+- (void)clear:(id)sender {
+  if (![self canClearHistory]) {
+    return;
+  }
+  auto guids = _guids;
+  for (const auto& guid : guids) {
+    DownloadItem* item = [self downloadForGuid:guid];
+    if (item && IsVisible(item) && CanClear(*item)) {
+      item->Remove();
+    }
+  }
+  [self refresh];
+}
+
+- (void)showAll:(id)sender {
+  void (^showAll)(void) = _showAll;
+  [self close];
+  if (showAll) {
+    showAll();
+  }
+}
+
+@end
