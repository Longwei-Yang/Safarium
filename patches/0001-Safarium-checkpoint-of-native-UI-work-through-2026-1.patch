+
+// Width this view would like: every tab at kMaxTabWidth. The toolbar
+// centers the item (centeredItemIdentifiers) and gives it at most what is
+// free; when it gets less, tabs shrink (current tab stays wider) and then
+// the strip scrolls.
+- (CGFloat)preferredStripWidth {
+  NSUInteger pinned = 0;
+  for (SafariumTabCell* cell in _cells) {
+    pinned += cell.pinned ? 1 : 0;
+  }
+  const NSUInteger n = std::max<NSUInteger>(_cells.count, 1);
+  // With no tabs yet, size for one.
+  const NSUInteger normal = _cells.count ? _cells.count - pinned : 1;
+  return 2 * kCapsuleInset + pinned * kPinnedTabWidth +
+         normal * kMaxTabWidth + kGap * (n - 1);
+}
+
+- (void)updatePreferredWidthAnimated:(BOOL)animated {
+  if (!_preferredWidth) {
+    self.translatesAutoresizingMaskIntoConstraints = NO;
+    [self.heightAnchor constraintEqualToConstant:kControlHeight].active = YES;
+    [self.widthAnchor constraintGreaterThanOrEqualToConstant:kMaxTabWidth +
+                                                             2 * kCapsuleInset]
+        .active = YES;
+    _maxWidth = [self.widthAnchor constraintLessThanOrEqualToConstant:0];
+    _maxWidth.active = YES;
+    // Below fitting-size compression: the item's fitting size stays at its
+    // minimum, so NSToolbar treats it as flexible (min…max) and grows it
+    // into the free space instead of overflowing it into the » menu.
+    _preferredWidth = [self.widthAnchor constraintEqualToConstant:0];
+    _preferredWidth.priority = NSLayoutPriorityFittingSizeCompression - 1;
+    _preferredWidth.active = YES;
+  }
+  const CGFloat width = [self preferredStripWidth];
+  if (_maxWidth.constant == width) {
+    return;
+  }
+  NSView* root = self.window.contentView.superview;
+  if (!animated || _maxWidth.constant == 0 || !root) {
+    _maxWidth.constant = width;
+    _preferredWidth.constant = width;
+    return;
+  }
+  // NSToolbar lays a flexible item out at its own pace (no animation), so:
+  // measure the width the toolbar will give us, pin the current width with
+  // a required constraint, animate the pin, then let go of it.
+  const CGFloat from = NSWidth(self.frame);
+  __block CGFloat to = from;
+  // Measure and pin with animations explicitly off (callers may be inside an
+  // animation group; animating these intermediate layouts makes the
+  // toolbar's glass platter jump to the final size).
+  // Our own -layout must not re-flow the tabs at these intermediate widths
+  // (that would snap them before the animated relayout runs).
+  _suppressLayout = YES;
+  [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+    context.duration = 0;
+    context.allowsImplicitAnimation = NO;
+    self->_maxWidth.constant = width;
+    self->_preferredWidth.constant = width;
+    if (self->_pinnedWidth) {
+      self->_pinnedWidth.active = NO;
+    }
+    [root layoutSubtreeIfNeeded];
+    to = NSWidth(self.frame);
+    if (!self->_pinnedWidth) {
+      self->_pinnedWidth = [self.widthAnchor constraintEqualToConstant:from];
+    }
+    self->_pinnedWidth.constant = from;
+    self->_pinnedWidth.active = YES;
+    [root layoutSubtreeIfNeeded];
+  }];
+  _suppressLayout = NO;
+  if (fabs(to - from) < 0.5) {
+    _pinnedWidth.active = NO;
+    return;
+  }
+  _targetWidth = to;
+  const NSUInteger generation = ++_pinGeneration;
+  __weak SafariumTabBarView* weakSelf = self;
+  // The width animation is driven from the main thread (constraint
+  // animator), so start it once the work that triggered it (e.g. creating
+  // a new tab's renderer) is done; otherwise most frames are dropped.
+  dispatch_after(
+      dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.03 * NSEC_PER_SEC)),
+      dispatch_get_main_queue(), ^{
+        SafariumTabBarView* strongSelf = weakSelf;
+        if (!strongSelf || strongSelf->_pinGeneration != generation) {
+          return;
+        }
+        [NSAnimationContext
+            runAnimationGroup:^(NSAnimationContext* context) {
+              context.duration = kAnimationDuration + 0.06;
+              context.timingFunction = SafariTiming();
+              context.allowsImplicitAnimation = YES;
+              strongSelf->_pinnedWidth.animator.constant = to;
+              [root layoutSubtreeIfNeeded];
+            }
+            completionHandler:^{
+              SafariumTabBarView* inner = weakSelf;
+              if (inner && inner->_pinGeneration == generation) {
+                inner->_pinnedWidth.active = NO;
+                inner->_targetWidth = 0;
+                [inner relayoutAnimated:NO];
+              }
+            }];
+      });
+}
+
+- (void)place:(NSView*)view frame:(NSRect)frame animated:(BOOL)animated {
+  if (animated) {
+    view.animator.frame = frame;
+    return;
+  }
+  // Already there (or animating there): leave any running animation alone.
+  if (NSEqualRects(view.frame, frame)) {
+    return;
+  }
+  // A zero-duration animator set replaces (cancels) an in-flight animation;
+  // a plain setter would let the old one keep playing towards a stale value.
+  [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+    context.duration = 0;
+    view.animator.frame = frame;
+  }];
+}
+
+- (void)fade:(NSView*)view alpha:(CGFloat)alpha animated:(BOOL)animated {
+  if (animated) {
+    view.animator.alphaValue = alpha;
+    return;
+  }
+  if (view.alphaValue == alpha) {
+    return;
+  }
+  [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+    context.duration = 0;
+    view.animator.alphaValue = alpha;
+  }];
+}
+
+// Scrolls the strip so `frame` is visible (when requested) and clamps the
+// scroll position after the strip shrinks.
+- (void)revealActiveFrame:(NSRect)frame animated:(BOOL)animated {
+  NSClipView* clip = _tabsScroll.contentView;
+  const NSRect visible = clip.bounds;
+  const CGFloat maxX = MAX(0, NSWidth(_strip.frame) - NSWidth(visible));
+  CGFloat x = visible.origin.x;
+  if (_revealActive && !NSIsEmptyRect(frame)) {
+    if (NSMinX(frame) - kRevealMargin < x) {
+      x = NSMinX(frame) - kRevealMargin;
+    } else if (NSMaxX(frame) + kRevealMargin > x + NSWidth(visible)) {
+      x = NSMaxX(frame) + kRevealMargin - NSWidth(visible);
+    }
+  }
+  x = MAX(0, MIN(maxX, x));
+  if (x == visible.origin.x) {
+    return;
+  }
+  if (animated) {
+    [clip.animator setBoundsOrigin:NSMakePoint(x, 0)];
+  } else {
+    [clip scrollToPoint:NSMakePoint(x, 0)];
+  }
+  [_tabsScroll reflectScrolledClipView:clip];
+}
+
+- (void)relayoutAnimated:(BOOL)animated {
+  NSRect b = self.bounds;
+  if (b.size.width <= 0) {
+    return;
+  }
+  // Catch editing sessions that started or ended without a notification.
+  [_addressField syncEditingState];
+  const BOOL editing = _addressField.editing;
+  const CGFloat y = floor((b.size.height - kControlHeight) / 2);
+
+  // The tab capsule fills this view (it is the "Tabs" item of the window's
+  // NSToolbar; back/forward/reload/+ are separate toolbar items).
+  NSRect capsule = NSMakeRect(0, y, b.size.width, kControlHeight);
+  const NSRect glassFrame = capsule;
+  if (_targetWidth > 0) {
+    capsule.origin.x = floor((b.size.width - _targetWidth) / 2);
+    capsule.size.width = _targetWidth;
+  }
+
+  // NOTE: never hide `_addressField` "temporarily" here. Hiding a view that
+  // holds the first responder makes AppKit end the edit session.
+  const NSUInteger n = _cells.count;
+  if (n == 0) {
+    [self place:_tabsGlass frame:glassFrame animated:animated];
+    [self place:_tabsTint frame:glassFrame animated:animated];
+    _tabsScroll.frame = capsule;
+    [self setActiveOverlayHidden:YES];
+    return;
+  }
+  NSUInteger pinnedCount = 0;
+  for (SafariumTabCell* cell in _cells) {
+    pinnedCount += cell.pinned ? 1 : 0;
+  }
+  const NSUInteger normalCount = n - pinnedCount;
+  // Cell and overlay frames below are in strip (scroll document) coordinates.
+  const CGFloat tabY = (kControlHeight - kTabHeight) / 2;
+  const CGFloat inner = capsule.size.width - 2 * kCapsuleInset;
+  const CGFloat available =
+      MAX(0, inner - pinnedCount * kPinnedTabWidth - kGap * (n - 1));
+  const BOOL activeIsPinned = _activeIndex >= 0 &&
+                              _activeIndex < (NSInteger)n &&
+                              _cells[_activeIndex].pinned;
+  CGFloat activeW = 0;
+  CGFloat unit = 0;
+  const BOOL fitsAtMax =
+      normalCount > 0 && available >= normalCount * kMaxTabWidth;
+  if (fitsAtMax) {
+    // Few tabs: all the same width; the strip shrinks and is centered.
+    unit = kMaxTabWidth;
+    activeW = kMaxTabWidth;
+  } else if (normalCount > 0) {
+    if (activeIsPinned) {
+      unit = MAX(kMinTabWidth, available / normalCount);
+    } else if (normalCount == 1) {
+      activeW = available;
+    } else {
+      // The current tab is about twice as wide as the others, but never
+      // narrower than kMinActiveTabWidth when there is room.
+      activeW = MAX(MIN(kMinActiveTabWidth, available * 0.6),
+                    available * 2 / (normalCount + 1));
+      unit = (available - activeW) / (normalCount - 1);
+      if (unit < kMinTabWidth) {
+        // Overflow: fixed widths, the strip scrolls.
+        unit = kMinTabWidth;
+        activeW = kMinActiveTabWidth;
+      }
+    }
+  }
+
+  [self place:_tabsGlass frame:glassFrame animated:animated];
+  [self place:_tabsTint frame:glassFrame animated:animated];
+  // Move the strip's frame directly, and shift its contents the other way
+  // so they stay where they are on screen; they then slide (below) from
+  // there to their new places instead of the whole strip sliding.
+  const CGFloat stripShift = NSMinX(capsule) - NSMinX(_tabsScroll.frame);
+  if (animated && !_placeTabsDirectly && fabs(stripShift) > 0.5 &&
+      !NSIsEmptyRect(_tabsScroll.frame)) {
+    for (NSView* view in _strip.subviews) {
+      NSRect f = view.layer.presentationLayer
+                     ? NSRectFromCGRect(view.layer.presentationLayer.frame)
+                     : view.frame;
+      if (view.layer.presentationLayer && view.superview.isFlipped) {
+        f = view.frame;  // Flipped geometry: keep the model frame.
+      }
+      f.origin.x -= stripShift;
+      [self place:view frame:f animated:NO];
+    }
+  }
+  [self place:_tabsScroll frame:capsule animated:NO];
+
+  CGFloat cx = kCapsuleInset;
+  NSRect activeFrame = NSZeroRect;
+  _slotFrames.assign(n, NSZeroRect);
+  for (NSUInteger i = 0; i < n; ++i) {
+    SafariumTabCell* cell = _cells[i];
+    const CGFloat w =
+        cell.pinned ? kPinnedTabWidth : (cell.active ? activeW : unit);
+    NSRect f = NSMakeRect(floor(cx), tabY, floor(w), kTabHeight);
+    _slotFrames[i] = f;
+    if (cell == _dragCell) {
+      // The dragged tab follows the pointer; its slot stays open for it.
+      f.origin.x = _dragX;
+      cell.frame = f;
+      cell.separator.hidden = YES;
+      if (cell.active) {
+        activeFrame = f;
+      }
+      cx += w + kGap;
+      continue;
+    }
+    if (_dragMoveOnly) {
+      // Pointer moved without reordering: leave the other tabs (and any
+      // slide they are in the middle of) alone.
+      if (cell.active) {
+        activeFrame = f;
+      }
+      cx += w + kGap;
+      continue;
+    }
+    const BOOL isNew = NSIsEmptyRect(cell.frame);
+    if (isNew) {
+      // New tabs grow out of their final center.
+      cell.frame = NSMakeRect(NSMidX(f), tabY, 0, kTabHeight);
+      cell.alphaValue = 0;
+    }
+    // Safari: the active pill jumps to the new tab immediately; only the
+    // other tabs slide.
+    const BOOL instant = cell.active && _activeChangedThisLayout;
+    [self place:cell
+          frame:f
+       animated:animated && !instant && !_placeTabsDirectly];
+    if (animated && !instant && !isNew) {
+      [cell animateContentOnNextLayout];
+    }
+    [self fade:cell
+           alpha:(editing && !cell.active) ? kDimmedAlpha : 1
+        animated:animated || isNew];
+    // Separator only between two adjacent non-active tabs.
+    cell.separator.hidden = (i == 0) || cell.active || _cells[i - 1].active;
+    if (cell.active) {
+      activeFrame = f;
+    }
+    cx += w + kGap;
+  }
+
+  // Size the scrollable strip and keep the active tab in view.
+  const CGFloat contentW = cx - kGap + kCapsuleInset;
+  _strip.frame =
+      NSMakeRect(0, 0, MAX(contentW, capsule.size.width), kControlHeight);
+  if (!_dragCell) {
+    [self revealActiveFrame:activeFrame
+                   animated:animated && !_activeChangedThisLayout];
+  }
+
+  // Active-tab overlay (the address field lives on top of the active tab).
+  if (NSIsEmptyRect(activeFrame) || activeIsPinned) {
+    [self setActiveOverlayHidden:YES];
+    return;
+  }
+  [self setActiveOverlayHidden:NO];
+
+  const BOOL overlayAnimated =
+      animated && !_activeChangedThisLayout && !_dragCell;
+  // Safari: the focus ring appears and disappears instantly.
+  _focusRing.frame = NSInsetRect(activeFrame, -3, -3);
+  _focusRing.alphaValue = editing ? 1 : 0;
+
+  const BOOL typed = _addressField.userModified;
+  const BOOL hasPage = _addressField.editText.length > 0;
+  const CGFloat iconY = NSMinY(activeFrame) + floor((kTabHeight - kIconSize) / 2);
+  const CGFloat textY = NSMinY(activeFrame) + floor((kTabHeight - 18) / 2);
+  const NSRect leading =
+      NSMakeRect(NSMinX(activeFrame) + 8, iconY, kIconSize, kIconSize);
+  const NSRect trailing = NSMakeRect(NSMaxX(activeFrame) - 8 - kIconSize, iconY,
+                                     kIconSize, kIconSize);
+  const NSRect beforeTrailing = NSOffsetRect(trailing, -(kIconSize + 6), 0);
+
+  // Leading slot: ⊗ while hovered (otherwise the icon lives there in edit
+  // mode).
+  [self place:_closeActiveButton frame:leading animated:overlayAnimated];
+  [self show:_closeActiveButton visible:_activeHovered animated:animated];
+
+  // Trailing slots.
+  //   untouched: [↻ on hover] ≡        typed: ↻ on hover, else × (clear)
+  const BOOL showReload = _activeHovered && hasPage;
+  const BOOL showClear =
+      typed && !showReload && _addressField.stringValue.length > 0;
+  [_hoverReloadButton
+      setImage:Symbol(_isLoading ? @"xmark" : @"arrow.clockwise", 11,
+                      NSFontWeightMedium)];
+  [self place:_hoverReloadButton
+        frame:typed ? trailing : beforeTrailing
+     animated:overlayAnimated];
+  [self place:_clearButton frame:trailing animated:overlayAnimated];
+  [self place:_pageMenuButton frame:trailing animated:overlayAnimated];
+  [self show:_hoverReloadButton visible:showReload animated:animated];
+  [self show:_clearButton visible:showClear animated:animated];
+  // No page menu on a blank tab (nothing to act on), like Safari.
+  [self show:_pageMenuButton visible:!typed && hasPage animated:animated];
+
+  // Load progress: a thin accent line along the bottom of the pill.
+  {
+    const CGFloat inset = kTabHeight / 2;
+    const CGFloat full = MAX(0, activeFrame.size.width - 2 * inset);
+    const BOOL showProgress = _isLoading && _loadProgress < 1.0;
+    const NSRect line =
+        NSMakeRect(NSMinX(activeFrame) + inset, NSMaxY(activeFrame) - 2,
+                   floor(full * (showProgress ? MAX(0.05, _loadProgress) : 1)),
+                   2);
+    if (_progressLine.alphaValue == 0 && showProgress) {
+      _progressLine.frame = NSMakeRect(line.origin.x, line.origin.y, 0, 2);
+    }
+    [self place:_progressLine frame:line animated:animated || showProgress];
+    [self fade:_progressLine alpha:showProgress ? 1 : 0 animated:YES];
+  }
+
+  const NSRect editField =
+      NSMakeRect(NSMaxX(leading) + 6, textY,
+                 MAX(0, NSMinX(trailing) - 6 - NSMaxX(leading) - 6), 18);
+
+  // Idle: center [icon + text] inside the active tab.
+  const BOOL showsPlaceholder = _addressField.displayText.length == 0;
+  CGFloat textW =
+      ceil(showsPlaceholder
+               ? _addressField.placeholderAttributedString.size.width
+               : [_addressField.displayText sizeWithAttributes:@{
+                   NSFontAttributeName : _addressField.font
+                 }].width) + 6;
+  // Space for the centered [icon + text] group: between the hover ⊗ on the
+  // left and, on a real page, the hover ↻ and ≡ on the right. A blank tab
+  // has neither, so the placeholder can use the pill up to its right edge.
+  // A blank tab has room to spare on the left too (the hover ⊗ simply
+  // overlaps the placeholder's leading space, as in Safari).
+  const CGFloat groupLeft =
+      hasPage ? NSMaxX(leading) + 6 : NSMinX(activeFrame) + 12;
+  const CGFloat groupRight =
+      hasPage ? NSMinX(beforeTrailing) - 6 : NSMaxX(activeFrame) - 12;
+  textW = MAX(0, MIN(textW, groupRight - groupLeft - kIconSize - 6));
+  const CGFloat groupW = kIconSize + 6 + textW;
+  const CGFloat gx =
+      MAX(groupLeft, MIN(groupRight - groupW,
+                         floor(NSMidX(activeFrame) - groupW / 2)));
+  const NSRect idleIcon = NSMakeRect(gx, iconY, kIconSize, kIconSize);
+  const NSRect idleField =
+      NSMakeRect(gx + kIconSize + 6, textY, MAX(0, textW), 18);
+  _idleGroupLocalX = gx - NSMinX(activeFrame);
+  _idleFieldX = NSMinX(idleField);
+  _editFieldX = NSMinX(editField);
+
+  // The page icon. Idle: next to the text. Editing: in the leading slot
+  // (🔍 once the user types or on a blank tab). While ⊗ covers the slot the
+  // icon fades out where it is instead of sliding under it.
+  const BOOL magnifier = !hasPage || (editing && typed);
+  _activeIcon.image =
+      magnifier ? Symbol(@"magnifyingglass", 12, NSFontWeightMedium)
+                : _activeIdleImage;
+  // Blank tab: 🔍 next to the placeholder even when idle.
+  const BOOL iconVisible =
+      editing ? !_activeHovered
+              : (_addressField.displayText.length > 0 || !hasPage);
+  const NSRect iconFrame = editing ? leading : idleIcon;
+  if (editing && (_activeHovered || _enteringEdit)) {
+    // Entering edit mode: the icon fades out where it is (the URL prefix
+    // grows over that spot) and reappears in the leading slot.
+    _iconHiddenForHover = YES;
+    [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+      context.duration = 0.08;
+      self->_activeIcon.animator.alphaValue = 0;
+    }];
+  } else {
+    if (_iconHiddenForHover) {
+      _activeIcon.frame = iconFrame;  // It was invisible: no slide.
+      _iconHiddenForHover = NO;
+    } else {
+      [self place:_activeIcon frame:iconFrame animated:overlayAnimated];
+    }
+    [self fade:_activeIcon alpha:iconVisible ? 1 : 0 animated:animated];
+  }
+
+  // The field editor does not animate frames well; set it directly (the
+  // slide is done on the layer, see -animateAddressTextForEditing:).
+  // Never re-parent the field here: that silently aborts an edit session.
+  const NSRect fieldFrame = editing ? editField : idleField;
+  const CGFloat fieldShift = NSMinX(_addressField.frame) - NSMinX(fieldFrame);
+  _addressField.frame = fieldFrame;
+  if (overlayAnimated && fabs(fieldShift) > 0.5 && _addressField.layer) {
+    // Keep the text riding with the pill while it slides (e.g. when a drag
+    // ends); the edit transition replaces this with its own slide.
+    NSAnimationContext* context = NSAnimationContext.currentContext;
+    CABasicAnimation* slide =
+        [CABasicAnimation animationWithKeyPath:@"transform.translation.x"];
+    slide.fromValue = @(fieldShift);
+    slide.toValue = @0;
+    slide.duration = context.duration;
+    slide.timingFunction = context.timingFunction ?: SafariTiming();
+    [_addressField.layer addAnimation:slide forKey:@"safariumSlide"];
+  }
+}
+
+- (void)setActiveOverlayHidden:(BOOL)hidden {
+  for (NSView* view in @[
+         _addressField, _activeIcon, _pageMenuButton, _closeActiveButton,
+         _hoverReloadButton, _clearButton, _progressLine
+       ]) {
+    if (view.hidden != hidden) {
+      view.hidden = hidden;
+    }
+  }
+  if (hidden) {
+    _focusRing.alphaValue = 0;
+  }
+}
+
+- (void)show:(SafariumOverlayButton*)button
+     visible:(BOOL)visible
+    animated:(BOOL)animated {
+  button.shown = visible;
+  [self fade:button alpha:visible ? 1 : 0 animated:animated];
+}
+
+// Safari keeps the host part of the text where it is when switching between
+// "google.com" and "https://www.google.com", then slides the whole text to
+// its new place while it fades in.
+- (void)animateAddressTextForEditing:(BOOL)editing {
+  CALayer* layer = _addressField.layer;
+  if (!layer || !_didInitialLayout || _addressField.hidden) {
+    return;
+  }
+  NSString* display = _addressField.displayText ?: @"";
+  NSString* edit = _addressField.editText ?: @"";
+  CGFloat prefixW = 0;
+  if (display.length && edit.length) {
+    NSRange r = [edit rangeOfString:display options:NSCaseInsensitiveSearch];
+    if (r.location != NSNotFound && r.location > 0) {
+      prefixW = [[edit substringToIndex:r.location] sizeWithAttributes:@{
+        NSFontAttributeName : _addressField.font
+      }].width;
+    }
+  }
+  // Offset of the host between the two layouts.
+  CGFloat delta = _idleFieldX - (_editFieldX + prefixW);
+  if (!editing) {
+    delta = -delta;
+  }
+  delta = MAX(-160, MIN(160, delta));
+
+  CABasicAnimation* slide =
+      [CABasicAnimation animationWithKeyPath:@"transform.translation.x"];
+  slide.fromValue = @(delta);
+  slide.toValue = @0;
+  slide.duration = kEditDuration;
+  slide.timingFunction = EditTiming();
+  [layer addAnimation:slide forKey:@"safariumSlide"];
+
+  CABasicAnimation* fade = [CABasicAnimation animationWithKeyPath:@"opacity"];
+  fade.fromValue = @(editing ? 0.4 : 0.0);
+  fade.toValue = @1;
+  fade.duration = editing ? 0.3 : 0.18;
+  [layer addAnimation:fade forKey:@"safariumFade"];
+}
