+@implementation SafariumOverviewCard {
+  NSView* _card;
+  NSButton* _close;
+  NSImageView* _icon;
+  NSTextField* _title;
+  NSView* _thumbnail;
+  NSImageView* _plus;
+  NSImageView* _placeholder;  // Big favicon until a thumbnail exists.
+  __weak id<SafariumOverviewDelegate> _delegate;
+  SafariumOverviewTab* _tab;
+}
+@synthesize delegate = _delegate;
+@synthesize tab = _tab;
+
+- (void)loadView {
+  SafariumCardRootView* root = [[SafariumCardRootView alloc]
+      initWithFrame:NSMakeRect(0, 0, kCardWidth, kCardHeight)];
+  __weak SafariumOverviewCard* weakSelf = self;
+  root.onClick = ^{
+    [weakSelf cardClicked:nil];
+  };
+  _card = [[NSView alloc] initWithFrame:root.bounds];
+  _card.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  _card.wantsLayer = YES;
+  _card.layer.cornerRadius = kCardCornerRadius;
+  _card.layer.masksToBounds = YES;
+  [root addSubview:_card];
+
+  // Plain layer-backed view: aspect-fill, anchored at the top of the page.
+  _thumbnail = [[NSView alloc] initWithFrame:NSZeroRect];
+  _thumbnail.wantsLayer = YES;
+  _thumbnail.layer.contentsGravity = kCAGravityResizeAspectFill;
+  _thumbnail.layer.masksToBounds = YES;
+  [_card addSubview:_thumbnail];
+
+  _close = [NSButton buttonWithImage:Symbol(@"xmark", 9, NSFontWeightSemibold)
+                              target:self
+                              action:@selector(closeClicked:)];
+  _close.bordered = NO;
+  _close.contentTintColor = NSColor.secondaryLabelColor;
+  _close.toolTip = @"Close Tab";
+  [_card addSubview:_close];
+
+  _icon = [[NSImageView alloc] initWithFrame:NSZeroRect];
+  _icon.imageScaling = NSImageScaleProportionallyUpOrDown;
+  [_card addSubview:_icon];
+
+  _title = [NSTextField labelWithString:@""];
+  _title.font = [NSFont systemFontOfSize:12];
+  _title.lineBreakMode = NSLineBreakByTruncatingTail;
+  [_card addSubview:_title];
+
+  _placeholder = [[NSImageView alloc] initWithFrame:NSZeroRect];
+  _placeholder.imageScaling = NSImageScaleProportionallyUpOrDown;
+  _placeholder.alphaValue = 0.5;
+  [_card addSubview:_placeholder];
+
+  _plus = [[NSImageView alloc] initWithFrame:NSZeroRect];
+  _plus.image = Symbol(@"plus", 28, NSFontWeightLight);
+  _plus.contentTintColor = NSColor.secondaryLabelColor;
+  [_card addSubview:_plus];
+
+  self.view = root;
+  [self refreshColors];
+}
+
+- (void)refreshColors {
+  [self.view.effectiveAppearance performAsCurrentDrawingAppearance:^{
+    self->_card.layer.backgroundColor =
+        self->_tab ? NSColor.controlBackgroundColor.CGColor
+                   : [NSColor.labelColor colorWithAlphaComponent:0.08].CGColor;
+    self->_card.layer.borderWidth = self->_tab.active ? 3 : 0;
+    self->_card.layer.borderColor = NSColor.controlAccentColor.CGColor;
+  }];
+}
+
+- (void)viewDidLayout {
+  [super viewDidLayout];
+  const NSRect b = _card.bounds;
+  const CGFloat headerY = NSHeight(b) - kCardHeader;
+  _close.frame = NSMakeRect(6, headerY + 5, 16, 16);
+  _thumbnail.frame = NSMakeRect(0, 0, NSWidth(b), headerY);
+  _plus.frame = NSMakeRect(NSMidX(b) - 20, NSMidY(b) - 20, 40, 40);
+  _placeholder.frame =
+      NSMakeRect(NSMidX(b) - 16, headerY / 2 - 16, 32, 32);
+  // Center [icon + title] in the header.
+  const CGFloat maxTitle = NSWidth(b) - 2 * 28 - 22;
+  const CGFloat titleW =
+      MIN(maxTitle, ceil([_title.stringValue sizeWithAttributes:@{
+                      NSFontAttributeName : _title.font
+                    }].width) + 4);
+  const CGFloat groupX = floor((NSWidth(b) - (16 + 6 + titleW)) / 2);
+  _icon.frame = NSMakeRect(groupX, headerY + 5, 16, 16);
+  _title.frame = NSMakeRect(groupX + 22, headerY + 4, titleW, 17);
+}
+
+- (void)setTab:(SafariumOverviewTab*)tab {
+  _tab = tab;
+  const BOOL isPlus = tab == nil;
+  _close.hidden = isPlus;
+  _icon.hidden = isPlus;
+  _title.hidden = isPlus;
+  _thumbnail.hidden = isPlus;
+  _plus.hidden = !isPlus;
+  _title.stringValue = tab.title ?: @"";
+  _icon.image = tab.favicon;
+  [self setThumbnail:nil];
+  _close.alphaValue = _icon.alphaValue = _title.alphaValue = 1;
+  _placeholder.image = tab.favicon;
+  _placeholder.hidden = isPlus;
+  self.view.toolTip = tab.title;
+  [self refreshColors];
+  self.view.needsLayout = YES;
+}
+
+- (void)setThumbnail:(NSImage*)thumbnail {
+  _thumbnail.layer.contents = thumbnail;
+  _placeholder.hidden = thumbnail != nil || _tab == nil;
+}
+
+- (NSImage*)thumbnailImage {
+  return _thumbnail.layer.contents;
+}
+
+- (NSRect)thumbnailRectInView:(NSView*)view {
+  return [_thumbnail convertRect:_thumbnail.bounds toView:view];
+}
+
+- (NSRect)headerRect {
+  const NSRect bounds = _card.bounds;
+  return NSMakeRect(0, NSHeight(bounds) - kCardHeader, NSWidth(bounds),
+                    kCardHeader);
+}
+
+- (NSRect)headerRectInView:(NSView*)view {
+  return [_card convertRect:[self headerRect] toView:view];
+}
+
+- (NSBitmapImageRep*)headerSnapshot {
+  const NSRect rect = [self headerRect];
+  NSBitmapImageRep* bitmap = [_card bitmapImageRepForCachingDisplayInRect:rect];
+  if (bitmap) {
+    // The selection outline belongs to the grid. Keep it out of the titlebar
+    // snapshot, where aspect-fit would place it around the title text.
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    const CGFloat borderWidth = _card.layer.borderWidth;
+    _card.layer.borderWidth = 0;
+    [_card cacheDisplayInRect:rect toBitmapImageRep:bitmap];
+    _card.layer.borderWidth = borderWidth;
+    [CATransaction commit];
+  }
+  return bitmap;
+}
+
+- (void)setZoomedIn:(BOOL)zoomedIn duration:(CFTimeInterval)duration {
+  [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+    context.duration = duration;
+    for (NSView* v in @[ self->_close, self->_icon, self->_title ]) {
+      v.animator.alphaValue = zoomedIn ? 0 : 1;
+    }
+  }];
+  _card.layer.borderWidth = (_tab.active && !zoomedIn) ? 3 : 0;
+}
+
+- (void)closeClicked:(id)sender {
+  if (_tab) {
+    [_delegate overviewCloseTab:_tab];
+  }
+}
+
+- (void)cardClicked:(id)sender {
+  if (_tab) {
+    [_delegate overviewSelectTab:_tab];
+  } else {
+    [_delegate overviewNewTab];
+  }
+}
+
+@end
+
+@interface SafariumOverviewView
+    : NSView <NSCollectionViewDataSource,
+              NSCollectionViewDelegateFlowLayout,
+              NSSearchFieldDelegate>
+@property(nonatomic, weak) id<SafariumOverviewDelegate> delegate;
+- (instancetype)initWithFrame:(NSRect)frame pageView:(views::View*)pageView;
+// On entry, the grid scales down from the active page. On exit, the selected
+// card's thumbnail and header expand into their own window regions.
+- (void)zoomInFromPage:(NSImage*)snapshot
+             activeTab:(int64_t)tabId
+            completion:(void (^)(void))completion;
+- (BOOL)zoomOutToTab:(int64_t)tabId completion:(void (^)(void))completion;
+- (void)updateExitThumbnail:(NSImage*)image;
+- (void)resetZoom;
+- (void)prepareForPresentation;
+- (void)setTabs:(NSArray<SafariumOverviewTab*>*)tabs;
+- (void)setThumbnail:(NSImage*)image forTab:(int64_t)tabId;
+@end
+
+@implementation SafariumOverviewView {
+  __weak id<SafariumOverviewDelegate> _delegate;
+  NSScrollView* _scroll;
+  NSCollectionView* _grid;
+  NSSearchField* _search;
+  NSArray<SafariumOverviewTab*>* _tabs;
+  NSArray<SafariumOverviewTab*>* _shown;
+  NSMutableDictionary<NSNumber*, NSImage*>* _thumbnails;
+  views::ViewTracker _pageView;
+  NSView* _exitOverlay;
+  CALayer* _exitPage;
+}
+@synthesize delegate = _delegate;
+
+- (instancetype)initWithFrame:(NSRect)frame pageView:(views::View*)pageView {
+  if ((self = [super initWithFrame:frame])) {
+    _pageView.SetView(pageView);
+    self.wantsLayer = YES;
+    _thumbnails = [NSMutableDictionary dictionary];
+    _tabs = @[];
+    _shown = @[];
+
+    NSCollectionViewFlowLayout* layout =
+        [[NSCollectionViewFlowLayout alloc] init];
+    layout.itemSize = NSMakeSize(kCardWidth, kCardHeight);
+    layout.minimumInteritemSpacing = 24;
+    layout.minimumLineSpacing = 28;
+    layout.sectionInset = NSEdgeInsetsMake(56, 32, 32, 32);
+
+    _grid = [[NSCollectionView alloc] initWithFrame:NSZeroRect];
+    _grid.collectionViewLayout = layout;
+    _grid.dataSource = self;
+    _grid.delegate = self;
+    _grid.backgroundColors = @[ NSColor.clearColor ];
+    _grid.selectable = NO;
+    [_grid registerClass:[SafariumOverviewCard class]
+        forItemWithIdentifier:kOverviewCardId];
+
+    _scroll = [[NSScrollView alloc] initWithFrame:self.bounds];
+    _scroll.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+    _scroll.documentView = _grid;
+    _scroll.drawsBackground = NO;
+    _scroll.hasVerticalScroller = YES;
+    _scroll.automaticallyAdjustsContentInsets = NO;
+    [self addSubview:_scroll];
+
+    _search = [[NSSearchField alloc] initWithFrame:NSZeroRect];
+    _search.placeholderString = @"Search Tabs";
+    _search.delegate = self;
+    _search.sendsSearchStringImmediately = YES;
+    [self addSubview:_search];
+    [self refreshColors];
+  }
+  return self;
+}
+
+- (BOOL)isFlipped {
+  return YES;
+}
+
+- (void)refreshColors {
+  [self.effectiveAppearance performAsCurrentDrawingAppearance:^{
+    NSColor* light = [NSColor colorWithSRGBRed:0.85 green:0.85 blue:0.85
+                                         alpha:1];
+    NSColor* dark = [NSColor colorWithSRGBRed:0.17 green:0.17 blue:0.17
+                                        alpha:1];
+    const BOOL isDark = [self.effectiveAppearance
+        bestMatchFromAppearancesWithNames:@[
+          NSAppearanceNameAqua, NSAppearanceNameDarkAqua
+        ]] == NSAppearanceNameDarkAqua;
+    self.layer.backgroundColor = (isDark ? dark : light).CGColor;
+  }];
+}
+
+- (void)viewDidChangeEffectiveAppearance {
+  [super viewDidChangeEffectiveAppearance];
+  [self refreshColors];
+}
+
+- (void)layout {
+  [super layout];
+  const NSRect safeArea =
+      [self convertRect:self.window.contentLayoutRect fromView:nil];
+  const CGFloat topInset = MAX(0, NSMinY(safeArea) - NSMinY(self.bounds));
+  _search.frame = NSMakeRect(NSWidth(self.bounds) - 32 - 220, topInset + 14,
+                             220, 24);
+  NSCollectionViewFlowLayout* flow =
+      (NSCollectionViewFlowLayout*)_grid.collectionViewLayout;
+  NSEdgeInsets insets = flow.sectionInset;
+  if (insets.top != topInset + 56) {
+    insets.top = topInset + 56;
+    flow.sectionInset = insets;
+  }
+}
+
+- (void)viewDidMoveToWindow {
+  [super viewDidMoveToWindow];
+  self.needsLayout = YES;
+}
+
+- (void)keyDown:(NSEvent*)event {
+  if (event.keyCode == 53) {  // Esc
+    [_delegate overviewDismiss];
+    return;
+  }
+  [super keyDown:event];
+}
+
+- (BOOL)acceptsFirstResponder {
+  return YES;
+}
+
+- (void)setTabs:(NSArray<SafariumOverviewTab*>*)tabs {
+  NSMutableSet<NSNumber*>* tabIds = [NSMutableSet setWithCapacity:tabs.count];
+  for (SafariumOverviewTab* tab in tabs) {
+    [tabIds addObject:@(tab.tabId)];
+  }
+  for (NSNumber* tabId in _thumbnails.allKeys) {
+    if (![tabIds containsObject:tabId]) {
+      [_thumbnails removeObjectForKey:tabId];
+    }
+  }
+  _tabs = tabs;
+  [self applyFilter];
+}
+
+- (void)applyFilter {
+  NSString* query = _search.stringValue;
+  if (query.length == 0) {
+    _shown = _tabs;
+  } else {
+    NSPredicate* match = [NSPredicate
+        predicateWithBlock:^BOOL(SafariumOverviewTab* tab, NSDictionary*) {
+          return [tab.title localizedCaseInsensitiveContainsString:query] ||
+                 [tab.url localizedCaseInsensitiveContainsString:query];
+        }];
+    _shown = [_tabs filteredArrayUsingPredicate:match];
+  }
+  [_grid reloadData];
+}
+
+- (void)setThumbnail:(NSImage*)image forTab:(int64_t)tabId {
+  _thumbnails[@(tabId)] = image;
+  [_grid.visibleItems enumerateObjectsUsingBlock:^(
+                          NSCollectionViewItem* item, NSUInteger, BOOL*) {
+    SafariumOverviewCard* card = (SafariumOverviewCard*)item;
+    if (card.tab.tabId == tabId) {
+      [card setThumbnail:image];
+    }
+  }];
+}
+
+// Safari fills the width with as many ~280pt columns as fit, then scales
+// the cards so the gaps stay constant.
+- (NSSize)collectionView:(NSCollectionView*)collectionView
+                    layout:(NSCollectionViewLayout*)layout
+    sizeForItemAtIndexPath:(NSIndexPath*)indexPath {
+  NSCollectionViewFlowLayout* flow = (NSCollectionViewFlowLayout*)layout;
+  const CGFloat available = NSWidth(collectionView.bounds) -
+                            flow.sectionInset.left - flow.sectionInset.right;
+  const CGFloat gap = flow.minimumInteritemSpacing;
+  const NSInteger columns =
+      MAX(1, (NSInteger)floor((available + gap) / (kCardWidth + gap)));
+  const CGFloat width = floor((available - gap * (columns - 1)) / columns);
+  // The thumbnail area has the page's aspect ratio, so zooming a card to
+  // the page lines the thumbnail up exactly with the live page.
+  const gfx::Size viewport = _pageView ? _pageView.view()->size() : gfx::Size();
+  const CGFloat aspect = viewport.IsEmpty()
+                             ? 0.62
+                             : static_cast<CGFloat>(viewport.height()) /
+                                   viewport.width();
+  return NSMakeSize(width, width * aspect + kCardHeader);
+}
+
+- (void)setFrameSize:(NSSize)size {
+  [super setFrameSize:size];
+  [_grid.collectionViewLayout invalidateLayout];
+}
+
+- (SafariumOverviewCard*)cardForTab:(int64_t)tabId {
+  for (NSCollectionViewItem* item in _grid.visibleItems) {
+    SafariumOverviewCard* card = (SafariumOverviewCard*)item;
+    if (card.tab && card.tab.tabId == tabId) {
+      return card;
+    }
+  }
+  return nil;
+}
+
+- (NSRect)pageRectInView:(NSView*)view {
+  if (!_pageView || !self.window) {
+    return NSZeroRect;
+  }
+  // The host viewport remains in place while Chromium attaches and positions
+  // the selected tab's newly active renderer view.
+  const NSRect inWindow = [self.window
+      convertRectFromScreen:gfx::ScreenRectToNSRect(
+                                _pageView.view()->GetBoundsInScreen())];
+  return [view convertRect:inWindow fromView:nil];
+}
+
+// Map the thumbnail alone onto the live viewport for the opening frame.
+- (CATransform3D)zoomTransformForCard:(SafariumOverviewCard*)card {
+  const NSRect thumbnail = [card thumbnailRectInView:_scroll];
+  const NSRect viewport = [self pageRectInView:_scroll];
+  if (NSIsEmptyRect(thumbnail) || NSIsEmptyRect(viewport)) {
+    return CATransform3DIdentity;
+  }
+  const CGFloat sx = NSWidth(viewport) / NSWidth(thumbnail);
+  const CGFloat sy = NSHeight(viewport) / NSHeight(thumbnail);
+  const CGFloat tx = NSMinX(viewport) - sx * NSMinX(thumbnail);
+  const CGFloat ty = NSMinY(viewport) - sy * NSMinY(thumbnail);
+  return CATransform3DConcat(CATransform3DMakeScale(sx, sy, 1),
+                             CATransform3DMakeTranslation(tx, ty, 0));
+}
+
+- (void)runZoomFrom:(CATransform3D)from
+                 to:(CATransform3D)to
+           duration:(CFTimeInterval)duration
+         completion:(void (^)(void))completion {
+  _scroll.wantsLayer = YES;
+  CALayer* layer = _scroll.layer;
+  [CATransaction begin];
+  [CATransaction setCompletionBlock:completion];
+  CABasicAnimation* zoom = [CABasicAnimation animationWithKeyPath:@"transform"];
+  zoom.fromValue = [NSValue valueWithCATransform3D:from];
+  zoom.toValue = [NSValue valueWithCATransform3D:to];
+  zoom.duration = duration;
+  zoom.timingFunction = EditTiming();
+  [layer addAnimation:zoom forKey:@"safariumZoom"];
+  [CATransaction commit];
+}
+
+- (void)zoomInFromPage:(NSImage*)snapshot
+             activeTab:(int64_t)tabId
+            completion:(void (^)(void))completion {
+  [self layoutSubtreeIfNeeded];
+  [_grid layoutSubtreeIfNeeded];
+  SafariumOverviewCard* card = [self cardForTab:tabId];
+  self.alphaValue = 1;
+  if (snapshot) {
+    _thumbnails[@(tabId)] = snapshot;
+    [card setThumbnail:snapshot];
+  }
+  if (!card || !snapshot) {
+    if (completion) {
+      completion();
+    }
+    return;
+  }
+  const CATransform3D zoomed = [self zoomTransformForCard:card];
+  [card setZoomedIn:YES duration:0];
+  [card setZoomedIn:NO duration:0.25];
+  // The opaque overview backdrop is already in place. Bring in its controls
+  // and other cards around the shrinking page.
+  CABasicAnimation* fade = [CABasicAnimation animationWithKeyPath:@"opacity"];
+  fade.fromValue = @0;
+  fade.toValue = @1;
+  fade.duration = 0.25;
+  [_search.layer addAnimation:fade forKey:@"safariumBackdrop"];
+  for (NSCollectionViewItem* item in _grid.visibleItems) {
+    if (item != card) {
+      item.view.wantsLayer = YES;
+      [item.view.layer addAnimation:fade forKey:@"safariumBackdrop"];
+    }
+  }
+  [self runZoomFrom:zoomed
+                 to:CATransform3DIdentity
+           duration:0.32
+         completion:completion];
+}
+
+- (BOOL)zoomOutToTab:(int64_t)tabId completion:(void (^)(void))completion {
+  if (self.alphaValue == 0) {
+    completion();
+    return NO;
+  }
+  [_grid layoutSubtreeIfNeeded];
+  SafariumOverviewCard* card = [self cardForTab:tabId];
+  NSView* content = self.window.contentView;
+  const NSRect pageFrame = [self pageRectInView:content];
+  if (!card.thumbnailImage || !content || NSIsEmptyRect(pageFrame) ||
+      [_scroll.layer animationForKey:@"safariumZoom"]) {
+    [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+      context.duration = kExitHandoffDuration;
+      self.animator.alphaValue = 0;
+    } completionHandler:completion];
+    return NO;
+  }
+
+  // Expand the page to the content viewport. Clip the card header
+  // independently as it fades out.
+  _exitOverlay = [[SafariumPassiveView alloc] initWithFrame:pageFrame];
+  _exitOverlay.wantsLayer = YES;
+  _exitOverlay.layer.masksToBounds = YES;
+  [content addSubview:_exitOverlay positioned:NSWindowAbove relativeTo:self];
+  const NSRect pageFrom = [card thumbnailRectInView:_exitOverlay];
+  const NSRect headerFrom = [card headerRectInView:_exitOverlay];
+  const NSRect pageTo = _exitOverlay.bounds;
+  const NSRect headerTo = NSMakeRect(NSMinX(pageTo), NSMaxY(pageTo),
+                                    NSWidth(pageTo), NSHeight(headerFrom));
+  const NSRect headerClipFrame = NSIntersectionRect(
+      pageTo, [_exitOverlay convertRect:self.window.contentLayoutRect
+                               fromView:nil]);
+
+  _exitPage = [CALayer layer];
+  _exitPage.contents = card.thumbnailImage;
+  _exitPage.contentsGravity = kCAGravityResizeAspectFill;
+  _exitPage.contentsScale = self.window.backingScaleFactor;
+  _exitPage.masksToBounds = YES;
+  _exitPage.maskedCorners = kCALayerMinXMinYCorner | kCALayerMaxXMinYCorner;
+
+  CALayer* header = [CALayer layer];
+  NSBitmapImageRep* headerSnapshot = [card headerSnapshot];
+  header.contents = (__bridge id)headerSnapshot.CGImage;
+  header.contentsGravity = kCAGravityResizeAspect;
+  header.contentsScale = self.window.backingScaleFactor;
+  [self.effectiveAppearance performAsCurrentDrawingAppearance:^{
+    header.backgroundColor = NSColor.controlBackgroundColor.CGColor;
+  }];
+  header.masksToBounds = YES;
+  header.maskedCorners = kCALayerMinXMaxYCorner | kCALayerMaxXMaxYCorner;
+
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  [CATransaction setCompletionBlock:completion];
+  [_exitOverlay.layer addSublayer:_exitPage];
+  CALayer* headerClip = [CALayer layer];
+  headerClip.frame = headerClipFrame;
+  headerClip.masksToBounds = YES;
+  [_exitOverlay.layer addSublayer:headerClip];
+  [headerClip addSublayer:header];
+  AnimateOverviewFrame(_exitPage, pageFrom, pageTo);
+  const CGFloat dx = -NSMinX(headerClipFrame);
+  const CGFloat dy = -NSMinY(headerClipFrame);
+  AnimateOverviewFrame(header, NSOffsetRect(headerFrom, dx, dy),
+                       NSOffsetRect(headerTo, dx, dy));
+  card.view.hidden = YES;
+
+  CABasicAnimation* fade = [CABasicAnimation animationWithKeyPath:@"opacity"];
+  fade.fromValue = @1;
+  fade.toValue = @0;
+  fade.duration = 0.22;
+  fade.fillMode = kCAFillModeForwards;
+  fade.removedOnCompletion = NO;
+  _search.wantsLayer = YES;
+  [_search.layer addAnimation:fade forKey:@"safariumBackdrop"];
+  for (NSCollectionViewItem* item in _grid.visibleItems) {
+    if (item != card) {
+      item.view.wantsLayer = YES;
+      [item.view.layer addAnimation:fade forKey:@"safariumBackdrop"];
+    }
+  }
+  // Clear the overview before handing off the page. Its corners already
+  // match the live viewport when it starts fading, so the two pages line up.
+  FadeOverviewLayer(self.layer, kExitZoomDuration - kExitHandoffDuration,
+                    kExitHandoffDuration);
+  FadeOverviewLayer(header, 0, kExitZoomDuration / 2);
+  FadeOverviewLayer(_exitPage, kExitZoomDuration, kExitHandoffDuration);
+  [CATransaction commit];
+  return YES;
+}
+
+- (void)updateExitThumbnail:(NSImage*)image {
+  CATransition* fade = [CATransition animation];
+  fade.type = kCATransitionFade;
+  fade.duration = 0.07;
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  [_exitPage addAnimation:fade forKey:@"safariumLiveFrame"];
+  _exitPage.contents = image;
+  [CATransaction commit];
+}
+
+- (void)resetZoom {
+  [_exitOverlay removeFromSuperview];
+  _exitOverlay = nil;
+  _exitPage = nil;
+  _scroll.layer.transform = CATransform3DIdentity;
+  [_scroll.layer removeAllAnimations];
+  [_search.layer removeAllAnimations];
+  [self.layer removeAllAnimations];
+  for (NSCollectionViewItem* item in _grid.visibleItems) {
+    item.view.hidden = NO;
+    [item.view.layer removeAllAnimations];
+  }
+}
+
+- (void)prepareForPresentation {
+  [self resetZoom];
+  _search.stringValue = @"";
+  [_thumbnails removeAllObjects];
+  [_scroll.contentView scrollToPoint:NSZeroPoint];
+  [_scroll reflectScrolledClipView:_scroll.contentView];
+}
+
+- (void)controlTextDidChange:(NSNotification*)notification {
+  [self applyFilter];
+}
+
+// NSCollectionViewDataSource
+- (NSInteger)collectionView:(NSCollectionView*)collectionView
+     numberOfItemsInSection:(NSInteger)section {
+  // Tabs, plus the "+" card (not while searching).
+  return _shown.count + (_search.stringValue.length ? 0 : 1);
+}
+
+- (NSCollectionViewItem*)collectionView:(NSCollectionView*)collectionView
+    itemForRepresentedObjectAtIndexPath:(NSIndexPath*)indexPath {
+  SafariumOverviewCard* card =
+      [collectionView makeItemWithIdentifier:kOverviewCardId
+                                forIndexPath:indexPath];
+  card.delegate = _delegate;
+  const NSInteger i = indexPath.item;
+  SafariumOverviewTab* tab =
+      i < (NSInteger)_shown.count ? _shown[i] : nil;
+  card.tab = tab;
+  if (tab) {
+    [card setThumbnail:_thumbnails[@(tab.tabId)]];
+  }
+  return card;
+}
+
+@end
