+// Card root view: handles the click itself (on mouse-up inside), so
+// NSCollectionView's own mouse tracking never sees it and there is no
+// double-click wait as with a gesture recognizer.
+@interface SafariumCardRootView : NSView
+@property(nonatomic, copy) void (^onClick)(void);
+@end
+
+@implementation SafariumCardRootView {
+  void (^_onClick)(void);
+}
+- (void (^)(void))onClick {
+  return _onClick;
+}
+- (void)setOnClick:(void (^)(void))onClick {
+  _onClick = [onClick copy];
+}
+- (void)mouseDown:(NSEvent*)event {
+  // Swallow: the collection view must not start a selection drag.
+}
+- (void)mouseUp:(NSEvent*)event {
+  const NSPoint p = [self convertPoint:event.locationInWindow fromView:nil];
+  if (NSPointInRect(p, self.bounds) && _onClick) {
+    _onClick();
+  }
+}
