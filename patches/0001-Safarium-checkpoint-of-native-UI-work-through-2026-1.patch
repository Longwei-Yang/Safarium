+constexpr CGFloat kRowHeight = 54;
+constexpr CGFloat kFooterHeight = 34;
+constexpr size_t kMaxVisibleRows = 5;
+
+class DownloadObserver : public download::AllDownloadItemNotifier::Observer {
+ public:
+  explicit DownloadObserver(void (^changed)(void)) : changed_(changed) {}
+
+  void OnManagerInitialized(content::DownloadManager* manager) override {
+    changed_();
+  }
+  void OnManagerGoingDown(content::DownloadManager* manager) override {
+    changed_();
+  }
+  void OnDownloadCreated(content::DownloadManager* manager,
+                         DownloadItem* item) override {
+    changed_();
+  }
+  void OnDownloadUpdated(content::DownloadManager* manager,
+                         DownloadItem* item) override {
+    changed_();
+  }
+  void OnDownloadRemoved(content::DownloadManager* manager,
+                         DownloadItem* item) override {
+    changed_();
+  }
+  void OnDownloadDestroyed(content::DownloadManager* manager,
+                           DownloadItem* item) override {
+    changed_();
+  }
+
+ private:
+  void (^changed_)(void);
+};
+
+bool IsVisible(DownloadItem* item) {
+  return !item->IsTransient() && !item->IsTemporary() &&
+         DownloadItemModel(item).ShouldShowInUi();
+}
+
+bool NeedsReview(const DownloadItem& item) {
+  return item.IsDangerous() || item.IsInsecure() ||
+         item.GetDangerType() == download::DOWNLOAD_DANGER_TYPE_ASYNC_SCANNING ||
+         item.GetDangerType() ==
+             download::DOWNLOAD_DANGER_TYPE_ASYNC_LOCAL_PASSWORD_SCANNING;
+}
+
+bool CanClear(const DownloadItem& item) {
+  // Removing an interrupted download can delete the partial file needed to
+  // resume it. Keep those entries, along with active and flagged downloads.
+  return (item.GetState() == DownloadItem::COMPLETE ||
+          item.GetState() == DownloadItem::CANCELLED) &&
+         !NeedsReview(item);
+}
+
+bool CanAccessFile(const DownloadItem& item) {
+  return item.GetState() == DownloadItem::COMPLETE && !NeedsReview(item);
+}
+
+NSString* StatusText(DownloadItem* item) {
+  if (NeedsReview(*item)) {
+    return @"Review in Downloads";
+  }
+  if (item->GetFileExternallyRemoved()) {
+    return @"File moved or deleted";
+  }
+  if (item->GetState() == DownloadItem::COMPLETE) {
+    return [NSByteCountFormatter stringFromByteCount:item->GetReceivedBytes()
+                                          countStyle:NSByteCountFormatterCountStyleFile];
+  }
+  return base::SysUTF16ToNSString(DownloadItemModel(item).GetStatusText());
+}
+
