+@implementation SafariumToolbarController {
+  RAW_PTR_EXCLUSION safarium::TabBarController* _controller;  // Weak.
+  views::ViewTracker _pageView;
+  views::ViewTracker _extensionsAnchorView;
+  SafariumTabBarView* _tabView;
+  NSToolbar* _toolbar;
+  SafariumDownloadsPopover* _downloadsPopover;
+  __weak NSWindow* _window;
+  __weak NSToolbarItemGroup* _navGroup;
+  __weak NSToolbarItem* _reloadItem;
+  __weak NSView* _extensionActionButton;
+  BOOL _extensionRefreshPending;
+  BOOL _canGoBack;
+  BOOL _canGoForward;
+  BOOL _isLoading;
+  BOOL _overview;
+  SafariumOverviewView* _overviewView;
+  NSArray<SafariumOverviewTab*>* _overviewTabs;
+  uint64_t _overviewTransition;
+  id _escMonitor;  // Local key monitor: Esc leaves the overview.
+  BOOL _closingOverview;  // Freeze the grid while zooming out of it.
+}
+
+- (instancetype)initWithTabView:(SafariumTabBarView*)tabView
+                       pageView:(views::View*)pageView
+           extensionsAnchorView:(views::View*)extensionsAnchorView {
+  if ((self = [super init])) {
+    _pageView.SetView(pageView);
+    _extensionsAnchorView.SetView(extensionsAnchorView);
+    _tabView = tabView;
+    _toolbar = [[NSToolbar alloc] initWithIdentifier:kSafariumToolbarId];
+    _toolbar.delegate = self;
+    _toolbar.displayMode = NSToolbarDisplayModeIconOnly;
+    _toolbar.allowsUserCustomization = YES;
+    _toolbar.autosavesConfiguration = YES;
+    // Like Safari, the tab strip is centered in the window.
+    _toolbar.centeredItemIdentifiers = [NSSet setWithObject:kTabsItem];
+  }
+  return self;
+}
+
+- (void)setController:(safarium::TabBarController*)controller {
+  _controller = controller;
+}
+
+- (void)installInWindow:(NSWindow*)window {
+  _window = window;
+  window.backgroundColor = NSColor.windowBackgroundColor;
+  window.titleVisibility = NSWindowTitleHidden;
+  window.toolbarStyle = NSWindowToolbarStyleUnified;
+  window.toolbar = _toolbar;
+}
+
+- (void)uninstall {
+  ++_overviewTransition;
+  [_downloadsPopover close];
+  if (_window.toolbar == _toolbar) {
+    _window.toolbar = nil;
+  }
+  _toolbar.delegate = nil;
+  _overviewView.delegate = nil;
+  [_overviewView resetZoom];
+  [_overviewView removeFromSuperview];
+  if (_escMonitor) {
+    [NSEvent removeMonitor:_escMonitor];
+    _escMonitor = nil;
+  }
+  _controller = nullptr;
+}
+
+// --- NSToolbarDelegate ----------------------------------------------------
+
+- (NSArray<NSToolbarItemIdentifier>*)toolbarDefaultItemIdentifiers:
+    (NSToolbar*)toolbar {
+  // On macOS 26 adjacent items share one glass platter; space items split
+  // them into Safari's separate groups.
+  return @[
+    kNavItem, NSToolbarSpaceItemIdentifier, kReloadItem,
+    NSToolbarFlexibleSpaceItemIdentifier, kTabsItem,
+    NSToolbarFlexibleSpaceItemIdentifier, kDownloadsItem, kNewTabItem,
+    kShareItem, kOverviewItem
+  ];
+}
+
+- (NSArray<NSToolbarItemIdentifier>*)toolbarAllowedItemIdentifiers:
+    (NSToolbar*)toolbar {
+  NSMutableOrderedSet<NSToolbarItemIdentifier>* identifiers =
+      [NSMutableOrderedSet orderedSetWithArray:@[
+    kNavItem, kReloadItem, kTabsItem, kNewTabItem, kHomeItem, kDownloadsItem,
+    kHistoryItem, kBookmarksItem, kShareItem, kPrintItem, kOverviewItem,
+    NSToolbarSpaceItemIdentifier, NSToolbarFlexibleSpaceItemIdentifier
+  ]];
+  if (auto* extensions = _controller ? _controller->GetExtensionsContainer()
+                                     : nullptr) {
+    for (const auto& id : extensions->GetToolbarViewModel()->GetAllActionIds()) {
+      [identifiers addObject:[kExtensionItemPrefix
+                                 stringByAppendingString:base::SysUTF8ToNSString(id)]];
+    }
+  }
+  // AppKit restores its saved order before Chromium may have finished loading
+  // the extensions. Keep those item identifiers available for restoration.
+  for (NSString* identifier in [NSUserDefaults.standardUserDefaults
+           stringArrayForKey:kSavedExtensionToolbarItems]) {
+    [identifiers addObject:identifier];
+  }
+  return identifiers.array;
+}
+
+- (NSToolbarItem*)toolbar:(NSToolbar*)toolbar
+        itemForItemIdentifier:(NSToolbarItemIdentifier)identifier
+    willBeInsertedIntoToolbar:(BOOL)flag {
+  if ([identifier isEqualToString:kNavItem]) {
+    NSToolbarItemGroup* group = [NSToolbarItemGroup
+        groupWithItemIdentifier:identifier
+                         images:@[
+                           Symbol(@"chevron.left", 14, NSFontWeightMedium),
+                           Symbol(@"chevron.right", 14, NSFontWeightMedium)
+                         ]
+                  selectionMode:NSToolbarItemGroupSelectionModeMomentary
+                         labels:@[ @"Back", @"Forward" ]
+                         target:self
+                         action:@selector(navigate:)];
+    group.label = @"Back/Forward";
+    group.paletteLabel = @"Back/Forward";
+    group.autovalidates = NO;
+    if (flag) {
+      _navGroup = group;
+      [self refreshItems];
+    }
+    return group;
+  }
+  if ([identifier isEqualToString:kReloadItem]) {
+    NSToolbarItem* item = [self buttonItem:identifier
+                                     label:@"Reload"
+                                    symbol:@"arrow.clockwise"
+                                    action:@selector(reload:)];
+    if (flag) {
+      _reloadItem = item;
+      [self refreshItems];
+    }
+    return item;
+  }
+  if ([identifier isEqualToString:kTabsItem]) {
+    NSToolbarItem* item = [[NSToolbarItem alloc] initWithItemIdentifier:identifier];
+    item.label = @"Tabs";
+    item.paletteLabel = @"Tabs";
+    if (flag) {
+      item.view = _tabView;
+    } else {
+      // Palette preview: a tab-strip capsule (gray, like the real one).
+      NSView* preview = [[NSView alloc] initWithFrame:NSZeroRect];
+      preview.wantsLayer = YES;
+      preview.layer.cornerRadius = kControlHeight / 2;
+      preview.layer.backgroundColor =
+          [NSColor.labelColor colorWithAlphaComponent:0.10].CGColor;
+      preview.translatesAutoresizingMaskIntoConstraints = NO;
+      [preview.widthAnchor constraintEqualToConstant:160].active = YES;
+      [preview.heightAnchor constraintEqualToConstant:kControlHeight].active =
+          YES;
+      item.view = preview;
+    }
+    return item;
+  }
+  if ([identifier isEqualToString:kNewTabItem]) {
+    return [self buttonItem:identifier
+                      label:@"New Tab"
+                     symbol:@"plus"
+                     action:@selector(newTab:)];
+  }
+  if ([identifier isEqualToString:kDownloadsItem]) {
+    return [self buttonItem:identifier
+                      label:@"Downloads"
+                     symbol:@"arrow.down.circle"
+                     action:@selector(toggleDownloads:)];
+  }
+  if ([identifier hasPrefix:kExtensionItemPrefix]) {
+    return [self extensionItem:identifier willBeInserted:flag];
+  }
+  if ([identifier isEqualToString:kOverviewItem]) {
+    NSToolbarItem* item = [self buttonItem:identifier
+                                     label:@"Show Tab Overview"
+                                    symbol:@"square.on.square"
+                                    action:@selector(toggleOverview:)];
+    item.paletteLabel = @"Tab Overview";
+    return item;
+  }
+  if ([identifier isEqualToString:kShareItem]) {
+    NSSharingServicePickerToolbarItem* item =
+        [[NSSharingServicePickerToolbarItem alloc]
+            initWithItemIdentifier:identifier];
+    item.label = @"Share";
+    item.paletteLabel = @"Share";
+    item.delegate = self;
+    return item;
+  }
+  for (const CommandItemSpec& spec : kCommandItems) {
+    if ([identifier isEqualToString:@(spec.identifier)]) {
+      NSToolbarItem* item = [self buttonItem:identifier
+                                       label:@(spec.label)
+                                      symbol:@(spec.symbol)
+                                      action:@selector(runCommand:)];
+      item.tag = spec.command;
+      return item;
+    }
+  }
+  return nil;
+}
+
+- (NSToolbarItem*)buttonItem:(NSToolbarItemIdentifier)identifier
+                       label:(NSString*)label
+                      symbol:(NSString*)symbol
+                      action:(SEL)action {
+  NSToolbarItem* item = [[NSToolbarItem alloc] initWithItemIdentifier:identifier];
+  item.label = label;
+  item.paletteLabel = label;
+  item.toolTip = label;
+  item.image = Symbol(symbol, 14, NSFontWeightMedium);
+  item.bordered = YES;
+  item.target = self;
+  item.action = action;
+  item.autovalidates = NO;
+  return item;
+}
+
+- (NSToolbarItem*)extensionItem:(NSToolbarItemIdentifier)identifier
+             willBeInserted:(BOOL)willBeInserted {
+  NSString* extensionID =
+      [identifier substringFromIndex:kExtensionItemPrefix.length];
+  std::string id = base::SysNSStringToUTF8(extensionID);
+  auto* extensions = _controller ? _controller->GetExtensionsContainer()
+                                : nullptr;
+  auto* action = extensions ? extensions->GetActionForId(id) : nullptr;
+  if (!action && !willBeInserted) {
+    return nil;
+  }
+
+  NSString* name =
+      action ? base::SysUTF16ToNSString(action->GetActionName()) : @"Extension";
+  NSToolbarItem* item =
+      [[NSToolbarItem alloc] initWithItemIdentifier:identifier];
+  item.label = name;
+  item.paletteLabel = name;
+  item.toolTip = name;
+  item.autovalidates = NO;
+
+  NSImage* image = action ? [self imageForExtension:id]
+                          : Symbol(@"puzzlepiece.extension", 14,
+                                   NSFontWeightRegular);
+  NSButton* button = [NSButton buttonWithImage:image
+                                        target:self
+                                        action:@selector(runExtension:)];
+  // The toolbar supplies the Liquid Glass background.
+  button.bezelStyle = NSBezelStyleToolbar;
+  button.identifier = identifier;
+  button.toolTip = name;
+  button.accessibilityLabel = name;
+  button.translatesAutoresizingMaskIntoConstraints = NO;
+  [button.widthAnchor constraintEqualToConstant:kControlHeight].active = YES;
+  [button.heightAnchor constraintEqualToConstant:kControlHeight].active = YES;
+  item.view = button;
+
+  NSMenuItem* overflowItem =
+      [[NSMenuItem alloc] initWithTitle:name
+                                action:@selector(runExtension:)
+                         keyEquivalent:@""];
+  overflowItem.target = self;
+  overflowItem.representedObject = identifier;
+  item.menuFormRepresentation = overflowItem;
+
+  if (!action) {
+    item.enabled = NO;
+    if (@available(macOS 15.0, *)) {
+      item.hidden = YES;
+    }
+  }
+  return item;
+}
+
+- (void)toolbarWillAddItem:(NSNotification*)notification {
+  NSToolbarItem* item = notification.userInfo[NSToolbarItemKey];
+  NSString* identifier = item.itemIdentifier;
+  if (![identifier hasPrefix:kExtensionItemPrefix]) {
+    return;
+  }
+  NSUserDefaults* defaults = NSUserDefaults.standardUserDefaults;
+  NSArray<NSString*>* known =
+      [defaults stringArrayForKey:kSavedExtensionToolbarItems] ?: @[];
+  if (![known containsObject:identifier]) {
+    [defaults setObject:[known arrayByAddingObject:identifier]
+                 forKey:kSavedExtensionToolbarItems];
+  }
+}
+
+- (NSImage*)imageForExtension:(const std::string&)id {
+  gfx::ImageSkia icon =
+      _controller->GetExtensionsContainer()->GetNativeToolbarActionIcon(id);
+  return icon.isNull() ? Symbol(@"puzzlepiece.extension", 14, NSFontWeightRegular)
+                       : gfx::NSImageFromImageSkia(icon);
+}
+
+- (void)scheduleExtensionItemRefresh {
+  if (_extensionRefreshPending) {
+    return;
+  }
+  _extensionRefreshPending = YES;
+  __weak SafariumToolbarController* weakSelf = self;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    [weakSelf refreshExtensionItems];
+  });
+}
+
+- (void)refreshExtensionItems {
+  _extensionRefreshPending = NO;
+  auto* extensions = _controller ? _controller->GetExtensionsContainer()
+                                : nullptr;
+  if (!extensions) {
+    return;
+  }
+  for (NSToolbarItem* item in _toolbar.items) {
+    if (![item.itemIdentifier hasPrefix:kExtensionItemPrefix]) {
+      continue;
+    }
+    NSString* extensionID = [item.itemIdentifier
+        substringFromIndex:kExtensionItemPrefix.length];
+    std::string id = base::SysNSStringToUTF8(extensionID);
+    auto* action = extensions->GetActionForId(id);
+    const bool available = action != nullptr;
+    item.enabled = available;
+    if (@available(macOS 15.0, *)) {
+      item.hidden = !available;
+    }
+    if (available) {
+      NSString* name = base::SysUTF16ToNSString(action->GetActionName());
+      item.label = name;
+      item.paletteLabel = name;
+      item.toolTip = name;
+      item.view.accessibilityLabel = name;
+      item.menuFormRepresentation.title = name;
+      item.image = [self imageForExtension:id];
+    }
+  }
+}
+
+// --- State ---------------------------------------------------------------
+
+- (void)updateState:(const safarium::BarState&)state {
+  _canGoBack = state.can_go_back;
+  _canGoForward = state.can_go_forward;
+  _isLoading = state.is_loading;
+  NSMutableArray<SafariumOverviewTab*>* tabs = [NSMutableArray array];
+  for (size_t i = 0; i < state.tabs.size(); ++i) {
+    const safarium::TabItem& t = state.tabs[i];
+    SafariumOverviewTab* tab = [[SafariumOverviewTab alloc] init];
+    tab.tabId = t.id;
+    tab.index = static_cast<NSInteger>(i);
+    tab.title = base::SysUTF16ToNSString(t.title);
+    tab.url = base::SysUTF16ToNSString(t.edit_url);
+    tab.favicon = t.favicon.IsEmpty() ? Symbol(@"globe", 12, NSFontWeightRegular)
+                                      : t.favicon.ToNSImage();
+    tab.active = t.active;
+    [tabs addObject:tab];
+  }
+  _overviewTabs = tabs;
+  if (_overview && !_closingOverview) {
+    [_overviewView setTabs:tabs];
+  }
+  [self refreshItems];
+}
+
+- (void)thumbnailChanged:(NSImage*)image forTab:(int64_t)tabId {
+  if (_overview && !_closingOverview) {
+    [_overviewView setThumbnail:image forTab:tabId];
+  }
+}
+
+// --- Tab overview ---------------------------------------------------------
+
+- (int64_t)activeTabId {
+  for (SafariumOverviewTab* tab in _overviewTabs) {
+    if (tab.active) {
+      return tab.tabId;
+    }
+  }
+  return 0;
+}
+
+- (void)showOverviewView:(BOOL)show zoomToTab:(int64_t)tabId {
+  NSView* content = _window.contentView;
+  if (!content) {
+    return;
+  }
+  const uint64_t transition = _overviewTransition;
+  if (show) {
+    if (!_overviewView) {
+      _overviewView = [[SafariumOverviewView alloc]
+          initWithFrame:content.bounds pageView:_pageView.view()];
+      _overviewView.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+      _overviewView.delegate = self;
+    }
+    _closingOverview = NO;
+    [_overviewView prepareForPresentation];
+    _overviewView.frame = content.bounds;
+    [_overviewView setTabs:_overviewTabs ?: @[]];
+    // Hidden until the page snapshot arrives, then zoom out from it.
+    _overviewView.alphaValue = 0;
+    [content addSubview:_overviewView positioned:NSWindowAbove relativeTo:nil];
+    [_window makeFirstResponder:_overviewView];
+    if (!_controller) {
+      _overviewView.alphaValue = 1;
+      return;
+    }
+    _controller->SetWantsThumbnails(true);
+    __weak SafariumToolbarController* weakSelf = self;
+    if (!_escMonitor) {
+      __weak NSWindow* window = _window;
+      _escMonitor = [NSEvent
+          addLocalMonitorForEventsMatchingMask:NSEventMaskKeyDown
+                                       handler:^NSEvent*(NSEvent* event) {
+                                         SafariumToolbarController* strong =
+                                             weakSelf;
+                                         if (strong && strong->_overview &&
+                                             event.window == window &&
+                                             event.keyCode == 53) {
+                                           [strong setOverview:NO];
+                                           return nil;
+                                         }
+                                         return event;
+                                       }];
+    }
+    _controller->CaptureActiveTab(base::BindOnce(
+        [](__weak SafariumToolbarController* weak_self, uint64_t transition,
+           int64_t active_id, gfx::ImageSkia image) {
+          SafariumToolbarController* strongSelf = weak_self;
+          if (!strongSelf || strongSelf->_overviewTransition != transition) {
+            return;
+          }
+          NSImage* snapshot =
+              !image.isNull() && [strongSelf activeTabId] == active_id
+                  ? gfx::NSImageFromImageSkia(image)
+                  : nil;
+          [strongSelf->_overviewView zoomInFromPage:snapshot
+                                          activeTab:active_id
+                                         completion:nil];
+        },
+        weakSelf, transition, tabId));
+  } else {
+    SafariumOverviewView* view = _overviewView;
+    if (_escMonitor) {
+      [NSEvent removeMonitor:_escMonitor];
+      _escMonitor = nil;
+    }
+    if (_controller) {
+      _controller->SetWantsThumbnails(false);
+    }
+    __weak SafariumToolbarController* weakSelf = self;
+    const BOOL zooming = [view zoomOutToTab:tabId
+                               completion:^{
+      SafariumToolbarController* strongSelf = weakSelf;
+      if (!strongSelf || strongSelf->_overviewTransition != transition) {
+        return;
+      }
+      strongSelf->_closingOverview = NO;
+      [view removeFromSuperview];
+      [view resetZoom];
+      if (strongSelf->_controller && [strongSelf activeTabId] == tabId) {
+        strongSelf->_controller->FocusActiveTab();
+      }
+    }];
+    if (zooming && _controller && [self activeTabId] == tabId) {
+      // The animation starts immediately. Use a live frame if it arrives
+      // early enough to blend into the card before the final handoff.
+      _controller->CaptureActiveTab(base::BindOnce(
+          [](__weak SafariumToolbarController* weak_self, uint64_t transition,
+             int64_t tab_id, CFTimeInterval deadline, gfx::ImageSkia image) {
+            SafariumToolbarController* strongSelf = weak_self;
+            if (!strongSelf || strongSelf->_overviewTransition != transition ||
+                !strongSelf->_closingOverview || image.isNull() ||
+                CACurrentMediaTime() > deadline ||
+                [strongSelf activeTabId] != tab_id) {
+              return;
+            }
+            [strongSelf->_overviewView
+                updateExitThumbnail:gfx::NSImageFromImageSkia(image)];
+          },
+          weakSelf, transition, tabId,
+          CACurrentMediaTime() + kExitSnapshotDeadline));
+    }
+  }
+}
+
+- (void)overviewSelectTab:(SafariumOverviewTab*)tab {
+  // Zoom into the chosen card (the page comes up underneath).
+  _closingOverview = YES;
+  if (_controller) {
+    _controller->ActivateTab(static_cast<int>(tab.index));
+  }
+  [self setOverview:NO zoomToTab:tab.tabId];
+}
+
+- (void)overviewCloseTab:(SafariumOverviewTab*)tab {
+  if (_controller) {
+    _controller->CloseTab(static_cast<int>(tab.index));
+  }
+}
+
+- (void)overviewNewTab {
+  [self setOverview:NO zoomToTab:0];
+  if (_controller) {
+    _controller->NewTab();
+  }
+}
+
+- (void)overviewDismiss {
+  [self setOverview:NO];
+}
+
+// All toolbar state changes go through one animation context so AppKit's
+// implicit animations (item hiding/re-layout, enablement) run instead of
+// jumping.
+- (void)refreshItems {
+  [self applyItemState];
+}
+
+- (void)applyItemState {
+  // Like Safari, the tab overview has no page to navigate: hide Back/Forward
+  // (and the space separating it from Reload) with the native API.
+  NSToolbarItemGroup* nav = _navGroup;
+  if (@available(macOS 15.0, *)) {
+    NSArray<NSToolbarItem*>* items = _toolbar.items;
+    const NSUInteger navIndex = nav ? [items indexOfObject:nav] : NSNotFound;
+    if (navIndex != NSNotFound && nav.hidden != _overview) {
+      nav.hidden = _overview;
+      if (navIndex + 1 < items.count &&
+          [items[navIndex + 1].itemIdentifier
+              isEqualToString:NSToolbarSpaceItemIdentifier]) {
+        items[navIndex + 1].hidden = _overview;
+      }
+    }
+  }
+  if (nav.subitems.count == 2) {
+    nav.subitems[0].enabled = _canGoBack;
+    nav.subitems[1].enabled = _canGoForward;
+  }
+  NSImage* reloadImage =
+      Symbol(_isLoading ? @"xmark" : @"arrow.clockwise", 14, NSFontWeightMedium);
+  NSString* reloadLabel = _isLoading ? @"Stop" : @"Reload";
+  NSToolbarItem* reload = _reloadItem;
+  reload.image = reloadImage;
+  reload.label = reloadLabel;
+  reload.toolTip = reloadLabel;
+
+}
+
+// --- Actions ---------------------------------------------------------------
+
+- (void)navigate:(NSToolbarItemGroup*)sender {
+  if (!_controller) {
+    return;
+  }
+  if (sender.selectedIndex == 0) {
+    _controller->GoBack();
+  } else if (sender.selectedIndex == 1) {
+    _controller->GoForward();
+  }
+}
+
+- (void)reload:(id)sender {
+  if (!_controller) {
+    return;
+  }
+  if (_isLoading) {
+    _controller->Stop();
+  } else {
+    _controller->Reload();
+  }
+}
+
+- (void)newTab:(id)sender {
+  if (_controller) {
+    _controller->NewTab();
+  }
+}
+
+- (void)toggleOverview:(id)sender {
+  [self setOverview:!_overview];
+}
+
+- (void)setOverview:(BOOL)overview {
+  [self setOverview:overview zoomToTab:[self activeTabId]];
+}
+
+- (void)setOverview:(BOOL)overview zoomToTab:(int64_t)tabId {
+  if (_overview == overview) {
+    return;
+  }
+  ++_overviewTransition;
+  _overview = overview;
+  _closingOverview = !overview;
+  for (NSToolbarItem* item in _toolbar.items) {
+    if ([item.itemIdentifier isEqualToString:kShareItem]) {
+      item.enabled = !overview;
+    }
+  }
+  [self refreshItems];
+  [_tabView setOverviewMode:overview];
+  [self showOverviewView:overview zoomToTab:tabId];
+}
+
+- (void)runCommand:(NSToolbarItem*)sender {
+  if (_controller) {
+    _controller->ExecuteCommand(static_cast<int>(sender.tag));
+  }
+}
+
+- (void)toggleDownloads:(NSToolbarItem*)sender {
+  if (!_controller) {
+    return;
+  }
+  if (!_downloadsPopover) {
+    _downloadsPopover = [[SafariumDownloadsPopover alloc] init];
+  }
+  __weak SafariumToolbarController* weakSelf = self;
+  [_downloadsPopover toggleForProfile:_controller->GetProfile()
+                             toolbarItem:sender
+                                  showAll:^{
+    SafariumToolbarController* strongSelf = weakSelf;
+    if (strongSelf && strongSelf->_controller) {
+      strongSelf->_controller->ExecuteCommand(IDC_SHOW_DOWNLOADS);
+    }
+  }];
+}
+
+- (void)runExtension:(id)sender {
+  auto* extensions = _controller ? _controller->GetExtensionsContainer()
+                                : nullptr;
+  if (!extensions || !_extensionsAnchorView.view()) {
+    return;
+  }
+  NSButton* button = [sender isKindOfClass:NSButton.class] ? sender : nil;
+  NSString* identifier = button ? button.identifier : [sender representedObject];
+  if (![identifier hasPrefix:kExtensionItemPrefix]) {
+    return;
+  }
+  std::string id = base::SysNSStringToUTF8(
+      [identifier substringFromIndex:kExtensionItemPrefix.length]);
+  if (extensions->GetActionForId(id)) {
+    _extensionActionButton = button;
+    extensions->ExecuteNativeToolbarAction(id, _extensionsAnchorView.view());
+  }
+}
+
+- (gfx::Rect)extensionActionBounds {
+  NSView* button = _extensionActionButton;
+  NSWindow* window = _window;
+  if (window && button.window == window && !button.hiddenOrHasHiddenAncestor) {
+    NSRect bounds = [button convertRect:button.bounds toView:nil];
+    return gfx::ScreenRectFromNSRect([window convertRectToScreen:bounds]);
+  }
+  // The toolbar overflow menu can also invoke the action.
+  if (views::View* page = _pageView.view()) {
+    gfx::Rect bounds = page->GetBoundsInScreen();
+    return gfx::Rect(bounds.right() - 12, bounds.y(), 1, 1);
+  }
+  return gfx::Rect();
+}
+
+// --- NSSharingServicePickerToolbarItemDelegate -----------------------------
+
+- (NSArray*)itemsForSharingServicePickerToolbarItem:
+    (NSSharingServicePickerToolbarItem*)pickerToolbarItem {
+  if (!_controller) {
+    return @[];
+  }
+  const GURL url = _controller->ActiveURL();
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return @[];
+  }
+  return @[ net::NSURLWithGURL(url) ];
+}
