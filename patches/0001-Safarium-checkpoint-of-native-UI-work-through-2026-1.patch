+// --------------------------------------------------------------------------
+// State
+
+- (void)updateState:(const safarium::BarState&)state {
+  const BOOL navChanged = _canGoBack != state.can_go_back ||
+                          _canGoForward != state.can_go_forward;
+  _canGoBack = state.can_go_back;
+  _canGoForward = state.can_go_forward;
+  _isLoading = state.is_loading;
+  const BOOL progressChanged = _loadProgress != state.load_progress;
+  _loadProgress = state.load_progress;
+
+  // Where each existing tab is on screen right now (window x; includes any
+  // animation in flight), so a tab-count change can slide them from there.
+  NSMapTable<SafariumTabCell*, NSNumber*>* oldWindowX =
+      [NSMapTable weakToStrongObjectsMapTable];
+  for (SafariumTabCell* cell in _cells) {
+    if (cell.window && !NSIsEmptyRect(cell.frame)) {
+      CALayer* presented = cell.layer.presentationLayer ?: cell.layer;
+      const NSPoint origin = [cell.superview
+          convertPoint:NSMakePoint(presented.frame.origin.x, 0)
+                toView:nil];
+      [oldWindowX setObject:@(origin.x) forKey:cell];
+    }
+  }
+
+  // Reconcile cells with tabs by identity, so moved tabs keep their cell
+  // (and slide to the new slot) and the right cell disappears on close.
+  const NSUInteger count = state.tabs.size();
+  NSMutableArray<SafariumTabCell*>* cells =
+      [NSMutableArray arrayWithCapacity:count];
+  NSMutableSet<NSNumber*>* live = [NSMutableSet setWithCapacity:count];
+  for (const safarium::TabItem& t : state.tabs) {
+    NSNumber* key = @(t.id);
+    [live addObject:key];
+    SafariumTabCell* cell = _cellsById[key];
+    if (!cell) {
+      cell = [[SafariumTabCell alloc] initWithFrame:NSZeroRect];
+      cell.bar = self;
+      [_strip addSubview:cell positioned:NSWindowBelow relativeTo:_focusRing];
+      _cellsById[key] = cell;
+    }
+    [cells addObject:cell];
+  }
+  for (NSNumber* key in _cellsById.allKeys) {
+    if ([live containsObject:key]) {
+      continue;
+    }
+    SafariumTabCell* gone = _cellsById[key];
+    [_cellsById removeObjectForKey:key];
+    if (gone == _dragCell) {
+      _dragCell = nil;
+    }
+    if (gone == _pressCell) {
+      _pressCell = nil;
+    }
+    [NSAnimationContext
+        runAnimationGroup:^(NSAnimationContext* context) {
+          context.duration = kAnimationDuration;
+          gone.animator.alphaValue = 0;
+        }
+        completionHandler:^{
+          [gone removeFromSuperview];
+        }];
+  }
+  const BOOL countChanged = cells.count != _cells.count;
+  const BOOL orderChanged = !countChanged && ![cells isEqualToArray:_cells];
+  _cells = cells;
+
+  SafariumTabCell* previousActiveCell = _activeCell;
+  SafariumTabCell* newActiveCell =
+      (state.active_index >= 0 && state.active_index < (int)count)
+          ? _cells[state.active_index]
+          : nil;
+  const BOOL activeChanged = newActiveCell != previousActiveCell;
+  if (activeChanged && previousActiveCell && !countChanged &&
+      [_cells containsObject:previousActiveCell]) {
+    // Its content was drawn by the overlay, centered in the pill.
+    [previousActiveCell noteContentWasAtX:_idleGroupLocalX];
+  }
+  _activeCell = newActiveCell;
+  for (NSUInteger i = 0; i < count; ++i) {
+    const safarium::TabItem& t = state.tabs[i];
+    SafariumTabCell* cell = _cells[i];
+    NSString* title = base::SysUTF16ToNSString(t.title);
+    NSImage* favicon = t.favicon.IsEmpty() ? nil : t.favicon.ToNSImage();
+    if (!favicon) {
+      favicon = Symbol(@"globe", 12, NSFontWeightRegular);
+    }
+    cell.index = i;
+    cell.pinned = t.pinned;
+    cell.active = t.active;
+    cell.titleLabel.stringValue = title;
+    cell.toolTip = title;
+    [cell setIcon:favicon];
+    cell.needsLayout = YES;
+    if (t.active) {
+      _pageIdleImage =
+          t.is_search ? Symbol(@"magnifyingglass", 12, NSFontWeightMedium)
+                      : favicon;
+      _activeIcon.contentTintColor = NSColor.secondaryLabelColor;
+      _pageDisplayText = base::SysUTF16ToNSString(t.display_url);
+      _pageEditText = base::SysUTF16ToNSString(t.edit_url);
+      [self applyPageTexts];
+    }
+  }
+  _activeIndex = state.active_index;
+  _activeChangedThisLayout = activeChanged;
+  _revealActive = _activeChangedThisLayout || countChanged;
+  if (_activeChangedThisLayout) {
+    _activeHovered = _activeIndex >= 0 && _activeIndex < (NSInteger)count &&
+                     _cells[_activeIndex].hovered;
+  }
+  if (activeChanged && _addressField.editing) {
+    [self.window makeFirstResponder:nil];  // Ends editing → idle text.
+  }
+  [_addressField showIdleText];
+
+  const BOOL animate = _didInitialLayout &&
+                       (countChanged || navChanged || activeChanged ||
+                        orderChanged);
+  _didInitialLayout = YES;
+  if (animate) {
+    [self updatePreferredWidthAnimated:countChanged];
+    if (countChanged) {
+      // The strip is re-centred and resized while the toolbar item grows or
+      // shrinks; frame animations inside it fight that. Instead put every
+      // tab at its final place and slide it there from where it was on
+      // screen (a pure translation, independent of the strip geometry).
+      _placeTabsDirectly = YES;
+      [self relayoutAnimated:YES];
+      _placeTabsDirectly = NO;
+      for (SafariumTabCell* cell in _cells) {
+        NSNumber* oldX = [oldWindowX objectForKey:cell];
+        if (!oldX) {
+          continue;
+        }
+        const CGFloat newX =
+            [cell.superview convertPoint:cell.frame.origin toView:nil].x;
+        const CGFloat delta = oldX.doubleValue - newX;
+        if (fabs(delta) < 0.5) {
+          continue;
+        }
+        CABasicAnimation* slide =
+            [CABasicAnimation animationWithKeyPath:@"transform.translation.x"];
+        slide.fromValue = @(delta);
+        slide.toValue = @0;
+        slide.duration = kAnimationDuration + 0.06;
+        slide.timingFunction = SafariTiming();
+        [cell.layer addAnimation:slide forKey:@"safariumReflow"];
+      }
+    } else {
+      [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+        context.duration = kAnimationDuration;
+        context.timingFunction = SafariTiming();
+        context.allowsImplicitAnimation = YES;
+        [self relayoutAnimated:YES];
+      }];
+    }
+  } else if (progressChanged) {
+    [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+      context.duration = 0.2;
+      [self relayoutAnimated:NO];
+    }];
+  } else {
+    [self updatePreferredWidthAnimated:NO];
+    [self relayoutAnimated:NO];
+  }
+  _activeChangedThisLayout = NO;
+  _revealActive = NO;
+  if (!_dragCell) {
+    [self refreshHoverAfterDelay];
+  }
+}
+
+// After cells finish sliding, sync hover with where the pointer really is.
+- (void)refreshHoverAfterDelay {
+  __weak SafariumTabBarView* weakSelf = self;
+  dispatch_after(
+      dispatch_time(DISPATCH_TIME_NOW,
+                    (int64_t)((kAnimationDuration + 0.05) * NSEC_PER_SEC)),
+      dispatch_get_main_queue(), ^{
+        SafariumTabBarView* strongSelf = weakSelf;
+        if (!strongSelf || strongSelf->_dragCell) {
+          return;
+        }
+        for (SafariumTabCell* cell in strongSelf->_cells) {
+          [cell refreshHoverFromPointer];
+        }
+      });
+}
+
+// In the tab overview the pill is an empty "Search or enter website name"
+// field, like Safari's.
+- (void)applyPageTexts {
+  _activeIdleImage = _overviewMode ? nil : _pageIdleImage;
+  _addressField.displayText = _overviewMode ? @"" : _pageDisplayText;
+  _addressField.editText = _overviewMode ? @"" : _pageEditText;
+}
+
+- (void)setOverviewMode:(BOOL)overview {
+  if (_overviewMode == overview) {
+    return;
+  }
+  _overviewMode = overview;
+  if (_addressField.editing) {
+    [self.window makeFirstResponder:nil];
+  }
+  // Fade the old contents out, swap, fade the new ones in (a plain
+  // cross-fade overlaps two texts at different positions). Uses alphaValue,
+  // not layer opacity, which AppKit owns for layer-backed views.
+  __weak SafariumTabBarView* weakSelf = self;
+  [NSAnimationContext
+      runAnimationGroup:^(NSAnimationContext* context) {
+        context.duration = 0.12;
+        self->_addressField.animator.alphaValue = 0;
+        self->_activeIcon.animator.alphaValue = 0;
+        self->_pageMenuButton.animator.alphaValue = 0;
+      }
+      completionHandler:^{
+        SafariumTabBarView* strongSelf = weakSelf;
+        if (!strongSelf) {
+          return;
+        }
+        [strongSelf applyPageTexts];
+        [strongSelf->_addressField showIdleText];
+        // Lay out at the new content with the field still invisible, then
+        // fade the field in; icon and ≡ fade to whatever the layout wants.
+        [strongSelf relayoutAnimated:NO];
+        const CGFloat iconAlpha = strongSelf->_activeIcon.alphaValue;
+        const CGFloat menuAlpha = strongSelf->_pageMenuButton.alphaValue;
+        strongSelf->_activeIcon.alphaValue = 0;
+        strongSelf->_pageMenuButton.alphaValue = 0;
+        [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+          context.duration = 0.2;
+          strongSelf->_addressField.animator.alphaValue = 1;
+          strongSelf->_activeIcon.animator.alphaValue = iconAlpha;
+          strongSelf->_pageMenuButton.animator.alphaValue = menuAlpha;
+        }];
+      }];
+}
+
+- (void)tabCellHoverChanged:(SafariumTabCell*)cell {
+  if (!cell.active || _activeHovered == cell.hovered) {
+    return;
+  }
+  _activeHovered = cell.hovered;
+  [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+    context.duration = 0.12;
+    [self relayoutAnimated:YES];
+  }];
+}
+
+- (void)addressFieldEditingChanged {
+  const BOOL editing = _addressField.editing;
+  _revealActive = editing;
+  _enteringEdit = editing;
+  [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+    context.duration = kEditDuration;
+    context.timingFunction = EditTiming();
+    [self relayoutAnimated:YES];
+  }];
+  _revealActive = NO;
+  _enteringEdit = NO;
+  [self animateAddressTextForEditing:editing];
+  if (editing) {
+    // Second half of the icon cross-fade: show it in the leading slot.
+    __weak SafariumTabBarView* weakSelf = self;
+    dispatch_after(
+        dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.09 * NSEC_PER_SEC)),
+        dispatch_get_main_queue(), ^{
+          [NSAnimationContext
+              runAnimationGroup:^(NSAnimationContext* context) {
+                context.duration = 0.15;
+                [weakSelf relayoutAnimated:YES];
+              }];
+        });
+  }
+}
+
+// The user started typing: favicon → 🔍, ≡ → ×.
+- (void)addressFieldTextChanged {
+  [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+    context.duration = 0.12;
+    [self relayoutAnimated:YES];
+  }];
+}
+
+- (void)focusAddressField {
+  // Defer so pending tab-strip updates (which may end editing on a tab
+  // switch) are applied first.
+  __weak SafariumTabBarView* weakSelf = self;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    SafariumTabBarView* strongSelf = weakSelf;
+    if (!strongSelf || !strongSelf.window) {
+      return;
+    }
+    [strongSelf layoutSubtreeIfNeeded];
+    if (strongSelf->_addressField.hidden) {
+      return;
+    }
+    if (strongSelf->_willFocusAddressField) {
+      strongSelf->_willFocusAddressField();
+    }
+    [strongSelf.window makeFirstResponder:strongSelf->_addressField];
+  });
+}
+
+// --------------------------------------------------------------------------
+// Actions
+
+- (void)tabMouseDown:(NSEvent*)event cell:(NSView*)pressedView {
+  if (!_controller) {
+    return;
+  }
+  SafariumTabCell* cell = (SafariumTabCell*)pressedView;
+  if (!cell) {
+    cell = _activeCell;  // Press landed on the address field.
+  }
+  if (!cell) {
+    return;
+  }
+  for (SafariumTabCell* c in _cells) {
+    [c refreshHoverFromPointer];
+  }
+  _pressWasActive = cell.active;
+  if (!cell.active) {
+    // Like Safari, the tab is selected on press; a drag then moves it.
+    _controller->ActivateTab(cell.index);
+  }
+  _pressCell = cell;
+  _pressStartX =
+      [_strip convertPoint:event.locationInWindow fromView:nil].x;
+  _dragGrab = _pressStartX - NSMinX(cell.frame);
+}
+
+- (void)tabMouseDragged:(NSEvent*)event {
+  SafariumTabCell* cell = _pressCell;
+  if (!cell || !_controller) {
+    return;
+  }
+  const CGFloat x =
+      [_strip convertPoint:event.locationInWindow fromView:nil].x;
+  if (!_dragCell) {
+    if (fabs(x - _pressStartX) < kDragThreshold || _cells.count < 2) {
+      return;
+    }
+    if (_addressField.editing) {
+      [self.window makeFirstResponder:nil];
+    }
+    _dragCell = cell;
+  }
+  const CGFloat width = NSWidth(cell.frame);
+  _dragX = MAX(kCapsuleInset,
+               MIN(NSWidth(_strip.frame) - kCapsuleInset - width,
+                   x - _dragGrab));
+
+  // Swap with a neighbour once the dragged tab's edge passes its middle.
+  const NSInteger i = cell.index;
+  const NSInteger n = _cells.count;
+  if (i < 0 || i >= n || (NSInteger)_slotFrames.size() != n) {
+    return;
+  }
+  NSInteger target = i;
+  if (i > 0 && _cells[i - 1].pinned == cell.pinned &&
+      _dragX < NSMidX(_slotFrames[i - 1])) {
+    target = i - 1;
+  } else if (i + 1 < n && _cells[i + 1].pinned == cell.pinned &&
+             _dragX + width > NSMidX(_slotFrames[i + 1])) {
+    target = i + 1;
+  }
+  if (target != i) {
+    _controller->MoveTab(i, target);  // Re-enters -updateState: (animated).
+  } else {
+    _dragMoveOnly = YES;
+    [self relayoutAnimated:NO];
+    _dragMoveOnly = NO;
+  }
+}
+
+- (void)tabMouseUp:(NSEvent*)event {
+  SafariumTabCell* cell = _pressCell;
+  _pressCell = nil;
+  if (_dragCell) {
+    // Drop: the tab settles into its slot.
+    _dragCell = nil;
+    [NSAnimationContext runAnimationGroup:^(NSAnimationContext* context) {
+      context.duration = kAnimationDuration;
+      context.timingFunction = SafariTiming();
+      [self relayoutAnimated:YES];
+    }];
+    [self refreshHoverAfterDelay];
+    return;
+  }
+  if (cell && cell.active && _pressWasActive) {
+    [self focusAddressField];  // Click on the current tab edits the address.
+  }
+}
+
+- (void)tabCellCloseClicked:(SafariumTabCell*)cell {
+  if (_controller) {
+    _controller->CloseTab(cell.index);
+  }
+}
+
+- (void)reloadClicked:(id)sender {
+  if (!_controller) {
+    return;
+  }
+  if (_isLoading) {
+    _controller->Stop();
+  } else {
+    _controller->Reload();
+  }
+}
+
+- (void)closeActiveClicked:(id)sender {
+  if (_controller && _activeIndex >= 0) {
+    _controller->CloseTab(_activeIndex);
+  }
+}
+
+- (void)clearClicked:(id)sender {
+  [_addressField clearText];
+  [self relayoutAnimated:NO];
+}
+
+- (void)pageMenuClicked:(NSButton*)sender {
+  if (!_controller) {
+    return;
+  }
+  NSMenu* menu = [[NSMenu alloc] init];
+  menu.autoenablesItems = NO;
+  const bool isWebsite = _controller->ActiveURL().SchemeIsHTTPOrHTTPS();
+  if (isWebsite) {
+    AddPageMenuItem(menu, @"Hide Distracting Items…", @"eye.slash", self,
+                    @selector(hideDistractingItems:));
+    AddPageMenuItem(menu, @"Show Hidden Items", @"eye", self,
+                    @selector(showHiddenItems:));
+    [menu addItem:NSMenuItem.separatorItem];
+  }
+
+  NSString* title =
+      [NSString stringWithFormat:@"Zoom (%d%%)", _controller->ActiveZoomPercent()];
+  NSMenuItem* zoom = AddPageMenuItem(menu, title, @"plus.magnifyingglass",
+                                     nil, nullptr);
+  zoom.submenu = [[NSMenu alloc] init];
+  zoom.submenu.autoenablesItems = NO;
+  [self addPageCommand:IDC_ZOOM_PLUS title:@"Zoom In" icon:nil toMenu:zoom.submenu];
+  [self addPageCommand:IDC_ZOOM_MINUS title:@"Zoom Out" icon:nil toMenu:zoom.submenu];
+  [self addPageCommand:IDC_ZOOM_NORMAL title:@"Reset Zoom" icon:nil toMenu:zoom.submenu];
+  [self addPageCommand:IDC_FIND title:@"Find on Page…" icon:@"doc.text.magnifyingglass"
+                toMenu:menu];
+  if (_controller->IsCommandEnabled(IDC_FEEDBACK)) {
+    [self addPageCommand:IDC_FEEDBACK title:@"Report a Website Issue…"
+                    icon:@"exclamationmark.bubble" toMenu:menu];
+  }
+  AddPageMenuItem(menu, @"Website Settings…", @"gearshape", self,
+                  @selector(showWebsiteSettings:)).enabled = isWebsite;
+
+  NSRect bounds = sender.bounds;
+  CGFloat y = sender.isFlipped ? NSMaxY(bounds) + 4 : NSMinY(bounds) - 4;
+  [menu popUpMenuPositioningItem:nil
+                     atLocation:NSMakePoint(NSMinX(bounds), y)
+                         inView:sender];
+}
+
+- (void)addPageCommand:(int)command
+                 title:(NSString*)title
+                  icon:(NSString*)icon
+                toMenu:(NSMenu*)menu {
+  NSMenuItem* item = AddPageMenuItem(menu, title, icon, self,
+                                     @selector(runPageCommand:));
+  item.tag = command;
+  item.enabled = _controller->IsCommandEnabled(command);
+}
+
+- (void)runPageCommand:(NSMenuItem*)item {
+  const int command = static_cast<int>(item.tag);
+  if (_controller && _controller->IsCommandEnabled(command)) {
+    _controller->ExecuteCommand(command);
+  }
+}
+
+- (void)hideDistractingItems:(id)sender {
+  if (_controller) {
+    _controller->HideDistractingItems();
+  }
+}
+
+- (void)showHiddenItems:(id)sender {
+  if (_controller) {
+    _controller->ShowHiddenItems();
+  }
+}
+
+- (void)showWebsiteSettings:(id)sender {
+  if (_controller) {
+    _controller->ShowActiveSiteSettings();
+  }
+}
+
+// NSTextFieldDelegate: Return navigates, Escape cancels.
+- (BOOL)control:(NSControl*)control
+               textView:(NSTextView*)textView
+    doCommandBySelector:(SEL)commandSelector {
+  if (commandSelector == @selector(insertNewline:)) {
+    NSString* text = _addressField.stringValue;
+    [self.window makeFirstResponder:nil];
+    if (_controller && text.length) {
+      _controller->NavigateActiveTab(base::SysNSStringToUTF16(text));
+    }
+    return YES;
+  }
+  if (commandSelector == @selector(cancelOperation:)) {
+    [self.window makeFirstResponder:nil];
+    if (_controller) {
+      _controller->FocusActiveTab();  // Keyboard goes back to the page.
+    }
+    return YES;
+  }
+  return NO;
+}
