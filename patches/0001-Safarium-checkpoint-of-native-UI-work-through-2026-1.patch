@@ -0,0 +1,3538 @@
+// Safarium: AppKit implementation of the Compact tab bar, hosted in views via
+// NativeViewHost. The current tab *is* the address field (Safari Compact).
+//
+// Layout (left → right), matching Safari 26 Compact:
+//   [traffic lights] (back) (forward) (reload|stop)  [ tabs capsule ]  [ + ]
+// Each round button and each capsule sits on its own Liquid Glass background.
+//
+// Active-tab states:
+//   idle    — white pill, centered [favicon|🔍] + host/search terms, ≡ on right
+//   editing — accent focus ring, ⊗ on left, text left-aligned and selected,
+//             × (clear) on right, all other tabs dimmed.
+
+#import <AppKit/AppKit.h>
+#import <QuartzCore/QuartzCore.h>
+
+#include <algorithm>
+#include <memory>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/raw_ptr_exclusion.h"
+#include "base/strings/sys_string_conversions.h"
+#import "chrome/browser/ui/webui_browser/safarium_downloads_popover.h"
+#include "chrome/browser/ui/webui_browser/safarium_root_view.h"
+#include "chrome/browser/ui/webui_browser/safarium_tab_bar_controller.h"
+#include "chrome/browser/ui/toolbar/toolbar_action_view_model.h"
+#include "chrome/browser/ui/webui/webui_toolbar/webui_toolbar_extensions_container.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/gfx/image/image.h"
+#include "ui/gfx/image/image_skia_util_mac.h"
+#include "ui/gfx/mac/coordinate_conversion.h"
+#include "ui/gfx/native_ui_types.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "net/base/apple/url_conversions.h"
+#include "ui/views/view.h"
+#include "ui/views/view_tracker.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/focus/focus_manager.h"
+
+namespace {
+constexpr CGFloat kControlHeight = 36;  // Round buttons and capsules.
+constexpr CGFloat kTabHeight = 30;      // Tabs inside the capsule.
+constexpr CGFloat kCapsuleInset = 3;
+constexpr CGFloat kGap = 8;
+constexpr CGFloat kPinnedTabWidth = 40;
+// Below this the strip overflows and scrolls (Safari 26: ~118pt tabs,
+// measured from a screen recording).
+constexpr CGFloat kMinTabWidth = 118;
+constexpr CGFloat kRevealMargin = 24;
+constexpr CGFloat kDragThreshold = 4;
+constexpr CGFloat kMinActiveTabWidth = 260;
+// With few tabs Safari gives every tab the same width, at most this, and
+// centers the strip (measured from Safari 26 screenshots: ~240pt).
+constexpr CGFloat kMaxTabWidth = 240;
+constexpr CGFloat kIconSize = 16;
+constexpr CGFloat kDimmedAlpha = 0.35;
+// Measured from a Safari 26 recording: tabs reflow with a fast-start,
+// critically-damped feel (50% at ~40ms, 95% at ~130ms, settled ~200ms).
+constexpr NSTimeInterval kAnimationDuration = 0.22;
+
+NSImage* Symbol(NSString* name, CGFloat point_size, NSFontWeight weight) {
+  NSImage* image = [NSImage imageWithSystemSymbolName:name
+                             accessibilityDescription:nil];
+  return [image imageWithSymbolConfiguration:
+                    [NSImageSymbolConfiguration
+                        configurationWithPointSize:point_size
+                                            weight:weight]];
+}
+
+NSMenuItem* AddPageMenuItem(NSMenu* menu,
+                           NSString* title,
+                           NSString* symbol,
+                           id target,
+                           SEL action) {
+  NSMenuItem* item = [menu addItemWithTitle:title action:action keyEquivalent:@""];
+  item.target = target;
+  if (symbol) {
+    item.image = Symbol(symbol, 14, NSFontWeightRegular);
+  }
+  return item;
+}
+// Address-bar edit transitions (favicon slide, text slide). Fit to frame
+// measurements of Safari 26: 39% at 50ms, 71% at 100ms, 95% at 200ms — a
+// critically damped spring (ω≈26/s); this bezier matches within 2%.
+constexpr NSTimeInterval kEditDuration = 0.35;
+CAMediaTimingFunction* EditTiming() {
+  return [CAMediaTimingFunction functionWithControlPoints:0.25:0.6:0.2:1.0];
+}
+
+CAMediaTimingFunction* SafariTiming() {
+  return [CAMediaTimingFunction functionWithControlPoints:0.15:0.85:0.35:1.0];
+}
+}  // namespace
+
+// ---------------------------------------------------------------------------
+// Glass background that never takes clicks (see browser_native_widget_mac.mm).
+
+API_AVAILABLE(macos(26.0))
+@interface SafariumGlassBackground : NSGlassEffectView
+@end
+
+@implementation SafariumGlassBackground
+- (NSView*)hitTest:(NSPoint)point {
+  return nil;
+}
+@end
+
+// Flat tint drawn over the glass (Safari's tab capsule is a gray #E6E6E6 in
+// light mode; labelColor @10% reproduces it and adapts to dark mode).
+@interface SafariumTintView : NSView
+@end
+
+@implementation SafariumTintView
+- (NSView*)hitTest:(NSPoint)point {
+  return nil;
+}
+@end
+
+@interface SafariumFallbackBackground : NSVisualEffectView
+@end
+
+@implementation SafariumFallbackBackground
+- (NSView*)hitTest:(NSPoint)point {
+  return nil;
+}
+@end
+
+static NSView* MakeGlass(CGFloat corner_radius) {
+  if (@available(macOS 26.0, *)) {
+    SafariumGlassBackground* glass =
+        [[SafariumGlassBackground alloc] initWithFrame:NSZeroRect];
+    glass.style = NSGlassEffectViewStyleRegular;
+    glass.cornerRadius = corner_radius;
+    return glass;
+  }
+  SafariumFallbackBackground* v =
+      [[SafariumFallbackBackground alloc] initWithFrame:NSZeroRect];
+  v.material = NSVisualEffectMaterialHeaderView;
+  v.blendingMode = NSVisualEffectBlendingModeWithinWindow;
+  v.state = NSVisualEffectStateActive;
+  v.wantsLayer = YES;
+  v.layer.cornerRadius = corner_radius;
+  v.layer.masksToBounds = YES;
+  return v;
+}
+
+// Icon button that ignores clicks while faded out (several of these are
+// stacked in the same slot of the active tab).
+@interface SafariumOverlayButton : NSButton
+@property(nonatomic) BOOL shown;
+@end
+
+@implementation SafariumOverlayButton
+@synthesize shown = _shown;
+- (BOOL)mouseDownCanMoveWindow {
+  return NO;
+}
+- (NSView*)hitTest:(NSPoint)point {
+  return _shown ? [super hitTest:point] : nil;
+}
+@end
+
+// Decorative view (focus ring, progress line) that lets clicks through to
+// the tab underneath.
+@interface SafariumPassiveView : NSView
+@end
+
+@implementation SafariumPassiveView
+- (NSView*)hitTest:(NSPoint)point {
+  return nil;
+}
+@end
+
+// Image view that lets clicks through to the tab underneath.
+@interface SafariumPassiveImageView : NSImageView
+@end
+
+@implementation SafariumPassiveImageView
+- (NSView*)hitTest:(NSPoint)point {
+  return nil;
+}
+@end
+
+static SafariumOverlayButton* MakeIconButton(NSString* symbol,
+                                             CGFloat point_size,
+                                             id target,
+                                             SEL action) {
+  SafariumOverlayButton* b = [SafariumOverlayButton
+      buttonWithImage:Symbol(symbol, point_size, NSFontWeightMedium)
+               target:target
+               action:action];
+  b.shown = YES;
+  b.bordered = NO;
+  b.imagePosition = NSImageOnly;
+  b.contentTintColor = NSColor.labelColor;
+  return b;
+}
+
+
+// ---------------------------------------------------------------------------
+// Address field: shows the short host / search terms when idle, full URL
+// while editing. Editing state changes are reported to the bar.
+
+@class SafariumTabBarView;
+
+@interface SafariumAddressField : NSTextField
+@property(nonatomic, copy) NSString* displayText;
+@property(nonatomic, copy) NSString* editText;
+@property(nonatomic, readonly) BOOL editing;
+// The user changed the text since editing began.
+@property(nonatomic, readonly) BOOL userModified;
+@property(nonatomic, weak) SafariumTabBarView* bar;
+- (void)showIdleText;
+- (void)clearText;
+// Reconciles the text with AppKit's real editing state. Returns YES if an
+// editing session was just discovered (text switched to the full URL).
+- (BOOL)syncEditingState;
+@end
+
+@interface SafariumTabBarView : NSView <NSTextFieldDelegate>
+- (void)setController:(safarium::TabBarController*)controller;
+- (void)updateState:(const safarium::BarState&)state;
+- (void)focusAddressField;
+- (void)addressFieldEditingChanged;
+- (void)addressFieldTextChanged;
+// Press / drag / release on a tab. `cell` is the SafariumTabCell, or nil
+// for the current tab when the press landed on the address field.
+- (void)tabMouseDown:(NSEvent*)event cell:(NSView*)cell;
+// Tab overview: the current tab's pill becomes an empty search field.
+- (void)setOverviewMode:(BOOL)overview;
+- (void)updatePreferredWidthAnimated:(BOOL)animated;
+- (void)tabMouseDragged:(NSEvent*)event;
+- (void)tabMouseUp:(NSEvent*)event;
+// Called right before the address field takes keyboard focus.
+@property(nonatomic, copy) void (^willFocusAddressField)(void);
+@end
+
+@implementation SafariumAddressField {
+  BOOL _editing;
+  BOOL _userModified;
+  BOOL _pressForwarded;
+}
+
+- (BOOL)mouseDownCanMoveWindow {
+  return NO;
+}
+
+- (BOOL)userModified {
+  return _userModified && self.editing;
+}
+
+- (void)textDidChange:(NSNotification*)notification {
+  [super textDidChange:notification];
+  if (!_userModified) {
+    _userModified = YES;
+    [self.bar addressFieldTextChanged];
+  }
+}
+
+// Clicking the idle field starts editing the same way ⌘L does (full URL,
+// all selected). While editing, clicks place the caret as usual.
+// A press on the idle field belongs to the tab: a click starts editing the
+// same way ⌘L does (full URL, all selected), a drag moves the tab. While
+// editing, clicks place the caret as usual.
+- (void)mouseDown:(NSEvent*)event {
+  if (!self.editing) {
+    _pressForwarded = YES;
+    [self.bar tabMouseDown:event cell:nil];
+    return;
+  }
+  [super mouseDown:event];
+}
+
+- (void)mouseDragged:(NSEvent*)event {
+  if (_pressForwarded) {
+    [self.bar tabMouseDragged:event];
+    return;
+  }
+  [super mouseDragged:event];
+}
+
+- (void)mouseUp:(NSEvent*)event {
+  if (_pressForwarded) {
+    _pressForwarded = NO;
+    [self.bar tabMouseUp:event];
+    return;
+  }
+  [super mouseUp:event];
+}
+
+- (void)clearText {
+  if (NSText* editor = self.currentEditor) {
+    editor.string = @"";
+  } else {
+    self.stringValue = @"";
+  }
+  if (!_userModified) {
+    _userModified = YES;
+    [self.bar addressFieldTextChanged];
+  }
+}
+@synthesize displayText = _displayText;
+@synthesize editText = _editText;
+@synthesize bar = _bar;
+
+// Ground truth is AppKit's field editor, not our flag: an editing session
+// can end without -textDidEndEditing: (e.g. the view leaving the window).
+- (BOOL)editing {
+  return self.window && self.currentEditor != nil;
+}
+
+- (BOOL)becomeFirstResponder {
+  BOOL ok = [super becomeFirstResponder];
+  if (ok && [self syncEditingState]) {
+    [self.bar addressFieldEditingChanged];
+  }
+  return ok;
+}
+
+- (BOOL)syncEditingState {
+  const BOOL live = self.editing;
+  if (live && !_editing) {
+    _editing = YES;
+    _userModified = NO;
+    // Change the field editor's text, NOT -setStringValue:. NSControl's
+    // setter calls -abortEditing, which silently kills the edit session.
+    NSText* editor = self.currentEditor;
+    editor.string = self.editText ?: @"";
+    [editor selectAll:nil];
+    return YES;
+  }
+  if (!live && _editing) {
+    [self showIdleText];
+  }
+  return NO;
+}
+
+- (void)textDidEndEditing:(NSNotification*)notification {
+  [super textDidEndEditing:notification];
+  _editing = NO;
+  _userModified = NO;
+  [self showIdleText];
+  [self.bar addressFieldEditingChanged];
+}
+
+- (void)showIdleText {
+  if (self.editing) {
+    return;
+  }
+  _editing = NO;
+  _userModified = NO;
+  self.stringValue = self.displayText ?: @"";
+}
+
+@end
