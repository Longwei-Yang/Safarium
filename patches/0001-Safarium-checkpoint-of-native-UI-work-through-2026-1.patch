+@interface SafariumTabCell : NSView
+@property(nonatomic) NSInteger index;
+@property(nonatomic) BOOL active;
+@property(nonatomic) BOOL pinned;
+@property(nonatomic, weak) SafariumTabBarView* bar;
+@property(nonatomic, strong) NSImageView* iconView;
+@property(nonatomic, strong) NSTextField* titleLabel;
+@property(nonatomic, strong) NSButton* closeButton;
+@property(nonatomic, strong) NSView* separator;  // At the cell's left edge.
+@property(nonatomic, readonly) BOOL hovered;
+- (void)setIcon:(NSImage*)icon;
+// Where the [icon + title] group was last drawn, in cell coordinates. The
+// bar sets this for the tab that was just deactivated (its content was drawn
+// by the address overlay).
+- (void)noteContentWasAtX:(CGFloat)x;
+// Slide the content from its previous spot to the new one on next layout.
+- (void)animateContentOnNextLayout;
+// Re-derives the hover state from the pointer's real position. AppKit does
+// not deliver enter/exit while a drag owns the mouse, or when the cell moves
+// under a still pointer.
+- (void)refreshHoverFromPointer;
+@end
