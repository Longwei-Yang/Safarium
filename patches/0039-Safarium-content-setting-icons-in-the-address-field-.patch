diff --git a/chrome/browser/ui/webui_browser/safarium_content_setting_popover.mm b/chrome/browser/ui/webui_browser/safarium_content_setting_popover.mm
new file mode 100644
index 0000000000..c61021be8e
--- /dev/null
+++ b/chrome/browser/ui/webui_browser/safarium_content_setting_popover.mm
@@ -0,0 +1,359 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "chrome/browser/ui/webui_browser/safarium_content_setting_popover.h"
+
+#include <utility>
+
+#include "base/strings/sys_string_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/content_settings/content_setting_bubble_model.h"
+#include "ui/events/event.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/types/event_type.h"
+#include "ui/gfx/geometry/point_f.h"
+
+@class SafariumContentSettingPopover;
+
+namespace {
+
+constexpr CGFloat kWidth = 300;
+constexpr CGFloat kInset = 14;
+
+// Keeps the open popover alive (NSPopover does not retain its controller
+// beyond showing it).
+SafariumContentSettingPopover* g_open_popover = nil;
+
+}  // namespace
+
+@interface SafariumContentSettingPopover : NSViewController <NSPopoverDelegate>
+- (instancetype)initWithModel:(std::unique_ptr<ContentSettingBubbleModel>)model
+                      onClose:(void (^)(void))onClose;
+- (void)showRelativeToView:(NSView*)anchor;
+- (int)selectedRadio;
+- (void)rebuild;
+- (void)close;
+@end
+
+namespace {
+
+// The model reports back through this (radio choice, list changes, close).
+class PopoverOwner : public ContentSettingBubbleModel::Owner {
+ public:
+  explicit PopoverOwner(SafariumContentSettingPopover* controller)
+      : controller_(controller) {}
+  void OnListItemAdded(const ContentSettingBubbleModel::ListItem&) override {
+    [controller_ rebuild];
+  }
+  void OnListItemRemovedAt(int) override { [controller_ rebuild]; }
+  int GetSelectedRadioOption() override { return [controller_ selectedRadio]; }
+  void CloseBubble() override { [controller_ close]; }
+
+ private:
+  __weak SafariumContentSettingPopover* controller_;
+};
+
+NSTextField* WrappingLabel(const std::u16string& text,
+                           NSFont* font,
+                           NSColor* color) {
+  NSTextField* label =
+      [NSTextField wrappingLabelWithString:base::SysUTF16ToNSString(text)];
+  label.font = font;
+  label.textColor = color;
+  label.preferredMaxLayoutWidth = kWidth - 2 * kInset;
+  label.selectable = NO;
+  return label;
+}
+
+NSButton* LinkButton(const std::u16string& text, id target, SEL action) {
+  NSButton* button = [NSButton buttonWithTitle:base::SysUTF16ToNSString(text)
+                                        target:target
+                                        action:action];
+  button.bordered = NO;
+  button.attributedTitle = [[NSAttributedString alloc]
+      initWithString:base::SysUTF16ToNSString(text)
+          attributes:@{
+            NSForegroundColorAttributeName : NSColor.linkColor,
+            NSFontAttributeName : [NSFont systemFontOfSize:13],
+          }];
+  button.lineBreakMode = NSLineBreakByTruncatingMiddle;
+  // No focus highlight on the first link when the popover opens.
+  button.refusesFirstResponder = YES;
+  [button setContentCompressionResistancePriority:NSLayoutPriorityDefaultLow
+                                   forOrientation:
+                                       NSLayoutConstraintOrientationHorizontal];
+  return button;
+}
+
+}  // namespace
+
+@implementation SafariumContentSettingPopover {
+  std::unique_ptr<ContentSettingBubbleModel> _model;
+  std::unique_ptr<PopoverOwner> _owner;
+  NSPopover* _popover;
+  NSStackView* _stack;
+  int _selectedRadio;
+  BOOL _closed;
+  void (^_onClose)(void);
+}
+
+- (instancetype)initWithModel:(std::unique_ptr<ContentSettingBubbleModel>)model
+                      onClose:(void (^)(void))onClose {
+  if ((self = [super initWithNibName:nil bundle:nil])) {
+    _onClose = [onClose copy];
+    _model = std::move(model);
+    _owner = std::make_unique<PopoverOwner>(self);
+    _model->set_owner(_owner.get());
+    _selectedRadio = _model->bubble_content().radio_group.default_item;
+  }
+  return self;
+}
+
+- (void)loadView {
+  _stack = [NSStackView stackViewWithViews:@[]];
+  _stack.orientation = NSUserInterfaceLayoutOrientationVertical;
+  _stack.alignment = NSLayoutAttributeLeading;
+  _stack.spacing = 8;
+  _stack.edgeInsets = NSEdgeInsetsMake(kInset, kInset, kInset, kInset);
+  [_stack.widthAnchor constraintEqualToConstant:kWidth].active = YES;
+  self.view = _stack;
+  [self rebuild];
+}
+
+- (void)rebuild {
+  if (!_stack || !_model) {
+    return;
+  }
+  for (NSView* view in [_stack.arrangedSubviews copy]) {
+    [_stack removeArrangedSubview:view];
+    [view removeFromSuperview];
+  }
+  const ContentSettingBubbleModel::BubbleContent& content =
+      _model->bubble_content();
+
+  if (!content.title.empty()) {
+    [_stack addArrangedSubview:WrappingLabel(content.title,
+                                             [NSFont boldSystemFontOfSize:13],
+                                             NSColor.labelColor)];
+  }
+  for (const std::u16string* text : {&content.subtitle, &content.message}) {
+    if (!text->empty()) {
+      [_stack addArrangedSubview:WrappingLabel(*text,
+                                               [NSFont systemFontOfSize:12],
+                                               NSColor.secondaryLabelColor)];
+    }
+  }
+
+  // Blocked pop-ups / redirects…: links that open them.
+  for (size_t i = 0; i < content.list_items.size(); ++i) {
+    const ContentSettingBubbleModel::ListItem& item = content.list_items[i];
+    const std::u16string& text =
+        item.title.empty() ? item.description : item.title;
+    NSView* row;
+    if (item.has_link) {
+      NSButton* link = LinkButton(text, self, @selector(listItemClicked:));
+      link.tag = static_cast<NSInteger>(i);
+      row = link;
+    } else {
+      row = WrappingLabel(text, [NSFont systemFontOfSize:13],
+                          NSColor.labelColor);
+    }
+    [_stack addArrangedSubview:row];
+    [row.widthAnchor constraintLessThanOrEqualToConstant:kWidth - 2 * kInset]
+        .active = YES;
+  }
+
+  // "Always allow …" / "Continue blocking": radio buttons sharing one
+  // action, which AppKit treats as one group.
+  if (content.is_user_modifiable) {
+    for (size_t i = 0; i < content.radio_group.radio_items.size(); ++i) {
+      NSButton* radio = [NSButton
+          radioButtonWithTitle:base::SysUTF16ToNSString(
+                                   content.radio_group.radio_items[i])
+                        target:self
+                        action:@selector(radioClicked:)];
+      radio.tag = static_cast<NSInteger>(i);
+      radio.state = static_cast<int>(i) == _selectedRadio
+                        ? NSControlStateValueOn
+                        : NSControlStateValueOff;
+      radio.lineBreakMode = NSLineBreakByWordWrapping;
+      [_stack addArrangedSubview:radio];
+      [radio.widthAnchor
+          constraintLessThanOrEqualToConstant:kWidth - 2 * kInset]
+          .active = YES;
+    }
+  }
+
+  if (!content.custom_link.empty()) {
+    NSButton* link =
+        LinkButton(content.custom_link, self, @selector(customLinkClicked:));
+    link.enabled = content.custom_link_enabled;
+    [_stack addArrangedSubview:link];
+  }
+
+  // Bottom row: Manage (button or checkbox) on the leading side, then
+  // Cancel / Done.
+  NSMutableArray<NSView*>* buttons = [NSMutableArray array];
+  const std::u16string& manage = content.manage_text;
+  if (!manage.empty()) {
+    if (content.manage_text_style ==
+        ContentSettingBubbleModel::ManageTextStyle::kButton) {
+      NSButton* button =
+          [NSButton buttonWithTitle:base::SysUTF16ToNSString(manage)
+                             target:self
+                             action:@selector(manageClicked:)];
+      button.toolTip = base::SysUTF16ToNSString(content.manage_tooltip);
+      [buttons addObject:button];
+    } else if (content.manage_text_style ==
+               ContentSettingBubbleModel::ManageTextStyle::kCheckbox) {
+      NSButton* box =
+          [NSButton checkboxWithTitle:base::SysUTF16ToNSString(manage)
+                               target:self
+                               action:@selector(manageCheckboxClicked:)];
+      [buttons addObject:box];
+    }
+  }
+  NSView* spacer = [[NSView alloc] initWithFrame:NSZeroRect];
+  [spacer setContentHuggingPriority:NSLayoutPriorityDefaultLow
+                     forOrientation:NSLayoutConstraintOrientationHorizontal];
+  [buttons addObject:spacer];
+  if (!content.cancel_button_text.empty()) {
+    [buttons addObject:[NSButton buttonWithTitle:base::SysUTF16ToNSString(
+                                                     content.cancel_button_text)
+                                          target:self
+                                          action:@selector(cancelClicked:)]];
+  }
+  NSButton* done = [NSButton
+      buttonWithTitle:content.done_button_text.empty()
+                          ? @"Done"
+                          : base::SysUTF16ToNSString(content.done_button_text)
+               target:self
+               action:@selector(doneClicked:)];
+  done.keyEquivalent = @"\r";
+  [buttons addObject:done];
+  NSView* lastBeforeRow = _stack.arrangedSubviews.lastObject;
+  NSStackView* row = [NSStackView stackViewWithViews:buttons];
+  row.orientation = NSUserInterfaceLayoutOrientationHorizontal;
+  row.spacing = 8;
+  [_stack addArrangedSubview:row];
+  [row.widthAnchor constraintEqualToConstant:kWidth - 2 * kInset].active = YES;
+  if (lastBeforeRow) {
+    [_stack setCustomSpacing:14 afterView:lastBeforeRow];
+  }
+
+  [_stack layoutSubtreeIfNeeded];
+  self.preferredContentSize = _stack.fittingSize;
+}
+
+- (void)showRelativeToView:(NSView*)anchor {
+  _popover = [[NSPopover alloc] init];
+  _popover.contentViewController = self;
+  _popover.behavior = NSPopoverBehaviorTransient;
+  _popover.animates = YES;
+  _popover.delegate = self;
+  [_popover showRelativeToRect:anchor.bounds
+                        ofView:anchor
+                 preferredEdge:NSRectEdgeMaxY];
+  g_open_popover = self;
+}
+
+- (int)selectedRadio {
+  return _selectedRadio;
+}
+
+- (void)close {
+  [_popover performClose:nil];
+}
+
+// Chrome commits the radio choice when its bubble closes, however it closes.
+- (void)popoverDidClose:(NSNotification*)notification {
+  if (!_closed && _model) {
+    _closed = YES;
+    _model->CommitChanges();
+    _model->set_owner(nullptr);
+  }
+  if (_onClose) {
+    auto onClose = _onClose;
+    _onClose = nil;
+    onClose();
+  }
+  if (g_open_popover == self) {
+    g_open_popover = nil;
+  }
+}
+
+- (void)listItemClicked:(NSButton*)sender {
+  if (!_model) {
+    return;
+  }
+  // A plain left click (Chrome picks the disposition from the flags).
+  ui::MouseEvent event(ui::EventType::kMousePressed, gfx::PointF(),
+                       gfx::PointF(), base::TimeTicks::Now(),
+                       ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON);
+  _model->OnListItemClicked(static_cast<int>(sender.tag), event);
+}
+
+- (void)radioClicked:(NSButton*)sender {
+  _selectedRadio = static_cast<int>(sender.tag);
+}
+
+- (void)customLinkClicked:(id)sender {
+  if (_model) {
+    _model->OnCustomLinkClicked();
+  }
+  [self close];
+}
+
+- (void)manageClicked:(id)sender {
+  if (_model) {
+    _model->OnManageButtonClicked();
+  }
+  [self close];
+}
+
+- (void)manageCheckboxClicked:(NSButton*)sender {
+  if (_model) {
+    _model->OnManageCheckboxChecked(sender.state == NSControlStateValueOn);
+  }
+}
+
+- (void)cancelClicked:(id)sender {
+  if (_model) {
+    _model->OnCancelButtonClicked();
+  }
+  [self close];
+}
+
+- (void)doneClicked:(id)sender {
+  if (_model) {
+    _model->OnDoneButtonClicked();
+  }
+  [self close];
+}
+
+@end
+
+namespace safarium {
+
+void ShowContentSettingPopover(std::unique_ptr<ContentSettingBubbleModel> model,
+                               NSView* anchor,
+                               void (^on_close)(void)) {
+  if (!model || !anchor.window) {
+    if (on_close) {
+      on_close();
+    }
+    return;
+  }
+  [g_open_popover close];
+  SafariumContentSettingPopover* popover =
+      [[SafariumContentSettingPopover alloc] initWithModel:std::move(model)
+                                                   onClose:on_close];
+  [popover showRelativeToView:anchor];
+}
+
+void CloseContentSettingPopover() {
+  [g_open_popover close];
+}
+
+}  // namespace safarium
