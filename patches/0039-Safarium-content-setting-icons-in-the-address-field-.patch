+
+// A content-setting indicator: Chrome's bubble for it, as a native popover.
+- (void)contentSettingClicked:(SafariumOverlayButton*)sender {
+  if (!_controller) {
+    return;
+  }
+  std::unique_ptr<ContentSettingBubbleModel> model =
+      _controller->CreateContentSettingBubble(static_cast<int>(sender.tag));
+  if (!model) {
+    _controller->ContentSettingsChanged();  // Its state is gone: refresh.
+    return;
+  }
+  [self hideHoverCard];
+  safarium::ShowContentSettingPopover(std::move(model), sender, nil);
+}
