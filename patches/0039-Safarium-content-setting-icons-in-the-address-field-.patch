+std::unique_ptr<ContentSettingBubbleModel>
+TabBarController::CreateContentSettingBubble(int model_index) {
+  content::WebContents* contents =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  if (!contents || model_index < 0 ||
+      model_index >= static_cast<int>(content_setting_models_.size())) {
+    return nullptr;
+  }
+  ContentSettingImageModel* image_model =
+      content_setting_models_[model_index].get();
+  image_model->Update(contents);
+  if (!image_model->is_visible()) {
+    return nullptr;
+  }
+  return image_model->CreateBubbleModel(
+      BrowserContentSettingBubbleModelDelegate::From(browser_), contents);
+}
+
+void TabBarController::ContentSettingsChanged() {
+  PushState();
+}
