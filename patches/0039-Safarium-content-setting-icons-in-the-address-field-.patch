+// A content-setting indicator as an SF Symbol, or nil to use Chrome's own
+// icon (types without a fitting symbol, e.g. camera-and-microphone, which
+// Chrome draws as whichever is in use).
+NSString* ContentSettingSymbol(int image_type, bool blocked) {
+  using Type = ContentSettingImageModel::ImageType;
+  switch (static_cast<Type>(image_type)) {
+    case Type::kPopups:
+      return @"rectangle.on.rectangle.slash";
+    case Type::kGeolocation:
+      return blocked ? @"location.slash.fill" : @"location.fill";
+    case Type::kNotifications:
+      return blocked ? @"bell.slash.fill" : @"bell.fill";
+    case Type::kAutomaticDownloads:
+      return @"arrow.down.circle";
+    case Type::kSound:
+      return @"speaker.slash.fill";
+    case Type::kJavaScript:
+      return @"curlybraces";
+    case Type::kImages:
+      return @"photo";
+    case Type::kClipboardReadWrite:
+      return @"doc.on.clipboard";
+    case Type::kMidiSysex:
+      return @"pianokeys";
+    case Type::kProtocolHandlers:
+      return @"link";
+    default:
+      return nil;
+  }
+}
+
+NSImage* ContentSettingImage(const safarium::ContentSettingItem& item) {
+  if (NSString* name = ContentSettingSymbol(item.image_type, item.blocked)) {
+    if (NSImage* image = Symbol(name, 11, NSFontWeightMedium)) {
+      return image;
+    }
+  }
+  if (item.icon.IsEmpty()) {
+    return Symbol(@"exclamationmark.circle", 11, NSFontWeightMedium);
+  }
+  // Chrome's icon, drawn in black: tint it like the other icons.
+  NSImage* image = [item.icon.ToNSImage() copy];
+  [image setTemplate:YES];
+  image.size = NSMakeSize(14, 14);
+  return image;
+}
