+- (NSRect)frameOfUnit:(NSArray<NSView*>*)unit {
+  NSRect frame = NSZeroRect;
+  for (NSView* v in unit) {
+    frame = NSUnionRect(frame, [self convertRect:v.bounds fromView:v]);
+  }
+  return frame;
+}
