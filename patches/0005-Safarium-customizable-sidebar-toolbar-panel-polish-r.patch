+- (NSString*)labelForItem:(NSString*)identifier image:(NSImage**)image {
+  struct Fixed {
+    NSString* identifier;
+    NSString* label;
+    NSString* symbol;
+  };
+  const Fixed fixed[] = {
+      {kNavItem, @"Back/Forward", @"chevron.left.chevron.right"},
+      {kReloadItem, @"Reload", @"arrow.clockwise"},
+      {kNewTabItem, @"New Tab", @"plus"},
+      {kHomeItem, @"Home", @"house"},
+      {kDownloadsItem, @"Downloads", @"arrow.down.circle"},
+      {kShareItem, @"Share", @"square.and.arrow.up"},
+      {kOverviewItem, @"Tab Overview", @"square.on.square"},
+  };
+  for (const Fixed& f : fixed) {
+    if ([identifier isEqualToString:f.identifier]) {
+      *image = Symbol(f.symbol, 18, NSFontWeightRegular);
+      return f.label;
+    }
+  }
+  for (const CommandItemSpec& spec : kCommandItems) {
+    if ([identifier isEqualToString:@(spec.identifier)]) {
+      *image = Symbol(@(spec.symbol), 18, NSFontWeightRegular);
+      return @(spec.label);
+    }
+  }
+  if ([identifier hasPrefix:kExtensionItemPrefix]) {
+    auto* extensions =
+        _controller ? _controller->GetExtensionsContainer() : nullptr;
+    const std::string id = base::SysNSStringToUTF8(
+        [identifier substringFromIndex:kExtensionItemPrefix.length]);
+    auto* action = extensions ? extensions->GetActionForId(id) : nullptr;
+    if (!action) {
+      return nil;
+    }
+    *image = [self imageForExtension:id];
+    return base::SysUTF16ToNSString(action->GetActionName());
+  }
+  return nil;
+}
+
+- (NSArray<SafariumPaletteEntry*>*)sidebarPaletteEntries {
+  NSArray<NSString*>* current = [self configuredItemIdentifiers];
+  NSMutableArray<SafariumPaletteEntry*>* entries = [NSMutableArray array];
+  for (NSString* identifier in [self toolbarAllowedItemIdentifiers:_toolbar]) {
+    if ([identifier isEqualToString:kTabsItem] || IsSidebarSpace(identifier)) {
+      continue;  // Spaces are added last; the tabs are the sidebar's list.
+    }
+    NSImage* image = nil;
+    NSString* label = [self labelForItem:identifier image:&image];
+    if (!label) {
+      continue;
+    }
+    SafariumPaletteEntry* entry = [[SafariumPaletteEntry alloc] init];
+    entry.identifier = identifier;
+    entry.label = label;
+    entry.image = image;
+    entry.inUse = [current containsObject:identifier];
+    [entries addObject:entry];
+  }
+  // As in the system palette: spaces can be added any number of times.
+  for (NSString* identifier in @[
+         NSToolbarSpaceItemIdentifier, NSToolbarFlexibleSpaceItemIdentifier
+       ]) {
+    const BOOL flexible =
+        [identifier isEqualToString:NSToolbarFlexibleSpaceItemIdentifier];
+    SafariumPaletteEntry* entry = [[SafariumPaletteEntry alloc] init];
+    entry.identifier = identifier;
+    entry.label = flexible ? @"Flexible Space" : @"Space";
+    entry.image = SpacerPaletteImage(flexible);
+    [entries addObject:entry];
+  }
+  return entries;
+}
+
+- (void)refreshSidebarPalette {
+  if (_sidebarPalette) {
+    _sidebarPalette.entries = [self sidebarPaletteEntries];
+    _sidebarPalettePopover.contentSize = _sidebarPalette.preferredContentSize;
+  }
+}
+
+// Context menu "Customize Toolbar…": edit the sidebar in place, with the
+// item palette in a popover beside it (never covering the sidebar).
+- (void)customizeToolbarFromSidebar:(id)sender {
+  SafariumSidebarView* sidebar = _sidebar;
+  if (!_verticalTabs || !sidebar || _sidebarPalettePopover.shown) {
+    return;
+  }
+  sidebar.editDelegate = self;
+  sidebar.editing = YES;
+  if (!_sidebarPalette) {
+    _sidebarPalette = [[SafariumSidebarPalette alloc] init];
+    __weak SafariumToolbarController* weakSelf = self;
+    _sidebarPalette.onDone = ^{
+      [weakSelf endSidebarEditing];
+    };
+    _sidebarPalette.onRestoreDefaults = ^{
+      SafariumToolbarController* strongSelf = weakSelf;
+      [NSUserDefaults.standardUserDefaults
+          removeObjectForKey:kSidebarItemsKey];
+      [NSUserDefaults.standardUserDefaults
+          removeObjectForKey:kLegacySidebarItemsKey];
+      [strongSelf saveSidebarItemIdentifiers:
+                      [strongSelf defaultSidebarItemIdentifiers]];
+    };
+    _sidebarPalettePopover = [[NSPopover alloc] init];
+    _sidebarPalettePopover.behavior = NSPopoverBehaviorApplicationDefined;
+    _sidebarPalettePopover.contentViewController = _sidebarPalette;
+  }
+  [self refreshSidebarPalette];
+  NSRect anchor = [sidebar buttonAreaRect];
+  if (NSIsEmptyRect(anchor)) {
+    anchor = NSMakeRect(NSWidth(sidebar.bounds) - 20, 20, 10, 10);
+  }
+  [_sidebarPalettePopover showRelativeToRect:anchor
+                                      ofView:sidebar
+                               preferredEdge:NSRectEdgeMaxX];
+}
+
+- (void)endSidebarEditing {
+  [_sidebarPalettePopover close];
+  _sidebar.editing = NO;
+}
+
+// SafariumSidebarEditing:
+- (void)sidebarRemoveItemAtIndex:(NSInteger)index {
+  NSMutableArray<NSString*>* ids = [[self configuredItemIdentifiers] mutableCopy];
+  if (index < 0 || index >= (NSInteger)ids.count) {
+    return;
+  }
+  [ids removeObjectAtIndex:index];
+  [self saveSidebarItemIdentifiers:ids];
+}
+
+- (void)sidebarDropItem:(NSString*)identifier
+              fromIndex:(NSInteger)from
+                atIndex:(NSInteger)index
+                 newRow:(BOOL)newRow {
+  NSMutableArray<NSString*>* ids = [[self configuredItemIdentifiers] mutableCopy];
+  if (from >= 0 && from < (NSInteger)ids.count) {
+    [ids removeObjectAtIndex:from];
+    if (from < index) {
+      --index;
+    }
+  } else if (!IsSidebarSpace(identifier) && [ids containsObject:identifier]) {
+    return;  // Each item appears once (spaces any number of times).
+  }
+  if (newRow) {
+    [ids addObject:kSidebarRowBreak];
+    [ids addObject:identifier];
+  } else {
+    [ids insertObject:identifier
+              atIndex:std::clamp<NSInteger>(index, 0, ids.count)];
+  }
+  [self saveSidebarItemIdentifiers:ids];
+}
