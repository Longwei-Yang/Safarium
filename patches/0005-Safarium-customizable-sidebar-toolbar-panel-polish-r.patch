+    if (buttons.count) {
+      SafariumSidebarSegment* segment = [[SafariumSidebarSegment alloc] init];
+      segment.kind = kSidebarSegmentGroup;
+      segment.buttons = buttons;
+      segment.indexes = indexes;
+      [row addObject:segment];
+      [buttons removeAllObjects];
+      [indexes removeAllObjects];
+    }
+  };
+  auto endRow = [&] {
+    endGroup();
+    if (row.count) {
+      [rows addObject:[row copy]];
+      [row removeAllObjects];
+    }
+  };
+  for (NSUInteger i = 0; i < ids.count; ++i) {
+    NSString* identifier = ids[i];
