+    [clip scrollToPoint:NSMakePoint(NSMinX(visible), y)];
+    [_scroll reflectScrolledClipView:clip];
+    _grid.needsLayout = YES;
+    [_grid layoutSubtreeIfNeeded];
+  }
+  SafariumOverviewCard* card =
+      (SafariumOverviewCard*)[_grid itemAtIndexPath:path];
+  return card ?: [self cardForTab:tabId];
