+// --- Edit mode ---------------------------------------------------------------
+
+// Every item the user can move: one per button group item (Back/Forward is
+// one), plus the spaces while editing.
+- (void)enumerateUnits:(void (^)(NSArray<NSView*>* views,
+                                 NSInteger index,
+                                 NSUInteger row))block {
+  for (NSUInteger r = 0; r < _rows.count && r < _rowViews.count; ++r) {
+    NSArray<SafariumSidebarSegment*>* row = _rows[r];
+    for (NSUInteger s = 0; s < row.count && s < _rowViews[r].count; ++s) {
+      SafariumSidebarSegment* segment = row[s];
+      if (segment.kind != kSidebarSegmentGroup) {
+        if (_editing && segment.indexes.count) {
+          block(@[ _rowViews[r][s] ], segment.indexes[0].integerValue, r);
+        }
+        continue;
+      }
+      NSArray<NSButton*>* buttons = segment.buttons;
+      NSArray<NSNumber*>* indexes = segment.indexes;
+      // Consecutive buttons with the same index form one item.
+      NSUInteger i = 0;
+      while (i < buttons.count && i < indexes.count) {
+        NSMutableArray<NSView*>* unit = [NSMutableArray array];
+        const NSInteger index = indexes[i].integerValue;
+        while (i < buttons.count && i < indexes.count &&
+               indexes[i].integerValue == index) {
+          [unit addObject:buttons[i]];
+          ++i;
+        }
+        block(unit, index, r);
+      }
+    }
+  }
+}
