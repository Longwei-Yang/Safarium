+- (void)saveSidebarItemIdentifiers:(NSArray<NSString*>*)ids {
+  NSArray<NSString*>* normalized = NormalizeSidebarItems(ids);
+  NSUserDefaults* defaults = NSUserDefaults.standardUserDefaults;
+  [defaults setObject:normalized forKey:kSidebarItemsKey];
+  [defaults removeObjectForKey:kLegacySidebarItemsKey];
+  const BOOL hasHome = [normalized containsObject:kHomeItem];
+  if (hasHome != _showHome) {
+    _showHome = hasHome;
+    if (_controller) {
+      _controller->SetShowHomeButton(hasHome);
+    }
+  }
