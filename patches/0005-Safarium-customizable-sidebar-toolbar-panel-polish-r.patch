+  NSClipView* clip = _scroll.contentView;
+  const NSRect visible = clip.documentVisibleRect;
+  constexpr CGFloat kBottomMargin = 12;
+  CGFloat y = NSMinY(visible);
+  if (NSMinY(frame) < NSMinY(visible) + _cardTopReserve) {
+    y = NSMinY(frame) - _cardTopReserve;
+  } else if (NSMaxY(frame) > NSMaxY(visible) - kBottomMargin) {
+    y = NSMaxY(frame) + kBottomMargin - NSHeight(visible);
+  }
+  y = std::clamp<CGFloat>(
+      y, 0, MAX(0, NSHeight(_grid.frame) - NSHeight(visible)));
