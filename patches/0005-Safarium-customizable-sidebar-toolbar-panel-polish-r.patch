+- (NSArray<NSButton*>*)sidebarButtonsForItem:(NSToolbarItemIdentifier)identifier {
+  SafariumSidebarView* sidebar = _sidebar;
+  if ([identifier isEqualToString:kNavItem]) {
+    return @[ sidebar.back, sidebar.forward ];
+  }
+  NSDictionary<NSString*, NSButton*>* fixed = @{
+    kReloadItem : sidebar.reload,
+    kNewTabItem : sidebar.addTabButton,
+    kHomeItem : sidebar.home,
+    kDownloadsItem : sidebar.downloads,
+    kShareItem : sidebar.share,
+    kOverviewItem : sidebar.overview,
+  };
+  if (NSButton* button = fixed[identifier]) {
+    return @[ button ];
+  }
+  if ([identifier hasPrefix:kExtensionItemPrefix]) {
+    NSButton* button = _sidebarExtensionButtons[identifier];
+    return button ? @[ button ] : @[];
+  }
+  for (const CommandItemSpec& spec : kCommandItems) {
+    NSString* specId = @(spec.identifier);
+    if (![identifier isEqualToString:specId]) {
+      continue;
+    }
+    if (!_sidebarCommandButtons) {
+      _sidebarCommandButtons = [NSMutableDictionary dictionary];
+    }
+    NSButton* button = _sidebarCommandButtons[specId];
+    if (!button) {
+      button = SidebarItemButton(Symbol(@(spec.symbol), 14, NSFontWeightMedium),
+                                 @(spec.label), self,
+                                 @selector(runCommand:));
+      button.tag = spec.command;
+      _sidebarCommandButtons[specId] = button;
+    }
+    return @[ button ];
+  }
+  return @[];
+}
