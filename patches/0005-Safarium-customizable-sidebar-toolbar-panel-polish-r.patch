+// --- Vertical sidebar toolbar ----------------------------------------------
+// The sidebar has its own layout, independent of the horizontal NSToolbar:
+// a list of toolbar item identifiers saved in its own defaults key, using
+// the toolbar's grammar (adjacent items share a glass group, a space ends a
+// group, a flexible space ends a group and takes the leftover width) plus
+// row breaks.
+
+NSString* const kSidebarItemsKey = @"SafariumSidebarToolbarLayout";
+// First version: a flexible space started a new row and row 0 was
+// right-aligned. Migrated on first read.
+NSString* const kLegacySidebarItemsKey = @"SafariumSidebarToolbarItems";
+
+static BOOL IsSidebarSpace(NSString* identifier) {
+  return [identifier isEqualToString:NSToolbarSpaceItemIdentifier] ||
+         [identifier isEqualToString:NSToolbarFlexibleSpaceItemIdentifier];
+}
+
+// Drops rows without items (and their spaces) and stray row breaks. Spaces
+// stay where the user put them, as in an NSToolbar.
+static NSArray<NSString*>* NormalizeSidebarItems(NSArray<NSString*>* input) {
+  NSMutableArray<NSString*>* out = [NSMutableArray array];
+  NSMutableArray<NSString*>* row = [NSMutableArray array];
+  BOOL rowHasItem = NO;
+  auto endRow = [&] {
+    if (rowHasItem) {
+      if (out.count) {
+        [out addObject:kSidebarRowBreak];
+      }
+      [out addObjectsFromArray:row];
+    }
+    [row removeAllObjects];
+    rowHasItem = NO;
+  };
+  for (NSString* identifier in input) {
+    if ([identifier isEqualToString:kTabsItem]) {
+      continue;  // The tabs are the sidebar's list, not a toolbar item here.
+    }
+    if ([identifier isEqualToString:kSidebarRowBreak]) {
+      endRow();
+      continue;
+    }
+    rowHasItem |= !IsSidebarSpace(identifier);
+    [row addObject:identifier];
+  }
+  endRow();
+  return out;
+}
+
+- (NSArray<NSString*>*)defaultSidebarItemIdentifiers {
+  // Row 0 right-aligned beside the traffic lights: [back forward]
+  // [new tab, reload]; row 1 left-aligned: [overview, share, downloads], with
+  // extensions pushed to the right.
+  NSMutableArray<NSString*>* ids = [NSMutableArray arrayWithArray:@[
+    NSToolbarFlexibleSpaceItemIdentifier, kNavItem,
+    NSToolbarSpaceItemIdentifier, kNewTabItem, kReloadItem, kSidebarRowBreak,
+    kOverviewItem, kShareItem, kDownloadsItem
+  ]];
+  // Extensions the user put on the horizontal toolbar.
+  NSDictionary* saved = [NSUserDefaults.standardUserDefaults
+      dictionaryForKey:[@"NSToolbar Configuration "
+                           stringByAppendingString:kSafariumToolbarId]];
+  NSMutableArray<NSString*>* extensions = [NSMutableArray array];
+  for (NSString* identifier in saved[@"TB Item Identifiers"]) {
+    if ([identifier isKindOfClass:[NSString class]] &&
+        [identifier hasPrefix:kExtensionItemPrefix]) {
+      [extensions addObject:identifier];
+    }
+  }
+  if (extensions.count) {
+    [ids addObject:NSToolbarFlexibleSpaceItemIdentifier];
+    [ids addObjectsFromArray:extensions];
+  }
+  return ids;
+}
+
+- (NSArray<NSString*>*)storedSidebarItemIdentifiers {
+  NSUserDefaults* defaults = NSUserDefaults.standardUserDefaults;
+  NSArray* stored = [defaults stringArrayForKey:kSidebarItemsKey];
+  if (stored.count) {
+    return stored;
+  }
+  NSArray* legacy = [defaults stringArrayForKey:kLegacySidebarItemsKey];
+  if (legacy.count) {
+    NSMutableArray<NSString*>* ids = [NSMutableArray
+        arrayWithObject:NSToolbarFlexibleSpaceItemIdentifier];
+    for (NSString* identifier in legacy) {
+      [ids addObject:[identifier
+                         isEqualToString:NSToolbarFlexibleSpaceItemIdentifier]
+                         ? kSidebarRowBreak
+                         : identifier];
+    }
+    return NormalizeSidebarItems(ids);
+  }
+  return [self defaultSidebarItemIdentifiers];
+}
