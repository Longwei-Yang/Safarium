+void GetSystemSeparatorColors(SkColor* line, SkColor* background) {
+  __block SkColor line_color = SkColorSetRGB(229, 229, 229);
+  __block SkColor background_color = SK_ColorWHITE;
+  NSAppearance* appearance =
+      NSApp.effectiveAppearance
+          ?: [NSAppearance appearanceNamed:NSAppearanceNameAqua];
+  [appearance performAsCurrentDrawingAppearance:^{
+    NSColor* bg = [NSColor.windowBackgroundColor
+        colorUsingColorSpace:NSColorSpace.sRGBColorSpace];
+    NSColor* sep = [NSColor.separatorColor
+        colorUsingColorSpace:NSColorSpace.sRGBColorSpace];
+    if (!bg || !sep) {
+      return;
+    }
+    const CGFloat a = sep.alphaComponent;
+    // Rounded down, as AppKit's own separator lines come out.
+    auto channel = [](CGFloat v) {
+      return static_cast<U8CPU>(
+          std::floor(std::clamp<CGFloat>(v, 0, 1) * 255 + 0.001));
+    };
+    background_color = SkColorSetRGB(channel(bg.redComponent),
+                                     channel(bg.greenComponent),
+                                     channel(bg.blueComponent));
+    line_color = SkColorSetRGB(
+        channel(sep.redComponent * a + bg.redComponent * (1 - a)),
+        channel(sep.greenComponent * a + bg.greenComponent * (1 - a)),
+        channel(sep.blueComponent * a + bg.blueComponent * (1 - a)));
+  }];
+  *line = line_color;
+  *background = background_color;
+}
