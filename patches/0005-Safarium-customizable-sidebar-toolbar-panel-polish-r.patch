+// The customization look of a space / flexible space: a dashed capsule,
+// with arrows for the flexible one.
+static void DrawSpacer(NSRect rect, BOOL flexible) {
+  const NSRect r = NSInsetRect(rect, 1, 1);
+  const CGFloat radius = MIN(NSWidth(r), NSHeight(r)) / 2;
+  NSBezierPath* outline = [NSBezierPath bezierPathWithRoundedRect:r
+                                                          xRadius:radius
+                                                          yRadius:radius];
+  [[NSColor.controlBackgroundColor colorWithAlphaComponent:0.85] setFill];
+  [outline fill];
+  const CGFloat dash[] = {3, 2.5};
+  [outline setLineDash:dash count:2 phase:0];
+  outline.lineWidth = 1;
+  [NSColor.tertiaryLabelColor setStroke];
+  [outline stroke];
+  if (!flexible || NSWidth(r) < 22) {
+    return;
+  }
+  const CGFloat midY = NSMidY(r);
+  const CGFloat head = MIN(4, NSHeight(r) / 4);
+  const CGFloat left = NSMinX(r) + NSHeight(r) / 3;
+  const CGFloat right = NSMaxX(r) - NSHeight(r) / 3;
+  NSBezierPath* arrows = [NSBezierPath bezierPath];
+  [arrows moveToPoint:NSMakePoint(left, midY)];
+  [arrows lineToPoint:NSMakePoint(right, midY)];
+  [arrows moveToPoint:NSMakePoint(left + head, midY + head)];
+  [arrows lineToPoint:NSMakePoint(left, midY)];
+  [arrows lineToPoint:NSMakePoint(left + head, midY - head)];
+  [arrows moveToPoint:NSMakePoint(right - head, midY + head)];
+  [arrows lineToPoint:NSMakePoint(right, midY)];
+  [arrows lineToPoint:NSMakePoint(right - head, midY - head)];
+  arrows.lineWidth = 1.25;
+  arrows.lineCapStyle = NSLineCapStyleRound;
+  arrows.lineJoinStyle = NSLineJoinStyleRound;
+  [NSColor.secondaryLabelColor setStroke];
+  [arrows stroke];
+}
