+- (NSArray<NSToolbarItemIdentifier>*)configuredItemIdentifiers {
+  NSMutableArray<NSToolbarItemIdentifier>* ids =
+      [[self storedSidebarItemIdentifiers] mutableCopy];
+  // Settings > Appearance > Show home button (shared by both layouts).
+  const NSUInteger home = [ids indexOfObject:kHomeItem];
+  if (_showHome && home == NSNotFound) {
+    const NSUInteger reload = [ids indexOfObject:kReloadItem];
+    [ids insertObject:kHomeItem
+              atIndex:reload == NSNotFound ? 0 : reload + 1];
+  } else if (!_showHome && home != NSNotFound) {
+    [ids removeObjectAtIndex:home];
+  }
+  return ids;
+}
