+- (SafariumOverviewCard*)revealCardForTab:(int64_t)tabId {
+  const NSUInteger index = [_shown indexOfObjectPassingTest:^BOOL(
+      SafariumOverviewTab* tab, NSUInteger, BOOL*) {
+    return tab.tabId == tabId;
+  }];
+  if (index == NSNotFound) {
