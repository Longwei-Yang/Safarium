+// Where an item dropped at `p` would go, and where to draw the indicator:
+// between two items of a line (as in a toolbar, an item dropped next to a
+// group's item joins that group), or below the buttons for a new row.
+- (BOOL)dropTargetAtPoint:(NSPoint)p
+                    index:(NSInteger*)outIndex
+                   newRow:(BOOL*)outNewRow
+                indicator:(NSRect*)outIndicator {
+  constexpr CGFloat gap = 6;
+  for (const auto& [band, row] : _lines) {
+    if (p.y < NSMinY(band) - gap / 2 || p.y > NSMaxY(band) + gap / 2) {
+      continue;
+    }
+    __block NSInteger index = -1;
+    __block NSInteger lastIndex = -1;
+    __block NSRect previous = NSZeroRect;
+    __block CGFloat x = 0;
+    const NSRect lineBand = band;
+    const NSUInteger lineRow = row;
+    [self enumerateUnits:^(NSArray<NSView*>* unit, NSInteger unitIndex,
+                           NSUInteger r) {
+      if (index >= 0 || r != lineRow) {
+        return;
+      }
+      const NSRect frame = [self frameOfUnit:unit];
+      if (NSMidY(frame) < NSMinY(lineBand) || NSMidY(frame) > NSMaxY(lineBand)) {
+        return;
+      }
+      if (p.x < NSMidX(frame)) {
+        index = unitIndex;
+        x = lastIndex < 0 ? NSMinX(frame) - gap / 2
+                          : (NSMaxX(previous) + NSMinX(frame)) / 2;
+        return;
+      }
+      previous = frame;
+      lastIndex = unitIndex;
+    }];
+    if (index < 0) {
+      if (lastIndex < 0) {
+        continue;
+      }
+      index = lastIndex + 1;
+      x = NSMaxX(previous) + gap / 2;
+    }
+    *outIndex = index;
+    *outNewRow = NO;
+    *outIndicator = NSMakeRect(x - 1.5, NSMinY(band) + 4, 3, NSHeight(band) - 8);
+    return YES;
+  }
+  // Below the buttons (above the tabs): a new row.
+  const CGFloat size = kControlHeight;
+  if (p.y > _buttonsBottom && p.y < _buttonsBottom + size + 2 * gap) {
+    *outIndex = static_cast<NSInteger>(_itemIdentifiers.count);
+    *outNewRow = YES;
+    *outIndicator = NSMakeRect(10, _buttonsBottom + gap / 2 - 1.5,
+                               NSWidth(self.bounds) - 20, 3);
+    return YES;
+  }
+  return NO;
+}
