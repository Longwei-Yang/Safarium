+    return;
+  }
+  NSArray<NSString*>* ids = [self configuredItemIdentifiers];
+  NSMutableArray<NSArray<SafariumSidebarSegment*>*>* rows =
+      [NSMutableArray array];
+  NSMutableArray<SafariumSidebarSegment*>* row = [NSMutableArray array];
+  NSMutableArray<NSButton*>* buttons = [NSMutableArray array];
+  NSMutableArray<NSNumber*>* indexes = [NSMutableArray array];
