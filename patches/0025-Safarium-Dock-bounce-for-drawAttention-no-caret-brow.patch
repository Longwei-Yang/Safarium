 chrome/browser/ui/BUILD.gn                    |  1 +
 chrome/browser/ui/accelerator_table.cc        |  4 ++-
 .../ui/webui_browser/webui_browser_window.cc  |  3 ++-
 .../ui/webui_browser/webui_browser_window.h   |  2 ++
