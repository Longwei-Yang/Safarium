diff --git a/chrome/browser/ui/webui_browser/webui_browser_window_mac.mm b/chrome/browser/ui/webui_browser/webui_browser_window_mac.mm
index 8aa0103aee..ad0878fabd 100644
--- a/chrome/browser/ui/webui_browser/webui_browser_window_mac.mm
+++ b/chrome/browser/ui/webui_browser/webui_browser_window_mac.mm
@@ -17,6 +17,7 @@
 #import "chrome/browser/ui/cocoa/browser_window_command_handler.h"
 #import "chrome/browser/ui/cocoa/chrome_command_dispatcher_delegate.h"
 #include "chrome/browser/ui/webui_browser/safarium_features.h"
+#include "chrome/browser/ui/webui_browser/safarium_session_restore.h"
 #include "chrome/common/pref_names.h"
 #include "components/input/native_web_keyboard_event.h"
 #include "components/prefs/pref_service.h"
@@ -60,6 +61,21 @@ bool ShouldHandleKeyboardEvent(const input::NativeWebKeyboardEvent& event) {
 
 }  // namespace
 
+void WebUIBrowserWindow::FlashFrame(bool flash) {
+  // "Draw attention" (an extension's windows.update drawAttention): bounce
+  // the Dock icon until Safarium is activated, like a window flashing until
+  // it gets focus. Views' NativeWidgetMac::FlashFrame is a stub, so ask
+  // AppKit directly.
+  if (safarium_attention_request_) {
+    [NSApp cancelUserAttentionRequest:safarium_attention_request_];
+    safarium_attention_request_ = 0;
+  }
+  if (flash && !NSApp.active) {
+    safarium_attention_request_ =
+        [NSApp requestUserAttention:NSCriticalRequest];
+  }
+}
+
 bool WebUIBrowserWindow::HandleKeyboardEvent(
     const input::NativeWebKeyboardEvent& event) {
   if (!ShouldHandleKeyboardEvent(event)) {
@@ -95,6 +111,9 @@ void ValidateUserInterfaceItem(
     // This allows menu items like "Close Tabs" to be enabled when the browser
     // has open tabs, which in turn enables the "Close Tabs" keyboard shortcut.
     result->enable = chrome::IsCommandEnabled(browser_, command);
+    if (command == IDC_SAFARIUM_REOPEN_LAST_SESSION) {
+      result->enable = safarium::CanReopenLastSession(browser_);
+    }
     // Checkmark for View > Always Show Toolbar in Full Screen (Safarium's
     // native toolbar follows the same pref).
     if (command == IDC_TOGGLE_FULLSCREEN_TOOLBAR) {
@@ -165,6 +184,12 @@ bool ExecuteCommand(int32_t command,
       return false;
     }
 
+    // Safarium's own History > Reopen All Windows from Last Session.
+    if (command == IDC_SAFARIUM_REOPEN_LAST_SESSION) {
+      safarium::ReopenLastSession(browser_);
+      return true;
+    }
+
     // Actually Execute the specific command with |browser_|.
     // This facilitates commands initiated from keyboard shortcuts.
     chrome::ExecuteCommandWithDisposition(browser_, command,
