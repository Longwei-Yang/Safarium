+#if BUILDFLAG(SAFARIUM_BRANDING)
+namespace {
+
+// Safarium: Chromium's strings name the product "Chromium" in hundreds of
+// messages. Show "Safarium" instead, except where the text means the open
+// source project itself ("The Chromium Authors", "the Chromium open source
+// project", "Chromium OS", the "Chromium <version>" engine line).
+std::u16string BrandProductName(const std::u16string& str) {
+  static constexpr std::u16string_view kChromium = u"Chromium";
+  if (str.find(kChromium) == std::u16string::npos) {
+    return str;
+  }
+  static constexpr std::u16string_view kKeepBefore[] = {
+      u" Authors", u" OS", u"OS", u" open source", u" project", u" Version",
+      // "Chromium $1": the engine version line on Safarium's About page.
+      u" $",
+  };
+  std::u16string out;
+  size_t pos = 0;
+  while (true) {
+    const size_t hit = str.find(kChromium, pos);
+    if (hit == std::u16string::npos) {
+      out.append(str, pos, std::u16string::npos);
+      break;
+    }
+    out.append(str, pos, hit - pos);
+    // What follows, skipping markup such as the "</a>" of a link.
+    size_t next = hit + kChromium.size();
+    while (next < str.size() && str[next] == u'<') {
+      const size_t close = str.find(u'>', next);
+      if (close == std::u16string::npos) {
+        break;
+      }
+      next = close + 1;
+    }
+    const std::u16string_view rest = std::u16string_view(str).substr(next);
+    bool keep = false;
+    for (std::u16string_view phrase : kKeepBefore) {
+      if (rest.starts_with(phrase)) {
+        keep = true;
+        break;
+      }
+    }
+    out.append(keep ? kChromium : u"Safarium");
+    pos = hit + kChromium.size();
+  }
+  return out;
+}
+
+}  // namespace
+#endif  // BUILDFLAG(SAFARIUM_BRANDING)
+
 std::u16string ResourceBundle::MaybeMangleLocalizedString(
-    const std::u16string& str) const {
+    const std::u16string& raw_str) const {
+#if BUILDFLAG(SAFARIUM_BRANDING)
+  const std::u16string str = BrandProductName(raw_str);
+#else
+  const std::u16string& str = raw_str;
+#endif
   if (!mangle_localized_strings_)
     return str;
 
