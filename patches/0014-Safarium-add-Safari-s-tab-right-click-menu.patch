+namespace {
+
+std::optional<tabs::TabContextMenuCommand> ToChromeCommand(
+    TabBarController::TabMenuCommand command) {
+  using enum TabBarController::TabMenuCommand;
+  switch (command) {
+    case kReload:
+      return tabs::CommandReload;
+    case kDuplicate:
+      return tabs::CommandDuplicate;
+    case kTogglePinned:
+      return tabs::CommandTogglePinned;
+    case kMoveToNewWindow:
+      return tabs::CommandMoveTabsToNewWindow;
+    case kCloseTab:
+      return tabs::CommandCloseTab;
+    case kCloseOtherTabs:
+      return tabs::CommandCloseOtherTabs;
+    case kCloseTabsAfter:
+      return tabs::CommandCloseTabsToRight;
+    case kToggleMuted:
+    case kArrangeByTitle:
+    case kArrangeByWebsite:
+      return std::nullopt;
+  }
+}
+
+// Sort key for Arrange Tabs By > Website: the host without "www.".
+std::u16string WebsiteKey(content::WebContents* contents) {
+  std::string_view host = contents->GetLastCommittedURL().host();
+  if (base::StartsWith(host, "www.")) {
+    host = host.substr(4);
+  }
+  return base::UTF8ToUTF16(host);
+}
+
+}  // namespace
+
+bool TabBarController::IsTabMenuCommandEnabled(int64_t tab_id,
+                                               TabMenuCommand command) const {
+  tabs::TabInterface* tab = FindTab(tab_id);
+  if (!tab) {
+    return false;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  switch (command) {
+    case TabMenuCommand::kToggleMuted:
+      return tab->GetContents() != nullptr;
+    case TabMenuCommand::kArrangeByTitle:
+    case TabMenuCommand::kArrangeByWebsite:
+      return model->count() - model->IndexOfFirstNonPinnedTab() >= 2;
+    default:
+      return model->IsContextMenuCommandEnabled(tab->GetHandle(),
+                                                *ToChromeCommand(command));
+  }
+}
+
+void TabBarController::ExecuteTabMenuCommand(int64_t tab_id,
+                                             TabMenuCommand command) {
+  tabs::TabInterface* tab = FindTab(tab_id);
+  if (!tab || !IsTabMenuCommandEnabled(tab_id, command)) {
+    return;
+  }
+  TabStripModel* model = browser_->GetTabStripModel();
+  switch (command) {
+    case TabMenuCommand::kToggleMuted: {
+      content::WebContents* contents = tab->GetContents();
+      SetTabAudioMuted(contents, !contents->IsAudioMuted(),
+                       TabMutedReason::kAudioIndicator, std::string());
+      return;
+    }
+    case TabMenuCommand::kArrangeByTitle:
+    case TabMenuCommand::kArrangeByWebsite: {
+      // Like Safari: sorts the unpinned tabs; pinned tabs stay first.
+      struct Entry {
+        tabs::TabHandle handle;
+        std::u16string website;
+        std::u16string title;
+      };
+      const int first = model->IndexOfFirstNonPinnedTab();
+      std::vector<Entry> entries;
+      for (int i = first; i < model->count(); ++i) {
+        content::WebContents* contents = model->GetWebContentsAt(i);
+        entries.push_back({model->GetTabAtIndex(i)->GetHandle(),
+                           base::i18n::ToLower(WebsiteKey(contents)),
+                           base::i18n::ToLower(contents->GetTitle())});
+      }
+      const bool by_website = command == TabMenuCommand::kArrangeByWebsite;
+      std::stable_sort(entries.begin(), entries.end(),
+                       [by_website](const Entry& a, const Entry& b) {
+                         if (by_website && a.website != b.website) {
+                           return a.website < b.website;
+                         }
+                         return a.title < b.title;
+                       });
+      for (size_t i = 0; i < entries.size(); ++i) {
+        tabs::TabInterface* moving = entries[i].handle.Get();
+        const int from = moving ? model->GetIndexOfTab(moving) : -1;
+        const int to = first + static_cast<int>(i);
+        if (from >= 0 && from != to) {
+          model->MoveWebContentsAt(from, to, /*select_after_move=*/false);
+        }
+      }
+      return;
+    }
+    default:
+      model->ExecuteContextMenuCommand(tab->GetHandle(),
+                                       *ToChromeCommand(command));
+      return;
+  }
+}
+
+bool TabBarController::IsTabMuted(int64_t tab_id) const {
+  tabs::TabInterface* tab = FindTab(tab_id);
+  return tab && tab->GetContents() && tab->GetContents()->IsAudioMuted();
+}
+
+bool TabBarController::IsTabPinned(int64_t tab_id) const {
+  tabs::TabInterface* tab = FindTab(tab_id);
+  return tab && tab->IsPinned();
+}
+
+GURL TabBarController::TabURL(int64_t tab_id) const {
+  tabs::TabInterface* tab = FindTab(tab_id);
+  return tab && tab->GetContents() ? tab->GetContents()->GetVisibleURL()
+                                   : GURL();
+}
+
 void TabBarController::ExecuteCommand(int command_id) {
