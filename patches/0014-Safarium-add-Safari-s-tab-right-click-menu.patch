+// --- Tab right-click menu ---------------------------------------------------
+
+// Runs the tab menu's items. Each item holds it (representedObject), so it
+// lives as long as the menu.
+@interface SafariumTabMenuHandler : NSObject
+- (instancetype)initWithController:
+                    (base::WeakPtr<safarium::TabBarController>)controller
+                             tabId:(int64_t)tabId;
+@end
+
+@implementation SafariumTabMenuHandler {
+  base::WeakPtr<safarium::TabBarController> _controller;
+  int64_t _tabId;
+}
+
+- (instancetype)initWithController:
+                    (base::WeakPtr<safarium::TabBarController>)controller
+                             tabId:(int64_t)tabId {
+  if ((self = [super init])) {
+    _controller = controller;
+    _tabId = tabId;
+  }
+  return self;
+}
+
+- (void)runCommand:(NSMenuItem*)item {
+  if (_controller) {
+    _controller->ExecuteTabMenuCommand(
+        _tabId,
+        static_cast<safarium::TabBarController::TabMenuCommand>(item.tag));
+  }
+}
+
+- (void)copyLink:(id)sender {
+  const GURL url = _controller ? _controller->TabURL(_tabId) : GURL();
+  if (!url.is_valid()) {
+    return;
+  }
+  NSString* spec = base::SysUTF8ToNSString(url.spec());
+  NSPasteboard* pasteboard = NSPasteboard.generalPasteboard;
+  [pasteboard declareTypes:@[ NSPasteboardTypeURL, NSPasteboardTypeString ]
+                     owner:nil];
+  [pasteboard setString:spec forType:NSPasteboardTypeURL];
+  [pasteboard setString:spec forType:NSPasteboardTypeString];
+}
+@end
+
+namespace {
+
+// Safari's tab menu, for a tab in the bar, the sidebar or the overview.
+NSMenu* TabMenu(safarium::TabBarController* controller,
+                int64_t tabId,
+                BOOL vertical) {
+  using Command = safarium::TabBarController::TabMenuCommand;
+  SafariumTabMenuHandler* handler =
+      [[SafariumTabMenuHandler alloc] initWithController:controller->GetWeakPtr()
+                                                   tabId:tabId];
+  NSMenu* menu = [[NSMenu alloc] initWithTitle:@""];
+  menu.autoenablesItems = NO;
+  auto add = [&](NSMenu* into, NSString* title, NSString* symbol,
+                 Command command) {
+    NSMenuItem* item = AddPageMenuItem(into, title, symbol, handler,
+                                       @selector(runCommand:));
+    item.tag = static_cast<NSInteger>(command);
+    item.representedObject = handler;
+    item.enabled = controller->IsTabMenuCommandEnabled(tabId, command);
+    return item;
+  };
+  const bool pinned = controller->IsTabPinned(tabId);
+  const bool muted = controller->IsTabMuted(tabId);
+  add(menu, @"Reload Tab", @"arrow.clockwise", Command::kReload);
+  add(menu, @"Duplicate Tab", @"plus.square.on.square", Command::kDuplicate);
+  add(menu, pinned ? @"Unpin Tab" : @"Pin Tab", pinned ? @"pin.slash" : @"pin",
+      Command::kTogglePinned);
+  add(menu, muted ? @"Unmute Tab" : @"Mute Tab",
+      muted ? @"speaker.wave.2" : @"speaker.slash", Command::kToggleMuted);
+  add(menu, @"Move Tab to New Window", @"macwindow.badge.plus",
+      Command::kMoveToNewWindow);
+  [menu addItem:NSMenuItem.separatorItem];
+  add(menu, @"Close Tab", @"xmark", Command::kCloseTab);
+  add(menu, @"Close Other Tabs", nil, Command::kCloseOtherTabs);
+  add(menu, vertical ? @"Close Tabs Below" : @"Close Tabs to the Right", nil,
+      Command::kCloseTabsAfter);
+  [menu addItem:NSMenuItem.separatorItem];
+  NSMenuItem* copy =
+      AddPageMenuItem(menu, @"Copy Link", @"link", handler, @selector(copyLink:));
+  copy.representedObject = handler;
+  copy.enabled = controller->TabURL(tabId).is_valid();
+  [menu addItem:NSMenuItem.separatorItem];
+  NSMenuItem* arrange = AddPageMenuItem(menu, @"Arrange Tabs By",
+                                        @"arrow.up.arrow.down", nil, nullptr);
+  arrange.submenu = [[NSMenu alloc] initWithTitle:@""];
+  arrange.submenu.autoenablesItems = NO;
+  add(arrange.submenu, @"Title", nil, Command::kArrangeByTitle);
+  add(arrange.submenu, @"Website", nil, Command::kArrangeByWebsite);
+  arrange.enabled =
+      controller->IsTabMenuCommandEnabled(tabId, Command::kArrangeByTitle);
+  return menu;
+}
