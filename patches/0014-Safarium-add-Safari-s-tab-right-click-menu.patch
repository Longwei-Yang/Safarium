+// A right-click or Control-click on a tab (or the idle address field) pops
+// up the tab's menu. AppKit hands clicks in the toolbar to the toolbar's own
+// Customize Toolbar menu before any item view sees them, so the bar watches
+// its window's clicks instead. Returns nil (consumed) when it showed a menu.
+- (NSEvent*)handleContextClick:(NSEvent*)event {
+  if (event.window != self.window || self.hiddenOrHasHiddenAncestor ||
+      !self.superview) {
+    return event;
+  }
+  if (event.type == NSEventTypeLeftMouseDown &&
+      !(event.modifierFlags & NSEventModifierFlagControl)) {
+    return event;
+  }
+  NSView* hit = [self hitTest:[self.superview convertPoint:event.locationInWindow
+                                                  fromView:nil]];
+  NSView* tab = nil;
+  for (NSView* view = hit; view && view != self; view = view.superview) {
+    if ([view isKindOfClass:[SafariumTabCell class]]) {
+      tab = view;
+      break;
+    }
+    if (view == _addressField) {
+      if (_addressField.editing) {
+        return event;  // The text field's own menu.
+      }
+      tab = _activeCell;
+      break;
+    }
+    if ([view isKindOfClass:[NSTextView class]]) {
+      return event;  // The field editor.
+    }
+  }
+  NSMenu* menu = tab ? [self menuForTab:tab] : nil;
+  if (!menu) {
+    return event;
+  }
+  [NSMenu popUpContextMenu:menu withEvent:event forView:tab];
+  return nil;
+}
+
+- (void)dealloc {
+  if (_contextClickMonitor) {
+    [NSEvent removeMonitor:_contextClickMonitor];
+  }
+}
+
+- (void)updateContextClickMonitor {
+  if (_contextClickMonitor) {
+    [NSEvent removeMonitor:_contextClickMonitor];
+    _contextClickMonitor = nil;
+  }
+  if (!self.window) {
+    return;
+  }
+  __weak SafariumTabBarView* weakSelf = self;
+  _contextClickMonitor = [NSEvent
+      addLocalMonitorForEventsMatchingMask:NSEventMaskRightMouseDown |
+                                           NSEventMaskLeftMouseDown
+                                   handler:^NSEvent*(NSEvent* event) {
+                                     SafariumTabBarView* strongSelf = weakSelf;
+                                     return strongSelf
+                                                ? [strongSelf
+                                                      handleContextClick:event]
+                                                : event;
+                                   }];
+}
