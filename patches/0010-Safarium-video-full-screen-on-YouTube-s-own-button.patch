 namespace {
 
+// Safarium: where the full-screen animation should start and end. Sites
+// such as YouTube put a whole container (often <html>) in full screen and
+// then enlarge their player with CSS; the video inside is what the user
+// sees growing, so anchor on the largest visible video in the element.
+gfx::Rect SafariumFullscreenAnchorBounds(Element& element) {
+  gfx::Rect bounds = element.BoundsInWidget();
+  if (IsA<HTMLVideoElement>(element)) {
+    return bounds;
+  }
+  gfx::Rect best;
+  for (HTMLVideoElement& video :
+       Traversal<HTMLVideoElement>::DescendantsOf(element)) {
+    const gfx::Rect r = video.BoundsInWidget();
+    if (r.size().Area64() > best.size().Area64()) {
+      best = r;
+    }
+  }
+  return best.IsEmpty() ? bounds : best;
+}
+
+}  // namespace
