+// Runs `done` once one of the page's videos fills the viewport (width or
+// height, as a letterboxed full-screen video does) and the page has drawn
+// that, or by `deadline`.
+void WhenVideoFills(base::WeakPtr<content::WebContents> contents,
+                    base::TimeTicks deadline,
+                    base::OnceClosure done) {
+  if (!contents) {
+    std::move(done).Run();
+    return;
+  }
+  if (base::TimeTicks::Now() >= deadline) {
+    WhenDrawn(contents.get(), std::move(done));
+    return;
+  }
+  contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      u"[...document.querySelectorAll('video')].some(v => {"
+      u"  const r = v.getBoundingClientRect();"
+      u"  return r.width >= innerWidth * 0.95 ||"
+      u"         r.height >= innerHeight * 0.95;"
+      u"})",
+      base::BindOnce(
+          [](base::WeakPtr<content::WebContents> contents,
+             base::TimeTicks deadline, base::OnceClosure done,
+             base::Value fills) {
+            if (contents && fills.is_bool() && fills.GetBool()) {
+              WhenDrawn(contents.get(), std::move(done));
+              return;
+            }
+            base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+                FROM_HERE,
+                base::BindOnce(&WhenVideoFills, contents, deadline,
+                               std::move(done)),
+                kVideosFitPoll);
+          },
+          contents, deadline, std::move(done)),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
