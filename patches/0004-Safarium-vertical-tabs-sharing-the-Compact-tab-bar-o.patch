+// A sidebar uses the same tab strip as the toolbar, with room for window
+// controls and a separate set of native buttons above the scrollable tabs.
+@interface SafariumSidebarView : NSView
+@property(nonatomic, weak) SafariumTabBarView* tabView;
+@property(nonatomic, readonly) NSButton* back;
+@property(nonatomic, readonly) NSButton* forward;
+@property(nonatomic, readonly) NSButton* reload;
+@property(nonatomic, readonly) NSButton* share;
+@property(nonatomic, readonly) NSButton* home;
+@property(nonatomic, copy) NSArray<NSButton*>* extensionButtons;
+- (void)configureButtonsWithTarget:(id)target;
+@end
+
+static NSButton* SidebarGlassButton(NSImage* image,
+                                    NSString* label,
+                                    id target,
+                                    SEL action) {
+  NSButton* button = [NSButton buttonWithImage:image
+                                        target:target
+                                        action:action];
+  if (@available(macOS 26.0, *)) {
+    button.bezelStyle = NSBezelStyleGlass;
+    button.borderShape = NSControlBorderShapeCircle;
+  } else {
+    button.bezelStyle = NSBezelStyleCircular;
+  }
+  button.imageScaling = NSImageScaleProportionallyDown;
+  button.toolTip = label;
+  button.accessibilityLabel = label;
+  return button;
+}
+
+@implementation SafariumSidebarView {
+  NSVisualEffectView* _background;
+  NSView* _navigation;
+  NSButton* _downloads;
+  NSButton* _overview;
+  NSButton* _newTab;
+}
+
+@synthesize tabView = _tabView;
+@synthesize back = _back;
+@synthesize forward = _forward;
+@synthesize reload = _reload;
+@synthesize share = _share;
+@synthesize home = _home;
+@synthesize extensionButtons = _extensionButtons;
+
+- (instancetype)initWithFrame:(NSRect)frame {
+  if ((self = [super initWithFrame:frame])) {
+    _background = [[NSVisualEffectView alloc] initWithFrame:NSZeroRect];
+    _background.material = NSVisualEffectMaterialSidebar;
+    _background.blendingMode = NSVisualEffectBlendingModeBehindWindow;
+    _background.state = NSVisualEffectStateFollowsWindowActiveState;
+    _background.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+    [self addSubview:_background];
+  }
+  return self;
+}
+
+- (void)configureButtonsWithTarget:(id)target {
+  if (_navigation) {
+    return;
+  }
+  _navigation = [[NSView alloc] initWithFrame:NSZeroRect];
+  NSView* glass = MakeGlass(kControlHeight / 2);
+  glass.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  [_navigation addSubview:glass];
+  _back = MakeIconButton(@"chevron.left", 14, target, @selector(sidebarBack:));
+  _forward =
+      MakeIconButton(@"chevron.right", 14, target, @selector(sidebarForward:));
+  _back.accessibilityLabel = _back.toolTip = @"Back";
+  _forward.accessibilityLabel = _forward.toolTip = @"Forward";
+  [_navigation addSubview:_back];
+  [_navigation addSubview:_forward];
+  [self addSubview:_navigation];
+
+  _reload =
+      SidebarGlassButton(Symbol(@"arrow.clockwise", 14, NSFontWeightMedium),
+                         @"Reload", target, @selector(reload:));
+  _downloads =
+      SidebarGlassButton(Symbol(@"arrow.down.circle", 14, NSFontWeightMedium),
+                         @"Downloads", target, @selector(toggleDownloads:));
+  _share =
+      SidebarGlassButton(Symbol(@"square.and.arrow.up", 14, NSFontWeightMedium),
+                         @"Share", target, @selector(sidebarShare:));
+  _overview = SidebarGlassButton(
+      Symbol(@"square.on.square", 14, NSFontWeightMedium), @"Show Tab Overview",
+      target, @selector(toggleOverview:));
+  _newTab = SidebarGlassButton(Symbol(@"plus", 14, NSFontWeightMedium),
+                               @"New Tab", target, @selector(newTab:));
+  _home = SidebarGlassButton(Symbol(@"house", 14, NSFontWeightMedium), @"Home",
+                             target, @selector(runCommand:));
+  _home.tag = IDC_HOME;
+  _home.hidden = YES;
+  for (NSButton* button in
+       @[ _reload, _downloads, _share, _overview, _newTab, _home ]) {
+    [self addSubview:button];
+  }
+  self.needsLayout = YES;
+}
+
+- (BOOL)isFlipped {
+  return YES;
+}
+
+- (void)mouseDown:(NSEvent*)event {
+  if (event.clickCount == 2) {
+    [self.window performZoom:nil];
+  } else {
+    [self.window performWindowDragWithEvent:event];
+  }
+}
+
+- (void)setExtensionButtons:(NSArray<NSButton*>*)buttons {
+  for (NSButton* button in _extensionButtons) {
+    [button removeFromSuperview];
+  }
+  _extensionButtons = [buttons copy];
+  for (NSButton* button in _extensionButtons) {
+    [self addSubview:button];
+  }
+  self.needsLayout = YES;
+}
+
+- (void)viewDidMoveToWindow {
+  [super viewDidMoveToWindow];
+  self.needsLayout = YES;
+}
+
+- (void)layout {
+  [super layout];
+  _background.frame = self.bounds;
+  // Horizontal windows can lay out the hidden host before it has buttons.
+  if (!_navigation) {
+    return;
+  }
+  const CGFloat width = NSWidth(self.bounds);
+  constexpr CGFloat inset = 10;
+  constexpr CGFloat gap = 6;
+  const CGFloat size = kControlHeight;
+  const CGFloat navWidth = 2 * size;
+  NSButton* trafficLight =
+      [self.window standardWindowButton:NSWindowCloseButton];
+  const CGFloat centerY = trafficLight.window
+                              ? NSMidY([self convertRect:trafficLight.bounds
+                                                fromView:trafficLight])
+                              : inset + size / 2;
+  const CGFloat headerY = MAX(4, floor(centerY - size / 2));
+  const CGFloat rightEdge = width - inset;
+  _navigation.frame =
+      NSMakeRect(rightEdge - size - gap - navWidth, headerY, navWidth, size);
+  _back.frame = NSMakeRect(0, 0, size, size);
+  _forward.frame = NSMakeRect(size, 0, size, size);
+  _reload.frame = NSMakeRect(rightEdge - size, headerY, size, size);
+
+  CGFloat x = inset;
+  CGFloat y = headerY + size + gap;
+  for (NSButton* button in [@[ _newTab, _downloads, _share, _overview, _home ]
+           arrayByAddingObjectsFromArray:_extensionButtons ?: @[]]) {
+    if (button.hidden) {
+      continue;
+    }
+    if (x + size > rightEdge && x > inset) {
+      x = inset;
+      y += size + gap;
+    }
+    button.frame = NSMakeRect(x, y, size, size);
+    x += size + gap;
+  }
+  const CGFloat tabsY = y + size + gap;
+  self.tabView.frame =
+      NSMakeRect(inset, tabsY, MAX(0, width - 2 * inset),
+                 MAX(0, NSHeight(self.bounds) - tabsY - inset));
+}
+@end
