--- a/chrome/browser/ui/webui_browser/BUILD.gn
+++ b/chrome/browser/ui/webui_browser/BUILD.gn
@@ -192,6 +192,7 @@ source_set("impl") {
     "//chrome/browser/ui:browser_window_header",
     "//chrome/browser/ui:browser_window_state",
     "//chrome/browser/ui:chrome_pages",
+    "//chrome/browser/ui:sad_tab",
