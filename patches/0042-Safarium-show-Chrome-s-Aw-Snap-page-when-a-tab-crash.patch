diff --git a/chrome/browser/ui/tabs/tab_features.cc b/chrome/browser/ui/tabs/tab_features.cc
index a510be206d..9e7c3bbccd 100644
--- a/chrome/browser/ui/tabs/tab_features.cc
+++ b/chrome/browser/ui/tabs/tab_features.cc
@@ -10,6 +10,7 @@
 #include <optional>
 
 #include "base/feature_list.h"
+#include "build/safarium_buildflags.h"
 #include "base/location.h"
 #include "base/memory/ptr_util.h"
 #include "base/no_destructor.h"
@@ -888,10 +889,17 @@ void TabFeatures::Init(TabInterface& tab, Profile* profile) {
             tab, tab, tab.GetContents());
   }
 
+#if BUILDFLAG(SAFARIUM_BRANDING)
+  // Safarium's WebUI browser window shows pages in a views::WebView, so
+  // Chrome's views "Aw, Snap!" page works there.
+  sad_tab_helper_ = GetUserDataFactory().CreateInstance<SadTabHelper>(
+      tab, tab, tab.GetContents());
+#else
   if (!webui_browser::IsWebUIBrowserEnabled()) {
     sad_tab_helper_ = GetUserDataFactory().CreateInstance<SadTabHelper>(
         tab, tab, tab.GetContents());
   }
+#endif
 
   from_gws_navigation_and_keep_alive_request_observer_ =
       FromGWSNavigationAndKeepAliveRequestObserver::MaybeCreate(
