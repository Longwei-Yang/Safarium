From ba80b13fd9e13c0236ae449f58b5a6b3b2825b40 Mon Sep 17 00:00:00 2001
From: Longwei Yang <19267252+Longwei-Yang@users.noreply.github.com>
Date: Mon, 23 Nov 2026 11:10:28 -0500
Subject: [PATCH 42/48] Safarium: show Chrome's "Aw, Snap!" page when a tab
 crashes

A tab whose renderer crashed showed a blank page: Chrome does not create
SadTabHelper for WebUI browser windows, and SadTabController only looked
for the page's view in a BrowserView.

- tab_features.cc: create SadTabHelper in Safarium builds.
- sad_tab_controller.cc: without a BrowserView, find the views::WebView
  showing the tab in the window's widget (background radii only for
  ContentsWebView).
- SafariumRootView::SetActiveContents reinstalls the sad tab when
  switching tabs, as BrowserView does.

Tested: crash of the current tab and of a background tab (shown when
switched to), switching away and back, the page's Reload button, the
toolbar reload, closing a crashed tab.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 chrome/browser/ui/sad_tab_controller.cc       | 38 ++++++++++++++++---
 chrome/browser/ui/tabs/BUILD.gn               |  1 +
 chrome/browser/ui/tabs/tab_features.cc        |  8 ++++
 chrome/browser/ui/webui_browser/BUILD.gn      |  1 +
 .../ui/webui_browser/safarium_root_view.cc    |  9 +++++
 5 files changed, 52 insertions(+), 5 deletions(-)

diff --git a/chrome/browser/ui/sad_tab_controller.cc b/chrome/browser/ui/sad_tab_controller.cc
index 7a1dfbc6e4..20659585ef 100644
--- a/chrome/browser/ui/sad_tab_controller.cc
+++ b/chrome/browser/ui/sad_tab_controller.cc
@@ -12,10 +12,26 @@
 #include "content/public/browser/web_contents.h"
 #include "ui/views/view.h"
 #include "ui/views/view_utils.h"
+#include "ui/views/widget/widget.h"
 
 namespace {
 
-ContentsWebView* FindContentsWebView(content::WebContents* web_contents) {
+// Finds a WebView showing `web_contents` under `view` (depth first).
+views::WebView* FindWebViewIn(views::View* view,
+                              content::WebContents* web_contents) {
+  if (auto* web_view = views::AsViewClass<views::WebView>(view);
+      web_view && web_view->web_contents() == web_contents) {
+    return web_view;
+  }
+  for (views::View* child : view->children()) {
+    if (views::WebView* found = FindWebViewIn(child, web_contents)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+views::WebView* FindContentsWebView(content::WebContents* web_contents) {
   tabs::TabInterface* tab =
       tabs::TabInterface::MaybeGetFromContents(web_contents);
   if (!tab) {
@@ -29,7 +45,15 @@ ContentsWebView* FindContentsWebView(content::WebContents* web_contents) {
     return nullptr;
   }
   BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
-  CHECK(browser_view, base::NotFatalUntil::M162);
+  if (!browser_view) {
+    // A browser window without a BrowserView (the WebUI browser window) shows
+    // the page in a plain views::WebView somewhere in its widget.
+    views::Widget* widget = views::Widget::GetWidgetForNativeWindow(
+        browser->GetWindow()->GetNativeWindow());
+    return widget && widget->GetRootView()
+               ? FindWebViewIn(widget->GetRootView(), web_contents)
+               : nullptr;
+  }
 
   for (auto* contents_view : browser_view->GetAllVisibleContentsWebViews()) {
     if (contents_view->web_contents() == web_contents) {
@@ -49,7 +73,7 @@ SadTabController::SadTabController(content::WebContents* web_contents,
 }
 
 SadTabController::~SadTabController() {
-  ContentsWebView* contents_view = FindContentsWebView(web_contents());
+  views::WebView* contents_view = FindContentsWebView(web_contents());
   if (!contents_view) {
     return;
   }
@@ -73,7 +97,7 @@ void SadTabController::ReinstallInWebView() {
     CHECK(sad_tab_view);
   }
 
-  ContentsWebView* contents_view = FindContentsWebView(web_contents());
+  views::WebView* contents_view = FindContentsWebView(web_contents());
   if (!contents_view) {
     owned_sad_tab_view_ = std::move(sad_tab_view);
     return;
@@ -87,7 +111,11 @@ void SadTabController::ReinstallInWebView() {
     view_tracker_.SetView(sad_tab_view.get());
   }
   CHECK_EQ(view_tracker_.view(), sad_tab_view.get());
-  sad_tab_view->SetBackgroundRadii(contents_view->GetBackgroundRadii());
+  if (auto* chrome_contents_view =
+          views::AsViewClass<ContentsWebView>(contents_view)) {
+    sad_tab_view->SetBackgroundRadii(
+        chrome_contents_view->GetBackgroundRadii());
+  }
   contents_view->TakeCrashedOverlayView(
       std::move(sad_tab_view),
       base::BindOnce(
