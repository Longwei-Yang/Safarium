diff --git a/chrome/browser/ui/webui_browser/safarium_root_view.cc b/chrome/browser/ui/webui_browser/safarium_root_view.cc
index 5120215b41..9c95a49ee1 100644
--- a/chrome/browser/ui/webui_browser/safarium_root_view.cc
+++ b/chrome/browser/ui/webui_browser/safarium_root_view.cc
@@ -5,9 +5,11 @@
 
 #include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/ui/browser_element_identifiers.h"
+#include "chrome/browser/ui/sad_tab_helper.h"
 #include "chrome/common/pref_names.h"
 #include "components/prefs/pref_service.h"
 #include "chrome/browser/ui/webui_browser/safarium_tab_bar_controller.h"
+#include "components/tabs/public/tab_interface.h"
 #include "content/public/browser/web_contents.h"
 #include "ui/base/metadata/metadata_impl_macros.h"
 #include "ui/color/color_id.h"
@@ -119,6 +121,13 @@ void SafariumRootView::OnSidebarResize(int width, bool done) {
 
 void SafariumRootView::SetActiveContents(content::WebContents* contents) {
   contents_web_view_->SetWebContents(contents);
+  // A tab whose page crashed shows Chrome's "Aw, Snap!" page over it, as
+  // BrowserView does when switching tabs.
+  tabs::TabInterface* tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  if (SadTabHelper* sad_tab_helper = tab ? SadTabHelper::From(tab) : nullptr) {
+    sad_tab_helper->ReinstallInWebView();
+  }
 }
 
 void SafariumRootView::ShowSidePanel(std::unique_ptr<views::View> content,
