@@ -0,0 +1,32 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Safarium: Safari-style Add Bookmark panel (⌘D). Chrome has already added
+// the bookmark when the panel opens (chrome::BookmarkCurrentTab); the panel
+// keeps it only when the user presses Add, after applying the chosen title
+// and folder. Cancel, Escape or clicking elsewhere takes it out again. For a
+// page that was already bookmarked the panel edits that bookmark instead.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_BOOKMARK_PANEL_H_
+#define CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_BOOKMARK_PANEL_H_
+
+#import <AppKit/AppKit.h>
+
+class GURL;
+class Profile;
+
+namespace safarium {
+
+// Shows the panel next to `anchor` (the address field, or the current tab's
+// row in the vertical sidebar) on `edge`. Returns false if there is no
+// bookmark for `url` to show.
+bool ShowBookmarkPanel(NSView* anchor,
+                       NSRectEdge edge,
+                       Profile* profile,
+                       const GURL& url,
+                       bool already_bookmarked);
+
+}  // namespace safarium
+
+#endif  // CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_BOOKMARK_PANEL_H_
diff --git a/chrome/browser/ui/webui_browser/safarium_bookmark_panel_mac.mm b/chrome/browser/ui/webui_browser/safarium_bookmark_panel_mac.mm
new file mode 100644
index 0000000000..d965557511
--- /dev/null
+++ b/chrome/browser/ui/webui_browser/safarium_bookmark_panel_mac.mm
@@ -0,0 +1,263 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "chrome/browser/ui/webui_browser/safarium_bookmark_panel.h"
+
+#include <string>
+
+#include "base/location.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/sys_string_conversions.h"
+#include "chrome/browser/bookmarks/bookmark_model_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_node.h"
+#include "components/bookmarks/browser/bookmark_utils.h"
+#include "components/bookmarks/common/bookmark_metrics.h"
+#include "url/gurl.h"
+
+using bookmarks::BookmarkModel;
+using bookmarks::BookmarkNode;
+
+namespace {
+
+constexpr CGFloat kPanelWidth = 320;
+constexpr CGFloat kInset = 16;
+
+NSImage* FolderSymbol(NSString* name) {
+  return [NSImage imageWithSystemSymbolName:name accessibilityDescription:nil];
+}
+
+}  // namespace
+
+// Owns the popover's content and decides what happens to the bookmark when
+// the popover closes.
+@interface SafariumBookmarkPanel : NSViewController <NSPopoverDelegate>
+- (instancetype)initWithModel:(BookmarkModel*)model
+                         node:(const BookmarkNode*)node
+            alreadyBookmarked:(BOOL)alreadyBookmarked;
+- (void)showRelativeToView:(NSView*)anchor edge:(NSRectEdge)edge;
+- (BOOL)isOpen;
+@end
+
+namespace {
+// The open panel, if any (one at a time, like Safari's).
+__weak SafariumBookmarkPanel* g_open_panel = nil;
+}  // namespace
+
+@implementation SafariumBookmarkPanel {
+  base::WeakPtr<BookmarkModel> _model;
+  int64_t _nodeId;
+  BOOL _alreadyBookmarked;
+  BOOL _decided;  // Add/Done/Remove was pressed.
+  NSPopover* _popover;
+  NSPopUpButton* _folders;
+  NSTextField* _title;
+}
+
+- (instancetype)initWithModel:(BookmarkModel*)model
+                         node:(const BookmarkNode*)node
+            alreadyBookmarked:(BOOL)alreadyBookmarked {
+  if ((self = [super initWithNibName:nil bundle:nil])) {
+    _model = model->AsWeakPtr();
+    _nodeId = node->id();
+    _alreadyBookmarked = alreadyBookmarked;
+  }
+  return self;
+}
+
+- (const BookmarkNode*)node {
+  return _model ? bookmarks::GetBookmarkNodeByID(_model.get(), _nodeId)
+                : nullptr;
+}
+
+// Every folder the bookmark can go in, permanent folders first, children
+// indented under their parents (as in Safari's "Add this page to" menu).
+- (void)addFolder:(const BookmarkNode*)folder
+           symbol:(NSString*)symbol
+           indent:(NSInteger)indent {
+  NSMenuItem* item = [[NSMenuItem alloc]
+      initWithTitle:base::SysUTF16ToNSString(folder->GetTitle())
+             action:nil
+      keyEquivalent:@""];
+  item.image = FolderSymbol(symbol);
+  if (@available(macOS 27.0, *)) {
+    item.preferredImageVisibility = NSMenuItemImageVisibilityVisible;
+  }
+  item.indentationLevel = indent;
+  item.tag = static_cast<NSInteger>(folder->id());
+  [_folders.menu addItem:item];
+  for (const auto& child : folder->children()) {
+    if (child->is_folder()) {
+      [self addFolder:child.get() symbol:@"folder" indent:indent + 1];
+    }
+  }
+}
+
+- (void)loadView {
+  const BookmarkNode* node = [self node];
+  BookmarkModel* model = _model.get();
+
+  NSTextField* header = [NSTextField
+      labelWithString:_alreadyBookmarked ? @"This page is in:"
+                                         : @"Add this page to:"];
+  _folders = [[NSPopUpButton alloc] initWithFrame:NSZeroRect pullsDown:NO];
+  _folders.menu.autoenablesItems = NO;
+  [self addFolder:model->bookmark_bar_node() symbol:@"star" indent:0];
+  [_folders.menu addItem:NSMenuItem.separatorItem];
+  [self addFolder:model->other_node() symbol:@"book" indent:0];
+  if (model->mobile_node()->IsVisible()) {
+    [self addFolder:model->mobile_node() symbol:@"iphone" indent:0];
+  }
+  [_folders selectItemWithTag:static_cast<NSInteger>(node->parent()->id())];
+  [_folders setContentHuggingPriority:NSLayoutPriorityDefaultLow
+                       forOrientation:NSLayoutConstraintOrientationHorizontal];
+  NSStackView* top = [NSStackView stackViewWithViews:@[ header, _folders ]];
+  top.spacing = 8;
+
+  _title = [NSTextField
+      textFieldWithString:base::SysUTF16ToNSString(node->GetTitle())];
+  _title.placeholderString = @"Title";
+  _title.lineBreakMode = NSLineBreakByTruncatingTail;
+  _title.cell.scrollable = YES;
+
+  NSView* spacer = [[NSView alloc] initWithFrame:NSZeroRect];
+  [spacer setContentHuggingPriority:1
+                     forOrientation:NSLayoutConstraintOrientationHorizontal];
+  NSMutableArray<NSView*>* buttons = [NSMutableArray array];
+  if (_alreadyBookmarked) {
+    [buttons addObject:[NSButton buttonWithTitle:@"Remove Bookmark"
+                                          target:self
+                                          action:@selector(remove:)]];
+  }
+  [buttons addObject:spacer];
+  if (!_alreadyBookmarked) {
+    NSButton* cancel = [NSButton buttonWithTitle:@"Cancel"
+                                          target:self
+                                          action:@selector(cancel:)];
+    cancel.keyEquivalent = @"\e";
+    [buttons addObject:cancel];
+  }
+  NSButton* confirm =
+      [NSButton buttonWithTitle:_alreadyBookmarked ? @"Done" : @"Add"
+                         target:self
+                         action:@selector(confirm:)];
+  confirm.keyEquivalent = @"\r";
+  [buttons addObject:confirm];
+  NSStackView* buttonRow = [NSStackView stackViewWithViews:buttons];
+  buttonRow.spacing = 8;
+
+  NSStackView* stack =
+      [NSStackView stackViewWithViews:@[ top, _title, buttonRow ]];
+  stack.orientation = NSUserInterfaceLayoutOrientationVertical;
+  stack.alignment = NSLayoutAttributeLeading;
+  stack.spacing = 10;
+  stack.edgeInsets = NSEdgeInsetsMake(kInset, kInset, kInset, kInset);
+  [stack.widthAnchor constraintEqualToConstant:kPanelWidth].active = YES;
+  for (NSView* row in @[ top, _title, buttonRow ]) {
+    [row.widthAnchor constraintEqualToAnchor:stack.widthAnchor
+                                    constant:-2 * kInset]
+        .active = YES;
+  }
+  self.view = stack;
+  self.preferredContentSize = stack.fittingSize;
+}
+
+- (void)showRelativeToView:(NSView*)anchor edge:(NSRectEdge)edge {
+  _popover = [[NSPopover alloc] init];
+  _popover.contentViewController = self;
+  _popover.behavior = NSPopoverBehaviorTransient;
+  _popover.animates = YES;
+  _popover.delegate = self;
+  [_popover showRelativeToRect:anchor.bounds ofView:anchor preferredEdge:edge];
+  g_open_panel = self;
+  [self.view.window makeFirstResponder:_title];
+  [_title selectText:nil];
+}
+
+// Add (new bookmark) / Done (existing one): keep it with the chosen title
+// and folder.
+- (void)confirm:(id)sender {
+  _decided = YES;
+  const BookmarkNode* node = [self node];
+  BookmarkModel* model = _model.get();
+  if (node && model) {
+    const std::u16string title = base::SysNSStringToUTF16(_title.stringValue);
+    if (!title.empty() && title != node->GetTitle()) {
+      model->SetTitle(node, title, bookmarks::metrics::BookmarkEditSource::kUser);
+    }
+    const BookmarkNode* folder = bookmarks::GetBookmarkNodeByID(
+        model, _folders.selectedItem.tag);
+    if (folder && folder->is_folder() && folder != node->parent()) {
+      model->Move(node, folder, folder->children().size());
+    }
+  }
+  [_popover close];
+}
+
+- (void)cancel:(id)sender {
+  [_popover close];  // -popoverDidClose: takes the new bookmark out.
+}
+
+- (void)remove:(id)sender {
+  _decided = YES;
+  const BookmarkNode* node = [self node];
+  if (node && _model) {
+    bookmarks::RemoveAllBookmarks(_model.get(), node->url(), FROM_HERE);
+  }
+  [_popover close];
+}
+
+// NSPopoverDelegate. Closing without Add (Cancel, Escape, a click elsewhere,
+// the window closing) leaves no new bookmark behind, as in Safari. An
+// existing bookmark is left as it was.
+- (void)popoverDidClose:(NSNotification*)notification {
+  if (!_decided && !_alreadyBookmarked) {
+    _decided = YES;
+    const BookmarkNode* node = [self node];
+    if (node && _model) {
+      _model->Remove(node, bookmarks::metrics::BookmarkEditSource::kUser,
+                     FROM_HERE);
+    }
+  }
+  _popover.contentViewController = nil;
+  _popover = nil;
+}
+
+- (BOOL)isOpen {
+  return _popover.shown;
+}
+
+@end
+
+namespace safarium {
+
+bool ShowBookmarkPanel(NSView* anchor,
+                       NSRectEdge edge,
+                       Profile* profile,
+                       const GURL& url,
+                       bool already_bookmarked) {
+  if (!anchor.window || anchor.hiddenOrHasHiddenAncestor || !profile) {
+    return false;
+  }
+  BookmarkModel* model = BookmarkModelFactory::GetForBrowserContext(profile);
+  const BookmarkNode* node =
+      model ? model->GetMostRecentlyAddedUserNodeForURL(url) : nullptr;
+  if (!node) {
+    return false;
+  }
+  // ⌘D again while the panel is open: keep the open panel (Chrome has not
+  // added anything new, the page is already bookmarked).
+  if (SafariumBookmarkPanel* open = g_open_panel; open && [open isOpen]) {
+    return true;
+  }
+  SafariumBookmarkPanel* panel =
+      [[SafariumBookmarkPanel alloc] initWithModel:model
+                                              node:node
+                                 alreadyBookmarked:already_bookmarked];
+  [panel showRelativeToView:anchor edge:edge];
+  return true;
+}
+
+}  // namespace safarium
