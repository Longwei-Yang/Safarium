+- (BOOL)showBookmarkPanelForURL:(const GURL&)url
+              alreadyBookmarked:(BOOL)alreadyBookmarked {
+  if (!_controller) {
+    return NO;
+  }
+  [self layoutSubtreeIfNeeded];
+  // The current tab's pill is the address field; in the sidebar the panel
+  // opens to the right of that row (where address suggestions appear).
+  NSView* anchor = _activeCell;
+  if (!anchor.window || anchor.hiddenOrHasHiddenAncestor) {
+    anchor = _addressField;
+  }
+  const NSRectEdge edge =
+      _vertical ? NSRectEdgeMaxX
+                : (anchor.isFlipped ? NSRectEdgeMaxY : NSRectEdgeMinY);
+  return safarium::ShowBookmarkPanel(anchor, edge, _controller->GetProfile(),
+                                     url, alreadyBookmarked);
+}
