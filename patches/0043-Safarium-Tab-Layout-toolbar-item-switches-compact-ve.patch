From 28ebb0b5ec67807bcdc1e24165f909b916f033dc Mon Sep 17 00:00:00 2001
From: Longwei Yang <19267252+Longwei-Yang@users.noreply.github.com>
Date: Mon, 23 Nov 2026 11:16:32 -0500
Subject: [PATCH 43/48] Safarium: Tab Layout toolbar item switches
 compact/vertical tabs

A new optional item, "Tab Layout" (sidebar.left), in Customize Toolbar
and in the sidebar's edit palette. It flips vertical_tabs.enabled, like
Settings > Tabs and View > Show Tabs Vertically. The pref changes after
the click returns, since switching rebuilds the toolbar or sidebar that
holds the button. Does nothing when the pref is managed.

Tested: toolbar button switches to vertical, the sidebar button switches
back.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../safarium_tab_bar_controller.cc            | 20 +++++++++++
 .../safarium_tab_bar_controller.h             |  4 +++
 .../safarium_tab_bar_host_mac.mm              | 36 ++++++++++++++++++-
 3 files changed, 59 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/ui/webui_browser/safarium_tab_bar_controller.cc b/chrome/browser/ui/webui_browser/safarium_tab_bar_controller.cc
index 67e8c891e3..6c3c8059ad 100644
--- a/chrome/browser/ui/webui_browser/safarium_tab_bar_controller.cc
+++ b/chrome/browser/ui/webui_browser/safarium_tab_bar_controller.cc
@@ -3,6 +3,7 @@
 #include <utility>
 
 #include "base/strings/escape.h"
+#include "base/task/sequenced_task_runner.h"
 #include "base/strings/utf_string_conversions.h"
 #include "chrome/app/chrome_command_ids.h"
 #include "chrome/browser/autocomplete/autocomplete_classifier_factory.h"
@@ -761,6 +762,25 @@ void TabBarController::SetShowHomeButton(bool show) {
   browser_->GetProfile()->GetPrefs()->SetBoolean(prefs::kShowHomeButton, show);
 }
 
+void TabBarController::ToggleVerticalTabs() {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<TabBarController> controller) {
+                       if (!controller) {
+                         return;
+                       }
+                       PrefService* prefs =
+                           controller->browser_->GetProfile()->GetPrefs();
+                       if (prefs->IsUserModifiablePreference(
+                               prefs::kVerticalTabsEnabled)) {
+                         prefs->SetBoolean(
+                             prefs::kVerticalTabsEnabled,
+                             !prefs->GetBoolean(prefs::kVerticalTabsEnabled));
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
+
 Profile* TabBarController::GetProfile() const {
   return browser_->GetProfile();
 }
