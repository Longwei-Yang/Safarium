+  void ToggleVerticalTabs();
 
   // TabStripModelObserver:
   void OnTabStripModelChanged(TabStripModel* tab_strip_model,
diff --git a/chrome/browser/ui/webui_browser/safarium_tab_bar_host_mac.mm b/chrome/browser/ui/webui_browser/safarium_tab_bar_host_mac.mm
index 260a74720d..bcb6abe0c7 100644
--- a/chrome/browser/ui/webui_browser/safarium_tab_bar_host_mac.mm
+++ b/chrome/browser/ui/webui_browser/safarium_tab_bar_host_mac.mm
@@ -4258,6 +4258,8 @@ - (NSCollectionViewItem*)collectionView:(NSCollectionView*)collectionView
 NSToolbarItemIdentifier const kShareItem = @"safarium.share";
 NSToolbarItemIdentifier const kPrintItem = @"safarium.print";
 NSToolbarItemIdentifier const kOverviewItem = @"safarium.overview";
+NSToolbarItemIdentifier const kTabLayoutItem = @"safarium.tablayout";
+NSString* const kTabLayoutSymbol = @"sidebar.left";
 
 // Plain C strings: a static array of ObjC pointers would need an exit-time
 // destructor under ARC.
@@ -5925,6 +5927,20 @@ - (void)saveSidebarItemIdentifiers:(NSArray<NSString*>*)ids {
     NSButton* button = _sidebarExtensionButtons[identifier];
     return button ? @[ button ] : @[];
   }
+  if ([identifier isEqualToString:kTabLayoutItem]) {
+    if (!_sidebarCommandButtons) {
+      _sidebarCommandButtons = [NSMutableDictionary dictionary];
+    }
+    NSButton* button = _sidebarCommandButtons[identifier];
+    if (!button) {
+      button = SidebarItemButton(Symbol(kTabLayoutSymbol, 14,
+                                        NSFontWeightMedium),
+                                 @"Show Tabs in Toolbar", self,
+                                 @selector(toggleTabLayout:));
+      _sidebarCommandButtons[identifier] = button;
+    }
+    return @[ button ];
+  }
   for (const CommandItemSpec& spec : kCommandItems) {
     NSString* specId = @(spec.identifier);
     if (![identifier isEqualToString:specId]) {
@@ -6018,6 +6034,7 @@ - (NSString*)labelForItem:(NSString*)identifier image:(NSImage**)image {
       {kDownloadsItem, @"Downloads", @"arrow.down.circle"},
       {kShareItem, @"Share", @"square.and.arrow.up"},
       {kOverviewItem, @"Tab Overview", @"square.on.square"},
+      {kTabLayoutItem, @"Tab Layout", kTabLayoutSymbol},
   };
   for (const Fixed& f : fixed) {
     if ([identifier isEqualToString:f.identifier]) {
@@ -6234,7 +6251,8 @@ - (void)uninstall {
       [NSMutableOrderedSet orderedSetWithArray:@[
     kNavItem, kReloadItem, kTabsItem, kNewTabItem, kHomeItem, kDownloadsItem,
     kHistoryItem, kBookmarksItem, kShareItem, kPrintItem, kOverviewItem,
-    NSToolbarSpaceItemIdentifier, NSToolbarFlexibleSpaceItemIdentifier
+    kTabLayoutItem, NSToolbarSpaceItemIdentifier,
+    NSToolbarFlexibleSpaceItemIdentifier
   ]];
   if (auto* extensions = _controller ? _controller->GetExtensionsContainer()
                                      : nullptr) {
@@ -6334,6 +6352,16 @@ - (NSToolbarItem*)toolbar:(NSToolbar*)toolbar
     item.paletteLabel = @"Tab Overview";
     return item;
   }
+  if ([identifier isEqualToString:kTabLayoutItem]) {
+    // Shown in the toolbar only in the compact layout; the vertical layout's
+    // sidebar has its own button (-sidebarButtonsForItem:).
+    NSToolbarItem* item = [self buttonItem:identifier
+                                     label:@"Tab Layout"
+                                    symbol:kTabLayoutSymbol
+                                    action:@selector(toggleTabLayout:)];
+    item.toolTip = @"Show Tabs in Sidebar";
+    return item;
+  }
   if ([identifier isEqualToString:kShareItem]) {
     NSSharingServicePickerToolbarItem* item =
         [[NSSharingServicePickerToolbarItem alloc]
@@ -6896,6 +6924,12 @@ - (void)runCommand:(id)sender {
   }
 }
 
+- (void)toggleTabLayout:(id)sender {
+  if (_controller) {
+    _controller->ToggleVerticalTabs();
+  }
+}
