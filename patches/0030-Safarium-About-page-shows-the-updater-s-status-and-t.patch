diff --git a/chrome/browser/ui/webui_browser/safarium_update_check.h b/chrome/browser/ui/webui_browser/safarium_update_check.h
new file mode 100644
index 0000000000..3071376236
--- /dev/null
+++ b/chrome/browser/ui/webui_browser/safarium_update_check.h
@@ -0,0 +1,40 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Safarium: which release this app is, and whether GitHub has a newer one.
+// Shared by the updater (safarium_updater.h) and the About page. The
+// packaging script stamps Info.plist with SafariumBuild (the fix number),
+// SafariumTag (v<version>-fix<N>, or "local") and SafariumCommit.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_UPDATE_CHECK_H_
+#define CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_UPDATE_CHECK_H_
+
+#include <string>
+
+#include "base/functional/callback_forward.h"
+
+namespace safarium {
+
+struct ReleaseCheck {
+  enum class Result { kUpToDate, kAvailable, kFailed };
+  Result result = Result::kFailed;
+  std::string latest_tag;   // v160.0.8167.0-fix6
+  std::string latest_name;  // fix6
+};
+
+// Reads the latest GitHub release (defaults key SafariumUpdateFeedURL
+// overrides the feed, for testing) and compares it with this app. Calls
+// `done` on the calling sequence.
+void CheckLatestRelease(base::OnceCallback<void(const ReleaseCheck&)> done);
+
+// This app as people should see it: "Safarium fix5", "Local build
+// c2a2f8ab89, based on fix5", or "" for an unstamped development build.
+std::string InstalledSafariumVersion();
+
+// True for builds the packaging script stamped (they check for updates).
+bool IsStampedBuild();
+
+}  // namespace safarium
+
+#endif  // CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_UPDATE_CHECK_H_
diff --git a/chrome/browser/ui/webui_browser/safarium_update_check_mac.mm b/chrome/browser/ui/webui_browser/safarium_update_check_mac.mm
new file mode 100644
index 0000000000..d7a994ef69
--- /dev/null
+++ b/chrome/browser/ui/webui_browser/safarium_update_check_mac.mm
@@ -0,0 +1,130 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui_browser/safarium_update_check.h"
+
+#import <Foundation/Foundation.h>
+
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+
+namespace safarium {
+
+namespace {
+
+NSString* const kDefaultFeedURL =
+    @"https://api.github.com/repos/Longwei-Yang/Safarium/releases/latest";
+
+struct Version {
+  std::vector<int> chromium;
+  int fix = 0;
+  bool valid = false;
+};
+
+Version ParseTag(NSString* tag) {
+  Version v;
+  NSRegularExpression* re = [NSRegularExpression
+      regularExpressionWithPattern:@"^v?([0-9]+(?:\\.[0-9]+)*)-fix([0-9]+)$"
+                           options:0
+                             error:nil];
+  NSTextCheckingResult* m =
+      tag ? [re firstMatchInString:tag options:0 range:NSMakeRange(0, tag.length)]
+          : nil;
+  if (!m) {
+    return v;
+  }
+  for (NSString* part in [[tag substringWithRange:[m rangeAtIndex:1]]
+           componentsSeparatedByString:@"."]) {
+    v.chromium.push_back(part.intValue);
+  }
+  v.fix = [tag substringWithRange:[m rangeAtIndex:2]].intValue;
+  v.valid = true;
+  return v;
+}
+
+Version Installed() {
+  NSDictionary* info = NSBundle.mainBundle.infoDictionary;
+  Version v;
+  for (NSString* part in [info[@"CFBundleShortVersionString"]
+           componentsSeparatedByString:@"."]) {
+    v.chromium.push_back(part.intValue);
+  }
+  v.fix = [info[@"SafariumBuild"] intValue];
+  v.valid = true;
+  return v;
+}
+
+bool IsNewer(const Version& a, const Version& b) {
+  return a.chromium != b.chromium ? a.chromium > b.chromium : a.fix > b.fix;
+}
+
+}  // namespace
+
+bool IsStampedBuild() {
+  return [NSBundle.mainBundle.infoDictionary[@"SafariumTag"] length] > 0;
+}
+
+std::string InstalledSafariumVersion() {
+  NSDictionary* info = NSBundle.mainBundle.infoDictionary;
+  NSString* tag = info[@"SafariumTag"];
+  const int fix = [info[@"SafariumBuild"] intValue];
+  if ([tag isEqualToString:@"local"]) {
+    return base::SysNSStringToUTF8([NSString
+        stringWithFormat:@"Local build %@, based on fix%d",
+                         info[@"SafariumCommit"] ?: @"?", fix]);
+  }
+  if (tag.length) {
+    return base::SysNSStringToUTF8(
+        [NSString stringWithFormat:@"Safarium fix%d", fix]);
+  }
+  return std::string();
+}
+
+void CheckLatestRelease(base::OnceCallback<void(const ReleaseCheck&)> done) {
+  NSString* feed =
+      [NSUserDefaults.standardUserDefaults stringForKey:@"SafariumUpdateFeedURL"]
+          ?: kDefaultFeedURL;
+  NSMutableURLRequest* request =
+      [NSMutableURLRequest requestWithURL:[NSURL URLWithString:feed]];
+  [request setValue:@"application/vnd.github+json" forHTTPHeaderField:@"Accept"];
+  [request setValue:@"Safarium-Updater" forHTTPHeaderField:@"User-Agent"];
+  request.cachePolicy = NSURLRequestReloadIgnoringLocalCacheData;
+  request.timeoutInterval = 30;
+  scoped_refptr<base::SequencedTaskRunner> reply =
+      base::SequencedTaskRunner::GetCurrentDefault();
+  __block base::OnceCallback<void(const ReleaseCheck&)> callback =
+      std::move(done);
+  [[NSURLSession.sharedSession
+      dataTaskWithRequest:request
+        completionHandler:^(NSData* data, NSURLResponse* response,
+                            NSError* error) {
+          ReleaseCheck check;
+          NSDictionary* release = nil;
+          if (data && [(NSHTTPURLResponse*)response statusCode] == 200) {
+            id json = [NSJSONSerialization JSONObjectWithData:data
+                                                      options:0
+                                                        error:nil];
+            release = [json isKindOfClass:NSDictionary.class] ? json : nil;
+          }
+          NSString* tag = release[@"tag_name"];
+          const Version latest = ParseTag(tag);
+          if (latest.valid) {
+            check.latest_tag = base::SysNSStringToUTF8(tag);
+            check.latest_name = base::SysNSStringToUTF8(
+                [NSString stringWithFormat:@"fix%d", latest.fix]);
+            check.result = IsNewer(latest, Installed())
+                               ? ReleaseCheck::Result::kAvailable
+                               : ReleaseCheck::Result::kUpToDate;
+          }
+          reply->PostTask(FROM_HERE,
+                          base::BindOnce(std::move(callback), check));
+        }] resume];
+}
+
+}  // namespace safarium
