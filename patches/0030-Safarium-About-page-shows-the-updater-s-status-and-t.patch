 }  // namespace
 
+#if BUILDFLAG(SAFARIUM_BRANDING)
+namespace {
+
+// Safarium's own updater (safarium_updater.h) installs releases from
+// GitHub; the About page shows what it finds and points to Check for
+// Updates…, which shows the notes and installs.
+class SafariumVersionUpdater : public VersionUpdater {
+ public:
+  SafariumVersionUpdater() = default;
+  SafariumVersionUpdater(const SafariumVersionUpdater&) = delete;
+  SafariumVersionUpdater& operator=(const SafariumVersionUpdater&) = delete;
+  ~SafariumVersionUpdater() override = default;
+
+  void CheckForUpdate(StatusCallback status_callback,
+                      PromoteCallback promote_callback) override {
+    if (!safarium::IsStampedBuild()) {
+      // Development builds don't update.
+      status_callback.Run(DISABLED, 0, false, false, std::string(), 0,
+                          std::u16string());
+      return;
+    }
+    status_callback.Run(CHECKING, 0, false, false, std::string(), 0,
+                        std::u16string());
+    safarium::CheckLatestRelease(base::BindOnce(
+        [](StatusCallback status_callback,
+           const safarium::ReleaseCheck& check) {
+          switch (check.result) {
+            case safarium::ReleaseCheck::Result::kUpToDate:
+              status_callback.Run(UPDATED, 0, false, false, std::string(), 0,
+                                  std::u16string());
+              break;
+            case safarium::ReleaseCheck::Result::kAvailable:
+              status_callback.Run(
+                  DEFERRED, 0, false, false, check.latest_tag, 0,
+                  base::UTF8ToUTF16(
+                      "Safarium " + check.latest_name +
+                      " is available. Choose Safarium \u203a Check for "
+                      "Updates\u2026 to install it."));
+              break;
+            case safarium::ReleaseCheck::Result::kFailed:
+              status_callback.Run(
+                  FAILED_HTTP, 0, false, false, std::string(), 0,
+                  u"Safarium couldn't check for updates. Check your internet "
+                  u"connection and try again.");
+              break;
+          }
+        },
+        status_callback));
+  }
+  void PromoteUpdater() override {}
+};
+
+}  // namespace
+
+std::unique_ptr<VersionUpdater> VersionUpdater::Create(
+    content::WebContents* /* web_contents */) {
+  return base::WrapUnique(new SafariumVersionUpdater());
+}
+#else
 std::unique_ptr<VersionUpdater> VersionUpdater::Create(
     content::WebContents* /* web_contents */) {
   return base::WrapUnique(new VersionUpdaterMac());
 }
+#endif  // BUILDFLAG(SAFARIUM_BRANDING)
