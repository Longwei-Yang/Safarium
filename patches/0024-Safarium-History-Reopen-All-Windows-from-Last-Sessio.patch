diff --git a/chrome/browser/ui/webui_browser/safarium_session_restore.cc b/chrome/browser/ui/webui_browser/safarium_session_restore.cc
new file mode 100644
index 0000000000..e97da5e670
--- /dev/null
+++ b/chrome/browser/ui/webui_browser/safarium_session_restore.cc
@@ -0,0 +1,54 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui_browser/safarium_session_restore.h"
+
+#include <set>
+
+#include "base/no_destructor.h"
+#include "chrome/browser/prefs/session_startup_pref.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/exit_type_service.h"
+#include "chrome/browser/sessions/session_restore.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+
+namespace safarium {
+
+namespace {
+
+// Profiles whose last session was reopened this run.
+std::set<const Profile*>& Reopened() {
+  static base::NoDestructor<std::set<const Profile*>> reopened;
+  return *reopened;
+}
+
+}  // namespace
+
+bool CanReopenLastSession(BrowserWindowInterface* browser) {
+  if (!browser) {
+    return false;
+  }
+  Profile* profile = browser->GetProfile();
+  if (profile->IsOffTheRecord() || Reopened().contains(profile)) {
+    return false;
+  }
+  // Startup already reopened the last session ("Safarium opens with: All
+  // tabs from the last session"), unless the last run crashed, in which case
+  // startup opened a new tab instead.
+  const bool crashed =
+      ExitTypeService::GetLastSessionExitType(profile) == ExitType::kCrashed;
+  return crashed ||
+         !SessionStartupPref::GetStartupPref(profile).ShouldRestoreLastSession();
+}
+
+void ReopenLastSession(BrowserWindowInterface* browser) {
+  if (!CanReopenLastSession(browser)) {
+    return;
+  }
+  Reopened().insert(browser->GetProfile());
+  // Restores the previous run's windows; a lone New Tab page is replaced.
+  SessionRestore::RestoreSessionAfterCrash(browser);
+}
+
+}  // namespace safarium
diff --git a/chrome/browser/ui/webui_browser/safarium_session_restore.h b/chrome/browser/ui/webui_browser/safarium_session_restore.h
new file mode 100644
index 0000000000..291b896ec2
--- /dev/null
+++ b/chrome/browser/ui/webui_browser/safarium_session_restore.h
@@ -0,0 +1,20 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_SESSION_RESTORE_H_
+#define CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_SESSION_RESTORE_H_
+
+class BrowserWindowInterface;
+
+namespace safarium {
+
+// History > Reopen All Windows from Last Session (Safari's command; Safarium
+// shows no "Restore pages?" prompt after a crash). Available once per run,
+// unless startup already reopened the last session.
+bool CanReopenLastSession(BrowserWindowInterface* browser);
+void ReopenLastSession(BrowserWindowInterface* browser);
+
+}  // namespace safarium
+
+#endif  // CHROME_BROWSER_UI_WEBUI_BROWSER_SAFARIUM_SESSION_RESTORE_H_
