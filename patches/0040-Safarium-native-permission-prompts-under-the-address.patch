+#include "ui/gfx/mac/coordinate_conversion.h"
+
+namespace {
+
+constexpr CGFloat kWidth = 300;
+constexpr CGFloat kInset = 16;
+// Like Chrome's input protection: clicks this soon after the prompt appears
+// (or its window comes forward) are ignored, so a click meant for the page
+// cannot land on "Allow".
+constexpr base::TimeDelta kInputProtection = base::Milliseconds(500);
+
+enum class Decision { kAllow, kAllowThisTime, kDeny };
+
+// The request as an SF Symbol, as Safari's prompts show none but the list
+// reads better with one (Chrome's bubble has an icon per line too).
+NSString* RequestSymbol(permissions::RequestType type) {
+  using T = permissions::RequestType;
+  switch (type) {
+    case T::kGeolocation:
+      return @"location.fill";
+    case T::kNotifications:
+      return @"bell.fill";
+    case T::kCameraStream:
+    case T::kCameraPanTiltZoom:
+      return @"video.fill";
+    case T::kMicStream:
+      return @"mic.fill";
+    case T::kClipboard:
+      return @"doc.on.clipboard";
+    case T::kMidiSysex:
+      return @"pianokeys";
+    case T::kLocalNetwork:
+    case T::kLoopbackNetwork:
+      return @"network";
+    case T::kMultipleDownloads:
+      return @"arrow.down.circle";
+    case T::kIdleDetection:
+      return @"person.badge.clock";
+    case T::kKeyboardLock:
+      return @"keyboard";
+    case T::kPointerLock:
+      return @"cursorarrow.rays";
+    case T::kLocalFonts:
+      return @"textformat";
+    case T::kSensors:
+      return @"gyroscope";
+    case T::kVrSession:
+    case T::kArSession:
+    case T::kHandTracking:
+      return @"eyeglasses";
+    default:
+      return @"hand.raised.fill";
+  }
+}
+
+// Chrome's "allow" choice can be temporary ("Allow this time") only when
+// every request supports it.
+bool SupportsAllowThisTime(permissions::PermissionPrompt::Delegate& delegate) {
+  for (const auto& request : delegate.Requests()) {
+    std::optional<ContentSettingsType> type =
+        permissions::RequestTypeToContentSettingsType(request->request_type());
+    if (!type ||
+        !permissions::PermissionUtil::DoesSupportTemporaryGrants(*type)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Requests whose Chrome UI this popover does not reproduce.
+bool CanShowNatively(permissions::PermissionPrompt::Delegate& delegate) {
+  if (delegate.Requests().empty()) {
+    return false;
+  }
+  for (const auto& request : delegate.Requests()) {
+    switch (request->request_type()) {
+      case permissions::RequestType::kStorageAccess:  // Two sites.
+#if BUILDFLAG(ENABLE_SMART_CARD)
+      case permissions::RequestType::kSmartCard:
+#endif
+        return false;
+      default:
+        break;
+    }
+    if (request->GetContentSettingsType() ==
+        ContentSettingsType::GEOLOCATION_WITH_OPTIONS) {
+      return false;  // Approximate location is not modelled.
+    }
+  }
+  return true;
+}
+
+NSView* AddressFieldAnchor(content::WebContents* web_contents) {
+  tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(
+      web_contents);
+  BrowserWindowInterface* browser =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  WebUIBrowserWindow* window =
+      browser ? WebUIBrowserWindow::FromBrowser(browser) : nullptr;
+  if (!window || !tab->IsActivated()) {
+    return nil;
+  }
+  return window->GetSafariumAddressFieldAnchor().GetNativeNSView();
+}
+
+}  // namespace
+
+// The popover. Talks to the request through the delegate; the C++ prompt
+// (owned by Chrome's PermissionRequestManager) closes it when it goes away.
+@interface SafariumPermissionPopover : NSViewController <NSPopoverDelegate>
+- (instancetype)initWithDelegate:
+    (base::WeakPtr<permissions::PermissionPrompt::Delegate>)delegate;
+- (void)showRelativeToView:(NSView*)anchor;
+- (void)ownerGone;
+- (std::optional<gfx::Rect>)screenBounds;
+@end
+
+@implementation SafariumPermissionPopover {
+  base::WeakPtr<permissions::PermissionPrompt::Delegate> _delegate;
+  NSPopover* _popover;
+  base::TimeTicks _acceptClicksAfter;
+  BOOL _decided;
+  BOOL _ownerGone;
+  id _activationObserver;
+}
+
+- (instancetype)initWithDelegate:
+    (base::WeakPtr<permissions::PermissionPrompt::Delegate>)delegate {
+  if ((self = [super initWithNibName:nil bundle:nil])) {
+    _delegate = delegate;
+  }
+  return self;
+}
+
+- (void)dealloc {
+  if (_activationObserver) {
+    [NSNotificationCenter.defaultCenter removeObserver:_activationObserver];
+  }
+}
+
+- (NSButton*)buttonWithTitle:(const std::u16string&)title
+                    decision:(Decision)decision {
+  NSButton* button =
+      [NSButton buttonWithTitle:base::SysUTF16ToNSString(title)
+                         target:self
+                         action:@selector(buttonClicked:)];
+  button.tag = static_cast<NSInteger>(decision);
+  button.controlSize = NSControlSizeLarge;
+  [button.widthAnchor constraintEqualToConstant:kWidth - 2 * kInset].active =
+      YES;
+  return button;
+}
+
+- (void)loadView {
+  permissions::PermissionPrompt::Delegate* delegate = _delegate.get();
+  NSStackView* stack = [NSStackView stackViewWithViews:@[]];
+  stack.orientation = NSUserInterfaceLayoutOrientationVertical;
+  stack.alignment = NSLayoutAttributeLeading;
+  stack.spacing = 10;
+  stack.edgeInsets = NSEdgeInsetsMake(kInset, kInset, kInset, kInset);
+  [stack.widthAnchor constraintEqualToConstant:kWidth].active = YES;
+  self.view = stack;
+  if (!delegate) {
+    return;
+  }
+
+  // "example.com wants to"
+  const std::u16string origin = url_formatter::FormatUrlForSecurityDisplay(
+      delegate->GetRequestingOrigin(),
+      url_formatter::SchemeDisplay::OMIT_CRYPTOGRAPHIC);
+  NSTextField* title = [NSTextField
+      wrappingLabelWithString:base::SysUTF16ToNSString(
+                                  l10n_util::GetStringFUTF16(
+                                      IDS_PERMISSIONS_BUBBLE_PROMPT, origin))];
+  title.font = [NSFont boldSystemFontOfSize:13];
+  title.preferredMaxLayoutWidth = kWidth - 2 * kInset;
+  title.selectable = NO;
+  [stack addArrangedSubview:title];
+
+  // One line per request: icon + "Know your location".
+  for (const auto& request : delegate->Requests()) {
+    NSImageView* icon = [NSImageView
+        imageViewWithImage:
+            [[NSImage imageWithSystemSymbolName:RequestSymbol(
+                                                    request->request_type())
+                       accessibilityDescription:nil]
+                imageWithSymbolConfiguration:
+                    [NSImageSymbolConfiguration
+                        configurationWithPointSize:13
+                                            weight:NSFontWeightMedium]]];
+    icon.contentTintColor = NSColor.secondaryLabelColor;
+    [icon.widthAnchor constraintEqualToConstant:18].active = YES;
+    NSTextField* text = [NSTextField
+        wrappingLabelWithString:base::SysUTF16ToNSString(
+                                    request->GetMessageTextFragment())];
+    text.font = [NSFont systemFontOfSize:13];
+    text.preferredMaxLayoutWidth = kWidth - 2 * kInset - 26;
+    text.selectable = NO;
+    NSStackView* row = [NSStackView stackViewWithViews:@[ icon, text ]];
+    row.orientation = NSUserInterfaceLayoutOrientationHorizontal;
+    row.alignment = NSLayoutAttributeFirstBaseline;
+    row.spacing = 8;
+    [stack addArrangedSubview:row];
+  }
+
+  // Chrome's choices and labels: [Allow while visiting the site]
+  // [Allow this time] [Never allow], or [Allow] [Block].
+  const auto& requests = delegate->Requests();
+  permissions::PermissionRequest* first = requests.front().get();
+  const bool single = requests.size() == 1;
+  NSView* lastText = stack.arrangedSubviews.lastObject;
+  if (SupportsAllowThisTime(*delegate)) {
+    std::u16string allow =
+        single && first->GetAllowAlwaysText()
+            ? *first->GetAllowAlwaysText()
+            : l10n_util::GetStringUTF16(IDS_PERMISSION_ALLOW_WHILE_VISITING);
+    std::u16string block =
+        single && first->GetBlockText()
+            ? *first->GetBlockText()
+            : l10n_util::GetStringUTF16(IDS_PERMISSION_NEVER_ALLOW);
+    [stack addArrangedSubview:[self buttonWithTitle:allow
+                                           decision:Decision::kAllow]];
+    [stack addArrangedSubview:
+               [self buttonWithTitle:l10n_util::GetStringUTF16(
+                                         IDS_PERMISSION_ALLOW_THIS_TIME)
+                            decision:Decision::kAllowThisTime]];
+    [stack addArrangedSubview:[self buttonWithTitle:block
+                                           decision:Decision::kDeny]];
+  } else {
+    [stack addArrangedSubview:
+               [self buttonWithTitle:l10n_util::GetStringUTF16(
+                                         IDS_PERMISSION_ALLOW)
+                            decision:Decision::kAllow]];
+    [stack addArrangedSubview:
+               [self buttonWithTitle:l10n_util::GetStringUTF16(
+                                         IDS_PERMISSION_DENY)
+                            decision:Decision::kDeny]];
+  }
+  [stack setCustomSpacing:16 afterView:lastText];
+  [stack layoutSubtreeIfNeeded];
+  self.preferredContentSize = stack.fittingSize;
+}
+
+- (void)showRelativeToView:(NSView*)anchor {
+  _popover = [[NSPopover alloc] init];
+  _popover.contentViewController = self;
+  // Like Chrome's bubble, it stays until the user decides (or presses Esc):
+  // a click on the page must not count as an answer.
+  _popover.behavior = NSPopoverBehaviorApplicationDefined;
+  _popover.animates = YES;
+  _popover.delegate = self;
+  [_popover showRelativeToRect:anchor.bounds
+                        ofView:anchor
+                 preferredEdge:NSRectEdgeMaxY];
+  _acceptClicksAfter = base::TimeTicks::Now() + kInputProtection;
+  __weak SafariumPermissionPopover* weakSelf = self;
+  _activationObserver = [NSNotificationCenter.defaultCenter
+      addObserverForName:NSWindowDidBecomeKeyNotification
+                  object:anchor.window
+                   queue:nil
+              usingBlock:^(NSNotification*) {
+                SafariumPermissionPopover* strongSelf = weakSelf;
+                if (strongSelf) {
+                  strongSelf->_acceptClicksAfter =
+                      base::TimeTicks::Now() + kInputProtection;
+                }
+              }];
+}
+
+// No button starts focused: Return or Space must not answer the prompt.
+- (void)viewDidAppear {
+  [super viewDidAppear];
+  [self.view.window makeFirstResponder:self.view];
+}
+
+- (std::optional<gfx::Rect>)screenBounds {
+  NSWindow* window = self.view.window;
+  if (!window || !_popover.shown) {
+    return std::nullopt;
+  }
+  return gfx::ScreenRectFromNSRect(window.frame);
+}
+
+- (void)buttonClicked:(NSButton*)sender {
+  if (_decided || base::TimeTicks::Now() < _acceptClicksAfter) {
+    return;
+  }
+  permissions::PermissionPrompt::Delegate* delegate = _delegate.get();
+  if (!delegate) {
+    return;
+  }
+  _decided = YES;
+  // The delegate may destroy the prompt (and so close this) synchronously.
+  switch (static_cast<Decision>(sender.tag)) {
+    case Decision::kAllow:
+      delegate->Accept(/*prompt_options=*/std::monostate());
+      break;
+    case Decision::kAllowThisTime:
+      delegate->AcceptThisTime(/*prompt_options=*/std::monostate());
+      break;
+    case Decision::kDeny:
+      delegate->Deny(/*prompt_options=*/std::monostate());
+      break;
+  }
+}
+
+// Esc: Chrome's bubble treats closing it as dismissing the request.
+- (void)cancelOperation:(id)sender {
+  [_popover performClose:nil];
+}
+
+- (void)popoverDidClose:(NSNotification*)notification {
+  if (_activationObserver) {
+    [NSNotificationCenter.defaultCenter removeObserver:_activationObserver];
+    _activationObserver = nil;
+  }
+  if (!_decided && !_ownerGone) {
+    _decided = YES;
+    if (permissions::PermissionPrompt::Delegate* delegate = _delegate.get()) {
+      delegate->Dismiss(/*prompt_options=*/std::monostate());
+    }
+  }
+}
+
+- (void)ownerGone {
+  _ownerGone = YES;
+  if (_popover.shown) {
+    [_popover close];
+  }
+}
+
+@end
+
+namespace safarium {
+namespace {
+
+class NativePermissionPrompt : public PermissionPromptDesktop {
+ public:
+  NativePermissionPrompt(content::WebContents* web_contents,
+                         Delegate* delegate,
+                         NSView* anchor)
+      : PermissionPromptDesktop(web_contents, delegate) {
+    popover_ = [[SafariumPermissionPopover alloc]
+        initWithDelegate:delegate->GetWeakPtr()];
+    [popover_ showRelativeToView:anchor];
+  }
+
+  NativePermissionPrompt(const NativePermissionPrompt&) = delete;
+  NativePermissionPrompt& operator=(const NativePermissionPrompt&) = delete;
+
+  ~NativePermissionPrompt() override { [popover_ ownerGone]; }
+
+  // permissions::PermissionPrompt:
+  bool UpdateAnchor() override {
+    // Moved to another window (or the address field went away): have the
+    // request manager make a new prompt there.
+    if (UpdateBrowser() || !AddressFieldAnchor(web_contents())) {
+      [popover_ ownerGone];
+      return false;
+    }
+    return true;
+  }
+  permissions::PermissionPromptDisposition GetPromptDisposition()
+      const override {
+    return permissions::PermissionPromptDisposition::ANCHORED_BUBBLE;
+  }
+  std::optional<gfx::Rect> GetViewBoundsInScreen() const override {
+    return [popover_ screenBounds];
+  }
+
+ private:
+  SafariumPermissionPopover* __strong popover_;
+};
+
+std::unique_ptr<permissions::PermissionPrompt> CreateNativePrompt(
+    content::WebContents* web_contents,
+    permissions::PermissionPrompt::Delegate* delegate) {
+  if (!web_contents || !delegate || !CanShowNatively(*delegate)) {
+    return nullptr;
+  }
+  NSView* anchor = AddressFieldAnchor(web_contents);
+  if (!anchor) {
+    return nullptr;  // Chrome's bubble, centered over the page.
+  }
+  return std::make_unique<NativePermissionPrompt>(web_contents, delegate,
+                                                  anchor);
+}
+
+}  // namespace
+
+void RegisterNativePermissionPrompt() {
+  SetNativePermissionPromptFactory(&CreateNativePrompt);
+}
+
+}  // namespace safarium
