+gfx::NativeWindow TabBarController::MoveTabToNewWindow(int index) {
+  TabStripModel* model = browser_->GetTabStripModel();
+  if (!model->ContainsIndex(index) || model->count() < 2) {
+    return gfx::NativeWindow();
+  }
+  content::WebContents* contents = model->GetWebContentsAt(index);
+  chrome::MoveTabsToNewWindow(browser_, {index});
+  BrowserWindowInterface* moved =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(contents);
+  if (!moved || moved == browser_ || !moved->GetWindow()) {
+    return gfx::NativeWindow();
+  }
+  return moved->GetWindow()->GetNativeWindow();
+}
