+
+void TabBarController::SetHoverCardTab(int64_t tab_id) {
+  if (tab_id == hover_card_tab_) {
+    return;
+  }
+  hover_card_tab_ = tab_id;
+  hover_card_thumbnail_.reset();
+  resource_usage_observation_.Reset();
+  tabs::TabInterface* tab = tab_id ? FindTab(tab_id) : nullptr;
+  if (!tab) {
+    return;
+  }
+  // Like Chrome: no preview for the tab already on screen.
+  if (HoverCardImagesEnabled() && !tab->IsActivated()) {
+    if (ThumbnailTabHelper* helper = ThumbnailTabHelper::From(tab);
+        helper && helper->thumbnail()) {
+      PrepareForThumbnail(tab);
+      scoped_refptr<ThumbnailImage> thumbnail = helper->thumbnail();
+      hover_card_thumbnail_ = thumbnail->Subscribe();
+      hover_card_thumbnail_->SetUncompressedImageCallback(base::BindRepeating(
+          [](base::WeakPtr<TabBarController> self, int64_t id,
+             gfx::ImageSkia image) {
+            if (self && self->view_ && self->hover_card_tab_ == id) {
+              self->view_->HoverCardThumbnailChanged(id, image);
+            }
+          },
+          weak_factory_.GetWeakPtr(), tab_id));
+      thumbnail->RequestThumbnailImage();
+    }
+  }
+  if (HoverCardMemoryUsageEnabled()) {
+    PushHoverCardMemory();  // Last known value right away.
+    if (auto* collector = TabResourceUsageCollector::Get()) {
+      resource_usage_observation_.Observe(collector);
+      collector->ImmediatelyRefreshMetrics(tab->GetContents());
+    }
+  }
+}
+
+void TabBarController::OnTabResourceMetricsRefreshed() {
+  PushHoverCardMemory();
+}
+
+void TabBarController::PushHoverCardMemory() {
+  tabs::TabInterface* tab = hover_card_tab_ ? FindTab(hover_card_tab_) : nullptr;
+  TabResourceUsageTabHelper* helper =
+      tab ? TabResourceUsageTabHelper::From(tab) : nullptr;
+  if (!helper || !view_) {
+    return;
+  }
+  scoped_refptr<const TabResourceUsage> usage = helper->resource_usage();
+  if (!usage || !usage->memory_usage().is_positive()) {
+    return;
+  }
+  const bool high = usage->is_high_memory_usage();
+  view_->HoverCardMemoryChanged(
+      hover_card_tab_,
+      l10n_util::GetStringFUTF16(high ? IDS_HOVERCARD_TAB_HIGH_MEMORY_USAGE
+                                      : IDS_HOVERCARD_TAB_MEMORY_USAGE,
+                                 ui::FormatBytes(usage->memory_usage())),
+      high);
+}
