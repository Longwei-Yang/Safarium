+// Same rules as Chrome's hover card (HoverCardAnchorTarget).
+std::u16string HoverCardDomain(content::WebContents* contents) {
+  const GURL& committed = contents->GetLastCommittedURL();
+  const GURL url = committed.is_valid() ? committed : contents->GetVisibleURL();
+  if (url.SchemeIsFile()) {
+    return l10n_util::GetStringUTF16(IDS_HOVER_CARD_FILE_URL_SOURCE);
+  }
+  if (url.SchemeIsBlob()) {
+    return l10n_util::GetStringUTF16(IDS_HOVER_CARD_BLOB_URL_SOURCE);
+  }
+  if (url.SchemeIs(url::kViewSourceScheme)) {
+    return l10n_util::GetStringUTF16(IDS_HOVER_CARD_VIEW_SOURCE_URL_SOURCE);
+  }
+  if (url.IsAboutBlank()) {
+    return url::kAboutBlankURL16;
