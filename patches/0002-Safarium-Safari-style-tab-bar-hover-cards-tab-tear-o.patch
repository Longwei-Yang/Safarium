+void TabBarController::PrepareForThumbnail(tabs::TabInterface* tab) const {
+  // The native window only attaches the active tab to its WebView. Give
+  // never-attached tabs a viewport so Chromium's background thumbnail
+  // capturer can start without selecting the tab.
+  content::WebContents* active =
+      browser_->GetTabStripModel()->GetActiveWebContents();
+  const gfx::Size viewport = active ? active->GetSize() : gfx::Size();
+  content::WebContents* contents = tab->GetContents();
+  if (contents != active && !contents->WasDiscarded() &&
+      contents->GetSize().IsEmpty() && !viewport.IsEmpty()) {
+    contents->Resize(gfx::Rect(viewport));
+  }
+}
+
+tabs::TabInterface* TabBarController::FindTab(int64_t tab_id) const {
+  TabStripModel* model = browser_->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(i);
+    if (tab->GetHandle().raw_value() == tab_id) {
+      return tab;
+    }
+  }
+  return nullptr;
+}
